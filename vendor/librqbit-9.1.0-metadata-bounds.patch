+mod resource_bounds_tests {
+    use super::*;
+
+    #[test]
+    fn metadata_allocation_requires_nonzero_bounded_length() {
+        assert!(HandlerLocked::new(0).is_err());
+        assert!(HandlerLocked::new(MAX_METADATA_BYTES + 1).is_err());
+        let exact = HandlerLocked::new(MAX_METADATA_BYTES).unwrap();
+        assert_eq!(exact.buffer.len(), MAX_METADATA_BYTES as usize);
+        assert_eq!(exact.total_pieces, 64);
+        let single = HandlerLocked::new(1).unwrap();
+        assert_eq!(single.buffer.len(), 1);
+        assert_eq!(single.total_pieces, 1);
+    }
