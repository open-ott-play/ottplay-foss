{
  "productName": "OttPlay Favorites Native Qualification",
  "identifier": "play.ott.favorites-native-qualification",
  "version": "0.0.0",
  "build": {
    "frontendDist": "."
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": [
        {
          "identifier": "favorites-native-fixture",
          "windows": [
            "writer",
            "observer",
            "slot2",
            "slot3",
            "slot4",
            "reloaded"
          ],
          "permissions": ["core:event:allow-emit"]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../icons/32x32.png"]
  }
}
