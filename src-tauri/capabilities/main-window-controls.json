{
  "identifier": "main-window-controls",
  "description": "Main desktop window fullscreen, always-on-top and aspect controls",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:8443/*",
      "http://127.0.0.1:8444/*",
      "http://127.0.0.1:8445/*",
      "http://127.0.0.1:8446/*",
      "http://localhost:8443/*",
      "http://localhost:8444/*",
      "http://localhost:8445/*",
      "http://localhost:8446/*",
      "http://tauri.localhost/*",
      "https://tauri.localhost/*",
      "http://asset.localhost/*",
      "https://asset.localhost/*",
      "tauri://localhost/*",
      "asset://localhost/*"
    ]
  },
  "permissions": [
    "allow-set-always-on-top",
    "allow-set-fullscreen",
    "allow-toggle-fullscreen",
    "allow-window-aspect-lock"
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ]
}
