{
  "identifier": "default",
  "description": "Capability for all windows",
  "windows": [
    "main",
    "pip"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:8095/*",
      "http://localhost:8095/*",
      "http://tauri.localhost/*",
      "https://tauri.localhost/*",
      "http://asset.localhost/*",
      "https://asset.localhost/*",
      "tauri://localhost/*",
      "asset://localhost/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "allow-ping",
    "allow-get-epg",
    "allow-proxy-fetch",
    "allow-set-fullscreen",
    "allow-toggle-fullscreen",
    "allow-prevent-sleep",
    "allow-allow-sleep",
    "allow-play-pip",
    "allow-stop-pip",
    "allow-set-pip-bounds",
    "allow-exit-app",
    "allow-queue-poll",
    "allow-queue-enqueue",
    "allow-queue-port",
    "allow-match-channels",
    "allow-match-logos",
    "allow-tmdb-proxy",
    "allow-version",
    "allow-feedback",
    "allow-stalker-portal-fetch",
    "allow-start-media-session",
    "allow-pause-media-session",
    "allow-resume-media-session",
    "allow-stop-media-session",
    "allow-update-media-session",
    "updater:default",
    "window-state:default"
  ]
}
