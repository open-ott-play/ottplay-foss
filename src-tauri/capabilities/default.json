{
  "identifier": "default",
  "description": "Capability for all windows",
  "windows": ["main", "pip"],
  "remote": {
    "urls": [
      "http://127.0.0.1:8095/*",
      "http://localhost:8095/*",
      "http://tauri.localhost/*",
      "https://tauri.localhost/*",
      "http://asset.localhost/*",
      "https://asset.localhost/*",
      "tauri://localhost/*",
      "asset://localhost/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "allow-ping",
    "allow-get-epg",
    "allow-proxy-fetch",
    "allow-set-fullscreen",
    "allow-prevent-sleep",
    "allow-allow-sleep",
    "allow-get-volume",
    "allow-set-volume",
    "allow-play-pip",
    "allow-stop-pip",
    "allow-set-pip-bounds",
    "allow-exit-app",
    "allow-queue-poll",
    "allow-queue-enqueue"
  ]
}
