# Tauri normalizes these release inputs while packaging on Windows. Keep their
# checkout bytes stable so the post-build receipt still matches version sync.
/Cargo.lock text eol=lf
/src-tauri/Cargo.toml text eol=lf

# MPEG-TS test fixtures are media, not TypeScript source.
/tests/fixtures/media-runtime/*.ts binary

# Receipt-pinned compiler output must have identical bytes on every host.
/vendor/ottplay-core.* -text
/licenses/native/* -text
