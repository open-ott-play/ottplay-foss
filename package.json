{
  "name": "ottplay-foss",
  "version": "1.1.7",
  "description": "OTT-play FOSS - IPTV/OTT set-top-box player",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:mobile": "vite build && npx cap copy && npx cap sync",
    "cap:android": "npx cap open android",
    "cap:copy": "vite build && npx cap copy",
    "cap:ios": "npx cap open ios",
    "cap:sync": "npx cap sync",
    "check": "ultracite check",
    "check:bundle": "bash scripts/check-bundle-identifiers.sh",
    "dev": "vite",
    "fix": "ultracite fix",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "npx tsx tests/test_channel_filtering.ts && npx tsx tests/test-epg-matching.ts && npx tsx tests/test_listKeyHandler_alias.ts",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@tauri-apps/plugin-updater": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@tauri-apps/cli": "^2.11.4",
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.4.1",
    "rollup": "^4.63.1",
    "terser": "^5.51.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "ultracite": "^7.10.8",
    "vite": "^8.2.2"
  }
}
