{
  "name": "ottplay-foss",
  "version": "1.0.0",
  "description": "OTT-play FOSS - IPTV/OTT set-top-box player",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "ultracite check",
    "check:bundle": "bash scripts/check-bundle-identifiers.sh",
    "fix": "ultracite fix",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "npx tsx tests/test_channel_filtering.ts && npx tsx tests/test-epg-matching.ts && npx tsx tests/test_listKeyHandler_alias.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.4.0",
    "rollup": "^4.63.1",
    "terser": "^5.51.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "ultracite": "^7.10.7",
    "vite": "^8.2.2"
  }
}
