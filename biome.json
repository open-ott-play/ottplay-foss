{
    "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "src/**",
            "build-concat.cjs",
            "biome.json",
            "package.json",
            "tsconfig.json"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "enabled": true,
        "rules": {
            "correctness": {
                "noInnerDeclarations": "off",
                "noUnusedVariables": "off",
                "noUnusedFunctionParameters": "off",
                "useParseIntRadix": "off",
                "noUnusedImports": "off",
                "noSelfAssign": "off"
            },
            "complexity": {
                "useArrowFunction": "off",
                "noUselessSwitchCase": "off",
                "useOptionalChain": "off",
                "noArguments": "off"
            },
            "style": {
                "useTemplate": "off",
                "useNodejsImportProtocol": "off",
                "useConst": "off",
                "noNonNullAssertion": "off"
            },
            "suspicious": {
                "noExplicitAny": "off",
                "useDefaultSwitchClauseLast": "off",
                "noDoubleEquals": "off",
                "noGlobalIsNan": "off",
                "noPrototypeBuiltins": "off",
                "noDocumentCookie": "off",
                "noAssignInExpressions": "off",
                "noFallthroughSwitchClause": "off",
                "noRedeclare": "off"
            }
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
