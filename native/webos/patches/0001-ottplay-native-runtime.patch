new file mode 100644
index 0000000..32bf9ae
--- /dev/null
+++ b/rust-modules/src/app/ott_import.rs
@@ -0,0 +1,196 @@
+//! Native-only external profile boundary. Never reads credentials from launch arguments.
+use super::ott_profile::Profile;
+use plx_plex::plex::{Origin, session::{Session, ServerRef, SourceRef, UserRef}};
+use std::{io::Read, path::PathBuf, time::Duration};
+
+struct ImportedOrigin { origin: Origin, machine_id: String, scope: plx_plex::plex::grant::GrantScope }
+static IMPORTED_HTTP: std::sync::OnceLock<ImportedOrigin> = std::sync::OnceLock::new();
+
+fn profile_path() -> PathBuf {
+    std::env::var_os("OTTPLAY_PLEX_PROFILE").map(PathBuf::from)
+        .unwrap_or_else(|| plx_base::paths::in_app_dir("ottplay-profile.json"))
+}
+
+fn identity(origin: &Origin, expected: &str) -> Result<String, &'static str> {
+    let reply = plx_session::auth::get_identity(origin, None, Duration::from_secs(3));
+    match reply {
+        plx_session::auth::ProbeReply::Answered { status: 200, body, .. } => {
+            let observed = plx_session::auth::machine_id_in(&body).ok_or("server returned no identity")?;
+            if !expected.is_empty() && observed != expected { return Err("server identity does not match the profile"); }
+            Ok(observed)
+        }
+        _ => Err("server identity could not be verified"),
+    }
+}
+
+/// Called only after network initialization. Invalid imports leave the normal QR/session intact.
+pub(super) fn load(saved: &Session) -> Option<Session> {
+    match read_and_verify(&profile_path(), saved) {
+        Ok(Some(session)) => {
+            if !session.server.origin().is_tls() {
+                let _ = IMPORTED_HTTP.set(ImportedOrigin { origin: session.server.origin(),
+                    machine_id: session.server.machine_id.clone(), scope: plx_plex::plex::grant::scope() });
+            }
+            plx_base::eventlog::log("OTTPlay: managed Plex profile active; restored each boot until ottplay-profile.json is removed"); Some(session)
+        }
+        Ok(None) => None,
+        Err(reason) => { plx_base::eventlog::log(&format!("OTTPlay profile not loaded: {reason}")); None }
+    }
+}
+
+fn read_and_verify(path: &std::path::Path, saved: &Session) -> Result<Option<Session>, &'static str> {
+    let metadata = match std::fs::symlink_metadata(&path) {
+        Ok(value) => value,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(_) => return Err("cannot read profile file"),
+    };
+    if !metadata.is_file() || metadata.len() > 1024 * 1024 { return Err("profile must be a regular file no larger than 1 MiB"); }
+    let mut bytes = Vec::new();
+    std::fs::File::open(path).map_err(|_| "cannot open profile file")?.take(1024 * 1024 + 1)
+        .read_to_end(&mut bytes).map_err(|_| "cannot read profile file")?;
+    let profile = Profile::parse(&bytes)?;
+    let origin = Origin::parse(&profile.address).ok_or("invalid server origin")?;
+    let scope = plx_plex::plex::grant::scope();
+    let machine_id = identity(&origin, &profile.server_id)?;
+    if !origin.is_tls() {
+        if !profile.allow_insecure_http || !plx_plex::plex::grant::allow_imported_local(
+            scope, &origin, &profile.server_id, &machine_id,
+        ) { return Err("local HTTP consent could not be applied"); }
+    }
+    let token_header = format!("X-Plex-Token: {}", profile.token);
+    let permitted = matches!(plx_plex::http::request_until_outcome(&origin, "/library/sections",
+        plx_plex::http::Method::Get, &[plx_plex::http::ACCEPT_JSON, &token_header],
+        std::time::Instant::now() + Duration::from_secs(4), None),
+        plx_plex::http::RequestOutcome::Response(reply) if reply.ok());
+    if !permitted {
+        if !origin.is_tls() { plx_plex::plex::grant::revoke(&machine_id); }
+        return Err("Plex server did not authorize library access");
+    }
+    let tier = Some(plx_plex::plex::probe::configured_tier(origin.host()));
+    let source = SourceRef { machine_id: machine_id.clone(), name: profile.name.clone(),
+        address: origin.host().to_owned(), port: i64::from(origin.port()), token: profile.token.clone(),
+        origin_url: origin.base(), tier, ..Default::default() };
+    let imported = Session {
+        client_id: saved.client_id.clone(), language: saved.language,
+        server: ServerRef { machine_id, name: profile.name.clone(), address: origin.host().to_owned(),
+            port: i64::from(origin.port()), token: profile.token.clone(), origin_url: origin.base(), tier,
+            ..Default::default() },
+        user: UserRef { title: profile.name, token: profile.token, ..Default::default() },
+        sources: vec![source],
+        // account_token deliberately remains empty. The imported token is PMS-scoped.
+        ..Default::default()
+    };
+    // Change only the credential-owned fields; retain the install's interface/playback preferences.
+    Ok(Some(plx_session::auth::owner::CredentialPatch::of(&imported).merge_into(saved)))
+}
+
+/// Foregrounding invalidates normal LAN grants. Re-prove the imported machine first, without
+/// a credential, before allowing this explicit local server to reconnect.
+pub(super) fn refresh_http_grant() {
+    let Some(imported) = IMPORTED_HTTP.get() else { return };
+    let scope = plx_plex::plex::grant::scope();
+    if !scope.same_identity(imported.scope) { return; }
+    // The SDL event loop never waits for network IO. A moved network/identity makes this
+    // result stale, so the grant operation rejects it after verification.
+    let _ = plx_base::task::spawn_small("ott-plex-import", move || {
+        let Ok(observed) = identity(&imported.origin, &imported.machine_id) else {
+            plx_base::eventlog::log("OTTPlay: imported Plex server identity unavailable after network change");
+            return;
+        };
+        let _ = plx_plex::plex::grant::allow_imported_local(scope,
+            &imported.origin, &imported.machine_id, &observed);
+    });
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::io::{Read, Write};
+    use std::net::TcpListener;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    use std::time::Instant;
+
+    static NEXT: AtomicUsize = AtomicUsize::new(0);
+
+    fn exercise(machine: &'static str, library_status: u16) -> Result<Option<Session>, &'static str> {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let port = listener.local_addr().unwrap().port();
+        listener.set_nonblocking(true).unwrap();
+        let server = std::thread::spawn(move || {
+            let requests = if machine == "expected" { 2 } else { 1 };
+            for index in 0..requests {
+                let deadline = Instant::now() + Duration::from_secs(6);
+                let mut stream = loop {
+                    match listener.accept() {
+                        Ok((stream, _)) => break stream,
+                        Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => {
+                            assert!(Instant::now() < deadline, "request did not arrive");
+                            std::thread::sleep(Duration::from_millis(5));
+                        }
+                        Err(error) => panic!("loopback accept: {error}"),
+                    }
+                };
+                stream.set_read_timeout(Some(Duration::from_secs(3))).unwrap();
+                let mut bytes = Vec::new();
+                let mut part = [0u8; 1024];
+                while !bytes.windows(4).any(|s| s == b"\r\n\r\n") {
+                    let n = stream.read(&mut part).unwrap();
+                    assert!(n > 0 && bytes.len() < 16384);
+                    bytes.extend_from_slice(&part[..n]);
+                }
+                let request = String::from_utf8(bytes).unwrap().to_ascii_lowercase();
+                let (status, body) = if index == 0 {
+                    assert!(request.starts_with("get /identity "));
+                    assert!(!request.contains("x-plex-token"), "identity probe carried a credential");
+                    (200, format!("{{\"MediaContainer\":{{\"machineIdentifier\":\"{machine}\"}}}}"))
+                } else {
+                    assert!(request.starts_with("get /library/sections "));
+                    assert!(request.contains("x-plex-token: server-only"));
+                    (library_status, "{\"MediaContainer\":{\"Directory\":[]}}".to_owned())
+                };
+                write!(stream, "HTTP/1.1 {status} Test\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}", body.len()).unwrap();
+            }
+        });
+        let directory = std::env::temp_dir().join(format!("ott-native-import-test-{}-{}", std::process::id(), NEXT.fetch_add(1, Ordering::Relaxed)));
+        std::fs::create_dir(&directory).unwrap();
+        let path = directory.join("profile.json");
+        std::fs::write(&path, serde_json::to_vec(&serde_json::json!({
+            "baseUrl": format!("http://127.0.0.1:{port}"), "token": "server-only",
+            "serverId": "expected", "allowInsecureHttp": true
+        })).unwrap()).unwrap();
+        let saved: Session = serde_json::from_value(serde_json::json!({
+            "client_id": "local-client", "account_token": "account-only", "future_setting": "preserved"
+        })).unwrap();
+        let result = read_and_verify(&path, &saved);
+        server.join().unwrap();
+        std::fs::remove_dir_all(directory).unwrap();
+        result
+    }
+
+    #[test]
+    fn verified_import_preserves_settings_and_scopes_the_server_token() {
+        let _guard = plx_base::testlock::serial();
+        plx_plex::plex::grant::reset_for_test();
+        let imported = exercise("expected", 200).unwrap().unwrap();
+        assert_eq!(imported.client_id, "local-client");
+        assert!(imported.account_token.is_empty());
+        assert_eq!(imported.server.token, "server-only");
+        assert_eq!(serde_json::to_value(&imported).unwrap()["future_setting"], "preserved");
+        plx_plex::plex::grant::reset_for_test();
+    }
+
+    #[test]
+    fn identity_mismatch_and_unauthorized_library_do_not_import() {
+        let _guard = plx_base::testlock::serial();
+        plx_plex::plex::grant::reset_for_test();
+        assert_eq!(exercise("different", 200).err(), Some("server identity does not match the profile"));
+        assert_eq!(exercise("expected", 401).err(), Some("Plex server did not authorize library access"));
+        plx_plex::plex::grant::reset_for_test();
+    }
+
+    #[test]
+    fn absent_profile_keeps_the_normal_session_and_qr_flow() {
+        let directory = std::env::temp_dir().join(format!("ott-native-absent-profile-{}-{}", std::process::id(), NEXT.fetch_add(1, Ordering::Relaxed)));
+        assert!(read_and_verify(&directory.join("missing.json"), &Session::default()).unwrap().is_none());
+    }
+}
