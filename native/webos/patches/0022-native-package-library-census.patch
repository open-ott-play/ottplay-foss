+def check_library_payload(archive, notices: bytes, build: str, app_id: str) -> None:
+    """Grade the distributed libraries, never the mixed host/target outputs in pkg/."""
+    entries = archive.getmembers()
+    # Match the outer IPK verifier's regular-file/directory contract. Reject
+    # aliases before grading contents: extraction must not replace a checked
+    # member through an interior dot, repeated separator, traversal or link.
+    paths, invalid = set(), []
+    for member in entries:
+        path = member.name.removeprefix("./")
+        root_directory = member.isdir() and member.name in (".", "./")
+        if root_directory:
+            path = "."
+        canonical = root_directory or (path and "\\" not in path
+                                        and all(part not in ("", ".", "..") for part in path.split("/")))
+        if not canonical or path in paths or not (member.isfile() or member.isdir()):
+            invalid.append(member.name)
+        paths.add(path)
+    check(not invalid, "IPK payload paths are canonical, unique regular files or directories"
+          + (f" (invalid {invalid!r})" if invalid else ""))
+    members = [member for member in entries if member.isfile()]
+    names = {Path(member.name).name for member in entries}
+    notice_path = f"usr/palm/applications/{app_id}/THIRD-PARTY-NOTICES.md"
+    notice_members = [member for member in entries if member.name.removeprefix("./") == notice_path]
+    notice_matches = False
+    if (len(notice_members) == 1 and notice_members[0].isfile()
+            and notice_members[0].size == len(notices)):
+        with archive.extractfile(notice_members[0]) as content:
+            notice_matches = content.read() == notices
+    check(notice_matches, "the IPK carries one byte-identical THIRD-PARTY-NOTICES.md at the application root")
+    shipped = set()
+    for member in members:
+        name = Path(member.name).name
+        if ".so." in name:
+            with archive.extractfile(member) as content:
+                if content.read(4) == b"\x7fELF":
+                    shipped.add(name)
+    # Dev capture alone ships swscale; release notices describe the common payload.
+    # Keep exact equality: unknown additions and missing documented libraries fail,
+    # including an empty archive. Host libraries are NOT subtracted from this set.
+    dev_only = {"libswscale-plx.so.10"}
+    named = set(re.findall(r"`(lib[a-z]+-plx\.so\.\d+)`", notices.decode("utf-8")))
+    distributed = shipped - dev_only
+    check(distributed == named,
+          "THIRD-PARTY-NOTICES names exactly the distributed libraries"
+          + (f" (shipped-not-named={sorted(distributed-named)} named-not-shipped={sorted(named-distributed)})"
+             if distributed != named else ""))
+    if build == "release":
+        extra = sorted(shipped & dev_only)
+        check(not extra, "a RELEASE build ships none of the dev-only libraries"
+                         + (f" (found {', '.join(extra)})" if extra else ""))
+    # Both simulator formats may coexist with ARM outputs in pkg/, but neither
+    # belongs in an IPK. Do not hide a real host leak by filtering the census.
+    host_libraries = sorted(name for name in names
+                            if name.endswith(".dylib") or name == "libass-plx-host.so.0")
+    check(not host_libraries, "payload carries no host libraries"
+          + (f" (found {', '.join(host_libraries)})" if host_libraries else ""))
+
+
