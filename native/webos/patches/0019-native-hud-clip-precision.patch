+#[test]
+fn clip_rounding_uses_the_existing_bound_and_rejects_geometry_drift() {
+    let rail = plx_ui::Rect::new(96.0, 773.52, 1728.0, 68.48);
+    // Exercise the same public clipping operation as DrawFrame, not rounded expected literals.
+    let clipped = plx_ui::Rect::FULL.intersect(rail);
+    assert_ne!(clipped.h, rail.h, "fixture must exercise f32 endpoint reconstruction");
+    assert!(near(ext(clipped), ext(rail)));
+    let (x, y, w, h) = ext(rail);
+    // Even a hundredth of a pixel on any axis remains outside the unchanged tolerance.
+    for wrong in [(x + 0.01, y, w, h), (x, y + 0.01, w, h),
+        (x, y, w + 0.01, h), (x, y, w, h + 0.01)] {
+        assert!(!near(ext(clipped), wrong), "clip drift must still fail: {wrong:?}");
+    }
+}
