+        }
+        for name, relative in providers.items():
+            scripts = [target for target in packages[name]["targets"]
+                       if target.get("kind") == ["custom-build"]]
+            self.assertEqual(len(scripts), 1, name)
+            self.assertEqual(Path(scripts[0]["src_path"]).resolve(), (ROOT / relative).resolve())
+        for name in ("plx_ui", "plx_appkit", "plx_screens"):
+            self.assertFalse(any(target.get("kind") == ["custom-build"]
+                                 for target in packages[name]["targets"]), name)
+        required = {
+            "plx_gfx": ("plx_base",),
+            "plx_platform": ("plx_base",),
+            "plxnative-modules": ("plx_base", "plx_gfx", "plx_platform"),
+            "plx_ui": ("plx_base", "plx_gfx", "plx_platform"),
+            "plx_appkit": ("plx_base", "plx_gfx", "plx_platform"),
+            "plx_screens": ("plx_base", "plx_gfx", "plx_platform"),
