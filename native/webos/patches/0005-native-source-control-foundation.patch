+//! Pure Local command admission and transient selection. The media umbrella owns
+//! the one Local/Plex session enum and supplies every token below. This module
+//! does not scan, resolve playback, persist settings, advance EOF or cache RPCs.
+use serde_json::{json, Value};
+use std::collections::HashSet;
+
+/// Assigned by the common media owner, never generated by this module.
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(super) struct OwnerToken(pub u64);
+
+/// Private receiver-owned authority handle. It is never a wire source ID/path.
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(super) struct AuthorityRef(pub u64);
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum LocalError {
+    InvalidRequest,
+    RuntimeChanged,
+    Restricted,
+    Unsupported,
+    SourceNotFound,
+    SourceAmbiguous,
+    SourceUnavailable,
+    CatalogLoading,
+    CatalogUnavailable,
+    EmptySource,
+    TooManyItems,
+    OperationInProgress,
+    NativeError,
+}
+impl LocalError {
+    pub fn code(self) -> &'static str {
+        match self {
+            Self::InvalidRequest => "invalid_request",
+            Self::RuntimeChanged => "runtime_changed",
+            Self::Restricted => "restricted",
+            Self::Unsupported => "unsupported",
+            Self::SourceNotFound => "source_not_found",
+            Self::SourceAmbiguous => "source_ambiguous",
+            Self::SourceUnavailable => "source_unavailable",
+            Self::CatalogLoading => "catalog_loading",
+            Self::CatalogUnavailable => "catalog_unavailable",
+            Self::EmptySource => "empty_source",
+            Self::TooManyItems => "too_many_items",
+            Self::OperationInProgress => "operation_in_progress",
+            Self::NativeError => "native_error",
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum LocalOp {
+    Sources,
+    Connect,
+    Play,
+    Shuffle,
+}
+impl LocalOp {
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Sources => "sources",
+            Self::Connect => "connect",
+            Self::Play => "play",
+            Self::Shuffle => "shuffle",
+        }
+    }
+    fn playback(self) -> bool {
+        matches!(self, Self::Play | Self::Shuffle)
+    }
+}
+
+#[derive(Clone, PartialEq, Eq)]
+pub(super) enum Selector {
+    Name(String),
+    Absolute(String),
+}
+
+#[derive(Clone)]
+pub(super) struct LocalRequest {
+    pub op: LocalOp,
+    pub runtime: String,
+    pub selector: Option<Selector>,
+    pub include_paths: bool,
+    pub session: bool,
+    pub progressive: bool,
+}
+
+fn text(value: &str, bytes: usize, nonempty: bool) -> bool {
+    value.len() <= bytes
+        && (!nonempty || !value.trim().is_empty())
+        && !value
+            .chars()
+            .any(|c| c <= '\u{1f}' || ('\u{7f}'..='\u{9f}').contains(&c))
+}
+fn absolute(value: &str) -> bool {
+    let bytes = value.as_bytes();
+    value.starts_with('/')
+        || (bytes.len() >= 3
+            && bytes[0].is_ascii_alphabetic()
+            && bytes[1] == b':'
+            && matches!(bytes[2], b'/' | b'\\'))
+}
+fn selector(value: &Value) -> Result<Selector, LocalError> {
+    let value = value.as_str().ok_or(LocalError::InvalidRequest)?;
+    if absolute(value) && text(value, 4096, true) {
+        Ok(Selector::Absolute(value.into()))
+    } else if text(value, 512, true)
+        && !value.contains(['/', '\\'])
+        && value != "."
+        && value != ".."
+    {
+        Ok(Selector::Name(value.into()))
+    } else {
+        Err(LocalError::InvalidRequest)
+    }
+}
+fn true_or_absent(value: Option<&Value>) -> Result<bool, LocalError> {
+    match value {
+        None => Ok(false),
+        Some(Value::Bool(true)) => Ok(true),
+        _ => Err(LocalError::InvalidRequest),
+    }
+}
+impl LocalRequest {
+    pub fn parse(params: &Value) -> Result<Self, LocalError> {
+        let p = params.as_object().ok_or(LocalError::InvalidRequest)?;
+        let op = match p.get("op").and_then(Value::as_str) {
+            Some("sources") => LocalOp::Sources,
+            Some("connect") => LocalOp::Connect,
+            Some("play") => LocalOp::Play,
+            Some("shuffle") => LocalOp::Shuffle,
+            _ => return Err(LocalError::InvalidRequest),
+        };
+        let runtime = p
+            .get("runtime")
+            .and_then(Value::as_str)
+            .ok_or(LocalError::InvalidRequest)?;
+        if runtime.is_empty()
+            || runtime.len() > 64
+            || !runtime
+                .bytes()
+                .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-')
+        {
+            return Err(LocalError::InvalidRequest);
+        }
+        let allowed: &[&str] = match op {
+            LocalOp::Sources => &["op", "runtime", "include_paths", "path"],
+            LocalOp::Connect => &["op", "runtime", "source"],
+            _ => &["op", "runtime", "source", "session", "progressive"],
+        };
+        if p.keys().any(|key| !allowed.contains(&key.as_str())) {
+            return Err(LocalError::InvalidRequest);
+        }
+        let include_paths = match p.get("include_paths") {
+            None => false,
+            Some(Value::Bool(value)) => *value,
+            _ => return Err(LocalError::InvalidRequest),
+        };
+        let selected = if op == LocalOp::Sources {
+            match p.get("path") {
+                None => None,
+                Some(value) => match selector(value)? {
+                    path @ Selector::Absolute(_) => Some(path),
+                    _ => return Err(LocalError::InvalidRequest),
+                },
+            }
+        } else {
+            Some(selector(
+                p.get("source").ok_or(LocalError::InvalidRequest)?,
+            )?)
+        };
+        Ok(Self {
+            op,
+            runtime: runtime.into(),
+            selector: selected,
+            include_paths,
+            session: true_or_absent(p.get("session"))?,
+            progressive: true_or_absent(p.get("progressive"))?,
+        })
+    }
+    pub fn error_data(&self, error: LocalError) -> Value {
+        json!({"version":1,"runtime":self.runtime,"op":self.op.name(),"state":"error","error":error.code()})
+    }
+}
+
+pub(super) fn capability(absolute_paths: bool) -> Value {
+    json!({"version":1,"operations":["sources","play","shuffle","connect"],
+        "absolute_paths":absolute_paths,"max_sources":32,"max_items":50000})
+}
+pub(super) fn extension_capability() -> Value {
+    json!({"version":1})
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(super) enum SourceKind {
+    Folder,
+}
+#[derive(Clone)]
+pub(super) struct BoundSource {
+    pub id: String,
+    pub name: String,
+    pub kind: SourceKind,
+    pub available: bool,
+    pub authority_ref: AuthorityRef,
+    pub generation: u64,
+    pub canonical_path: Option<String>,
+}
+impl BoundSource {
+    fn validate(&self) -> Result<(), LocalError> {
+        if self.id.is_empty()
+            || self.id.len() > 256
+            || !self
+                .id
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b"_.:-".contains(&b))
+            || !text(&self.name, 512, true)
+            || self.name.contains(['/', '\\'])
+            || self.name == "."
+            || self.name == ".."
+            || self
+                .canonical_path
+                .as_ref()
+                .is_some_and(|p| !absolute(p) || !text(p, 4096, true))
+        {
+            return Err(LocalError::NativeError);
+        }
+        Ok(())
+    }
+    fn playable(&self) -> Result<(), LocalError> {
+        self.validate()?;
+        if self.kind != SourceKind::Folder {
+            return Err(LocalError::Unsupported);
+        }
+        if !self.available {
+            return Err(LocalError::SourceUnavailable);
+        }
+        if self.generation == 0 {
+            return Err(LocalError::NativeError);
+        }
+        Ok(())
+    }
+    fn wire(&self, paths: bool) -> Value {
+        let mut value = json!({"id":self.id,"name":self.name,
+            "kind":if self.kind == SourceKind::Folder { "folder" } else { "file" },"available":self.available});
+        if paths {
+            if let Some(path) = &self.canonical_path {
+                value["path"] = json!(path);
+            }
+        }
+        value
+    }
+}
+
+/// A worker supplies a full registry, or the result of one canonical lookup.
+/// lookup_path is the original query, not the canonical spelling of its result.
+pub(super) struct SourceSnapshot<'a> {
+    pub lookup_path: Option<&'a str>,
+    pub sources: &'a [BoundSource],
+}
+pub(super) enum SourceSelection {
+    List(Vec<BoundSource>),
+    LookupPath,
+    ConnectPath,
+    Selected(BoundSource),
+}
+pub(super) fn select_source(
+    request: &LocalRequest,
+    snapshot: &SourceSnapshot<'_>,
+) -> Result<SourceSelection, LocalError> {
+    if snapshot.sources.len() > 32 {
+        return Err(LocalError::NativeError);
+    }
+    let mut ids = HashSet::new();
+    for source in snapshot.sources {
+        source.validate()?;
+        if !ids.insert(source.id.as_str()) {
+            return Err(LocalError::NativeError);
+        }
+    }
+    let source = match request.selector.as_ref() {
+        Some(Selector::Absolute(path)) => {
+            if snapshot.lookup_path != Some(path.as_str()) {
+                return Ok(SourceSelection::LookupPath);
+            }
+            if snapshot.sources.len() > 1 {
+                return Err(LocalError::SourceAmbiguous);
+            }
+            if request.op == LocalOp::Sources {
+                return Ok(SourceSelection::List(snapshot.sources.to_vec()));
+            }
+            match snapshot.sources.first() {
+                Some(source) => source,
+                None => return Ok(SourceSelection::ConnectPath),
+            }
+        }
+        Some(Selector::Name(name)) => {
+            if snapshot.lookup_path.is_some() {
+                return Err(LocalError::NativeError);
+            }
+            if let Some(source) = snapshot.sources.iter().find(|s| s.id == *name) {
+                source
+            } else {
+                let mut matches = snapshot.sources.iter().filter(|s| s.name == *name);
+                let source = matches.next().ok_or(LocalError::SourceNotFound)?;
+                if matches.next().is_some() {
+                    return Err(LocalError::SourceAmbiguous);
+                }
+                source
+            }
+        }
+        None if request.op == LocalOp::Sources && snapshot.lookup_path.is_none() => {
+            return Ok(SourceSelection::List(snapshot.sources.to_vec()));
+        }
+        None => return Err(LocalError::InvalidRequest),
+    };
+    source.playable()?;
+    Ok(SourceSelection::Selected(source.clone()))
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum ScanState {
+    Pending,
+    Scanning,
+    Complete,
+    Failed,
+}
+pub(super) struct LocalItem {
+    pub id: String,
+    pub playable: bool,
+}
+/// Items are the complete discovered prefix, already scoped by the worker.
+pub(super) struct CatalogSnapshot<'a> {
+    pub source_id: &'a str,
+    pub authority_ref: AuthorityRef,
+    pub source_generation: u64,
+    pub state: ScanState,
+    pub items: &'a [LocalItem],
+}
+fn playable_ids<'a>(
+    source: &BoundSource,
+    scan: &CatalogSnapshot<'a>,
+) -> Result<Vec<&'a str>, LocalError> {
+    source.playable()?;
+    if scan.source_id != source.id
+        || scan.authority_ref != source.authority_ref
+        || scan.source_generation != source.generation
+    {
+        return Err(LocalError::RuntimeChanged);
+    }
+    if scan.items.len() > 50000 {
+        return Err(LocalError::TooManyItems);
+    }
+    let mut ids = HashSet::new();
+    let mut result = Vec::new();
+    for item in scan.items {
+        if !text(&item.id, 256, true) || !ids.insert(item.id.as_str()) {
+            return Err(LocalError::CatalogUnavailable);
+        }
+        if item.playable {
+            result.push(item.id.as_str());
+        }
+    }
+    Ok(result)
+}
+
+pub(super) struct AdmissionContext<'a> {
+    pub runtime: &'a str,
+    pub owner: OwnerToken,
+    pub invocation_current: bool,
+    pub now_ms: u64,
+    pub mutations_allowed: bool,
+}
+/// Propose is not a success receipt. The umbrella submits it through the normal
+/// PlayRequestTicket admission, then calls finish_admission. Complete after that
+/// means admission, never confirmed playback. Delivery owns receipt retries.
+pub(super) enum Admission {
+    Wait,
+    Propose(LocalContext),
+    AwaitingAdmission,
+    Complete { data: Value },
+    Retired,
+}
+struct AdmissionPlan {
+    source: BoundSource,
+    count: usize,
+    scanning: bool,
+}
+pub(super) struct PendingLocal {
+    request: LocalRequest,
+    owner: OwnerToken,
+    deadline_ms: u64,
+    completion: Option<Result<(), LocalError>>,
+    bound: Option<(String, AuthorityRef, u64)>,
+    awaiting: Option<AdmissionPlan>,
+}
+impl PendingLocal {
+    pub fn new(request: LocalRequest, owner: OwnerToken, deadline_ms: u64) -> Self {
+        Self {
+            request,
+            owner,
+            deadline_ms,
+            completion: None,
+            bound: None,
+            awaiting: None,
+        }
+    }
+    /// Typed terminal status for an internal caller sharing this planner. The
+    /// remote data/flags remain unchanged and no completion may be emitted twice.
+    pub fn completion(&self) -> Option<Result<(), LocalError>> { self.completion }
+    fn check(&self, context: &AdmissionContext<'_>) -> Result<(), LocalError> {
+        if self.request.runtime != context.runtime
+            || self.owner != context.owner
+            || !context.invocation_current
+        {
+            return Err(LocalError::RuntimeChanged);
+        }
+        if context.now_ms >= self.deadline_ms {
+            return Err(LocalError::CatalogLoading);
+        }
+        if self.request.op != LocalOp::Sources && !context.mutations_allowed {
+            return Err(LocalError::Restricted);
+        }
+        Ok(())
+    }
+    fn finish(&mut self, result: Result<Value, LocalError>) -> Admission {
+        if self.completion.is_some() {
+            return Admission::Retired;
+        }
+        self.completion = Some(result.as_ref().map(|_| ()).map_err(|error| *error));
+        self.awaiting = None;
+        match result {
+            Ok(data) => Admission::Complete { data },
+            Err(error) => Admission::Complete {
+                data: self.request.error_data(error),
+            },
+        }
+    }
+    pub fn fail(&mut self, context: &AdmissionContext<'_>, error: LocalError) -> Admission {
+        let error = self.check(context).err().unwrap_or(error);
+        self.finish(Err(error))
+    }
+    /// Called with the runner's sampled context while a native result is pending.
+    pub fn check_pending(&mut self, context: &AdmissionContext<'_>) -> Admission {
+        if self.completion.is_some() {
+            return Admission::Retired;
+        }
+        if let Err(error) = self.check(context) {
+            return self.finish(Err(error));
+        }
+        if self.awaiting.is_some() {
+            Admission::AwaitingAdmission
+        } else {
+            Admission::Wait
+        }
+    }
+    pub fn complete_sources(
+        &mut self,
+        context: &AdmissionContext<'_>,
+        snapshot: &SourceSnapshot<'_>,
+    ) -> Admission {
+        if self.completion.is_some() {
+            return Admission::Retired;
+        }
+        let result = (|| {
+            self.check(context)?;
+            if self.request.op != LocalOp::Sources {
+                return Err(LocalError::InvalidRequest);
+            }
+            let SourceSelection::List(sources) = select_source(&self.request, snapshot)? else {
+                return Err(LocalError::NativeError);
+            };
+            let data = json!({"version":1,"runtime":self.request.runtime,"op":"sources","state":"ready",
+                "sources":sources.iter().map(|s|s.wire(self.request.include_paths)).collect::<Vec<_>>()});
+            bounded(data)
+        })();
+        self.finish(result)
+    }
+    pub fn complete_connect(
+        &mut self,
+        context: &AdmissionContext<'_>,
+        source: &BoundSource,
+    ) -> Admission {
+        if self.completion.is_some() {
+            return Admission::Retired;
+        }
+        let result = (|| {
+            self.check(context)?;
+            if self.request.op != LocalOp::Connect {
+                return Err(LocalError::InvalidRequest);
+            }
+            source.playable()?;
+            self.selected_matches(source)?;
+            playback_data(&self.request, source, 0, false)
+        })();
+        self.finish(result)
+    }
+    fn selected_matches(&self, source: &BoundSource) -> Result<(), LocalError> {
+        match self.request.selector.as_ref() {
+            Some(Selector::Name(name)) if *name == source.id || *name == source.name => Ok(()),
+            // The runner must only pass the SourceSelection selected by its
+            // canonical lookup/Connect response for this exact pending owner.
+            Some(Selector::Absolute(_)) => Ok(()),
+            _ => Err(LocalError::SourceNotFound),
+        }
+    }
+    fn pin_source(&mut self, source: &BoundSource) -> Result<(), LocalError> {
+        match &self.bound {
+            Some((id, authority, generation))
+                if *id != source.id
+                    || *authority != source.authority_ref
+                    || *generation != source.generation =>
+            {
+                Err(LocalError::RuntimeChanged)
+            }
+            Some(_) => Ok(()),
+            None => {
+                self.bound = Some((source.id.clone(), source.authority_ref, source.generation));
+                Ok(())
+            }
+        }
+    }
+    pub fn evaluate(
+        &mut self,
+        context: &AdmissionContext<'_>,
+        source: &BoundSource,
+        scan: &CatalogSnapshot<'_>,
+        seed: u32,
+    ) -> Admission {
+        if self.completion.is_some() {
+            return Admission::Retired;
+        }
+        if self.awaiting.is_some() {
+            if let Err(error) = self.check(context).and_then(|()| self.pin_source(source)) {
+                return self.finish(Err(error));
+            }
+            return Admission::AwaitingAdmission;
+        }
+        let result = (|| {
+            self.check(context)?;
+            if !self.request.op.playback() {
+                return Err(LocalError::InvalidRequest);
+            }
+            self.selected_matches(source)?;
+            let ids = playable_ids(source, scan)?;
+            self.pin_source(source)?;
+            if scan.state == ScanState::Failed {
+                return Err(LocalError::CatalogUnavailable);
+            }
+            if scan.state == ScanState::Pending
+                || (scan.state != ScanState::Complete
+                    && (!self.request.progressive || ids.is_empty()))
+            {
+                return Ok(None);
+            }
+            if ids.is_empty() {
+                return Err(LocalError::EmptySource);
+            }
+            let seed = (self.request.op == LocalOp::Shuffle).then_some(seed);
+            if seed == Some(0) {
+                return Err(LocalError::NativeError);
+            }
+            let mut local = LocalContext::new(self.owner, source.clone(), seed);
+            local.replace_order(ids);
+            local.complete = scan.state == ScanState::Complete;
+            self.awaiting = Some(AdmissionPlan {
+                source: source.clone(),
+                count: local.order.len(),
+                scanning: !local.complete,
+            });
+            Ok(Some(local))
+        })();
+        match result {
+            Ok(None) => Admission::Wait,
+            Ok(Some(local)) => Admission::Propose(local),
+            Err(error) => self.finish(Err(error)),
+        }
+    }
+    /// Only call for the result of the umbrella's existing native admission.
+    /// source is its still-current receiver binding, not a stale captured copy.
+    pub fn finish_admission(
+        &mut self,
+        context: &AdmissionContext<'_>,
+        source: &BoundSource,
+        scan_state: ScanState,
+        admitted: Result<(), LocalError>,
+    ) -> Admission {
+        if self.completion.is_some() {
+            return Admission::Retired;
+        }
+        if self.awaiting.is_none() {
+            return Admission::Wait;
+        }
+        let result = (|| {
+            self.check(context)?;
+            source.playable()?;
+            self.pin_source(source)?;
+            admitted?;
+            if matches!(scan_state, ScanState::Pending | ScanState::Failed) {
+                return Err(LocalError::CatalogUnavailable);
+            }
+            let plan = self.awaiting.as_ref().ok_or(LocalError::NativeError)?;
+            playback_data(
+                &self.request,
+                &plan.source,
+                plan.count,
+                plan.scanning && scan_state == ScanState::Scanning,
+            )
+        })();
+        self.finish(result)
+    }
+}
+
+fn bounded(data: Value) -> Result<Value, LocalError> {
+    if serde_json::to_vec(&data)
+        .map_err(|_| LocalError::NativeError)?
+        .len()
+        > 196608
+    {
+        Err(LocalError::NativeError)
+    } else {
+        Ok(data)
+    }
+}
+fn playback_data(
+    request: &LocalRequest,
+    source: &BoundSource,
+    count: usize,
+    scanning: bool,
+) -> Result<Value, LocalError> {
+    let mut data = json!({"version":1,"runtime":request.runtime,"op":request.op.name(),"state":"ready",
+        "source":source.wire(false),"count":count,"shuffled":request.op == LocalOp::Shuffle,
+        "accepted":true,"playback_confirmed":false});
+    if request.session {
+        data["session"] = json!(true);
+    }
+    if scanning && request.progressive {
+        data["scanning"] = json!(true);
+    }
+    bounded(data)
+}
