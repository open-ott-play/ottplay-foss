+/// Artwork with an explicit fetch owner. HTTP images must never inherit Plex credentials.
+#[derive(Clone, PartialEq, Eq)]
+pub enum MediaArt {
+    /// Process-local source capability. Never serialize or reconstruct from a path or integer.
+    Local { key: plx_machine::machine::PosterKey },
+    Plex { server: u16, key: String },
+    Http { url: String },
+}
+impl std::fmt::Debug for MediaArt {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(match self { Self::Plex { .. } => "PlexArtwork", Self::Http { .. } => "HttpArtwork", Self::Local { .. } => "LocalArtwork" })
+    }
+}
