+    fn complete_setup(&mut self, succeeded: bool, persisted: bool) {
+        let Some(id) = self.pending_setup_save.take() else { return; };
+        let Some(setup) = self.setup.as_mut().filter(|setup| setup.id == id) else { return; };
+        if persisted {
+            // A verified write can still fail when applied to the running player.
+            // Retained input then edits our newly durable profile, not an external change.
+            setup.original = self.saved.profiles.profiles.iter()
+                .find(|profile| profile.id == setup.draft.profile_id()).cloned();
+        }
+        if succeeded {
