+    let path = root.0.join(ca::NAME);
+    std::fs::write(&path, CA_FRAME).unwrap();
+    std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o400)).unwrap();
+    let fixture = root.prepare(false).unwrap();
