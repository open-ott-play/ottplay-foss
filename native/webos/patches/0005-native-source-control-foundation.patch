+        let mut settings = BTreeMap::from([
+            ("selectedProvider".into(), json!("m3u")),
+            ("slot:m3u-1".into(), json!(1)),
+            ("offlineProfile:1".into(), json!({"name":"kept"})),
+        ]);
+        let original = settings.clone();
+        let empty = RememberedFolders::read(&settings).unwrap();
+        assert!(empty.folders().is_empty());
+        let connected = empty.with_connected(folder(0)).unwrap();
+        connected.put_into(&mut settings).unwrap();
+        assert_eq!(RememberedFolders::read(&settings).unwrap(), connected);
+        settings.remove(SETTINGS_KEY);
+        assert_eq!(settings, original);
+    }
+
+    #[test]
+    fn thirty_two_connections_are_independent_and_overflow_does_not_mutate() {
+        let mut roots = RememberedFolders::default();
+        for n in 0..32 {
+            roots = roots.with_connected(folder(n)).unwrap();
+        }
+        let before = roots.clone();
+        assert!(roots.with_connected(folder(32)).is_err());
+        assert_eq!(roots, before);
+        assert_eq!(roots.folders().len(), 32);
+    }
+
+    #[test]
+    fn duplicate_names_are_preserved_but_duplicate_id_or_path_is_rejected() {
+        let one = RememberedFolders::default()
+            .with_connected(folder(0))
+            .unwrap();
+        assert_eq!(one.with_connected(folder(0)).unwrap(), one);
+        let two = one.with_connected(folder(1)).unwrap();
+        assert_eq!(two.folders()[0].name, two.folders()[1].name);
+        let mut rebound = folder(0);
+        rebound.path = "/elsewhere/Movies".into();
+        assert!(one.with_connected(rebound).is_err());
+        let mut duplicate = folder(1);
+        duplicate.path = folder(0).path;
+        assert!(one.with_connected(duplicate).is_err());
+    }
+
+    #[test]
+    fn stored_descriptor_never_accepts_live_authority_or_availability_fields() {
+        for key in ["available", "authority_ref", "generation", "selected"] {
+            let mut row = serde_json::to_value(folder(0)).unwrap();
+            row[key] = json!(true);
+            let settings =
+                BTreeMap::from([(SETTINGS_KEY.into(), json!({"version":1,"folders":[row]}))]);
+            assert!(RememberedFolders::read(&settings).is_err(), "{key}");
+        }
+    }
+
+    #[test]
+    fn malformed_paths_and_source_names_cannot_enter_a_candidate() {
+        for path in [
+            "relative/Movies",
+            "~/Movies",
+            "https://example.test/Movies",
+            "C:/Movies",
+            "/media/../Movies",
+            "/media/./Movies",
+            "/media//Movies",
+            "/media/Movies/",
+            "/media/Movies\u{0}",
+        ] {
+            let mut row = folder(0);
+            row.path = path.into();
+            assert!(
+                RememberedFolders::default().with_connected(row).is_err(),
+                "{path:?}"
+            );
+        }
+        for name in ["", " ", ".", "..", "a/b", "a\\b", "a\n"] {
+            let mut row = folder(0);
+            row.name = name.into();
+            assert!(
+                RememberedFolders::default().with_connected(row).is_err(),
+                "{name:?}"
+            );
+        }
+    }
+
+    #[test]
+    fn canonical_private_posix_paths_do_not_acquire_portable_path_restrictions() {
+        for path in ["/", "/media/Фильмы", "/media/old\\disk/Movies"] {
+            let mut row = folder(0);
+            row.path = path.into();
+            assert!(RememberedFolders::default().with_connected(row).is_ok());
+        }
+    }
+
+    #[test]
+    fn unknown_version_duplicate_rows_and_unknown_collection_fields_are_rejected() {
+        for value in [
+            json!({"version":2,"folders":[]}),
+            json!({"version":1,"folders":[folder(0),folder(0)]}),
+            json!({"version":1,"folders":[],"active":0}),
+            Value::Null,
+        ] {
+            let settings = BTreeMap::from([(SETTINGS_KEY.into(), value)]);
+            assert!(RememberedFolders::read(&settings).is_err());
+        }
+    }
+}
diff --git a/rust-modules/src/app/ott_media_tracks.rs b/rust-modules/src/app/ott_media_tracks.rs
new file mode 100644
index 0000000000000000000000000000000000000000..30ab249016e09fdbac2912cb560bf3fa84e922b0
--- /dev/null
+++ b/rust-modules/src/app/ott_media_tracks.rs
@@ -0,0 +1,467 @@
+//! Passive current-source track receipts. The native route remains the only
+//! selection owner; this adapter neither probes media nor persists preferences.
+use super::*;
+use crate::app::ott_remote::media_tracks as wire;
+use crate::app::{ott_kiosk_policy as kiosk, ott_work_policy as work};
+use plx_media::ff::inspect::{InspectedTrack, TrackKind};
+use plx_media::route::{self, ExternalTrackChoice, ExternalTracks, TrackAvailability};
+
+pub(super) type PolicyReader = fn(&Runtime) -> Result<kiosk::State, ()>;
+
+#[derive(Clone, Debug)]
+struct Owner {
+    runtime: String,
+    playback: route::PlaybackIdentity,
+    worker: route::WorkerTicket,
+    inventory: ExternalTracks,
+    kiosk: kiosk::State,
+}
+impl PartialEq for Owner {
+    fn eq(&self, other: &Self) -> bool {
+        self.runtime == other.runtime
+            && self.playback == other.playback
+            && self.worker == other.worker
+            && self.inventory.same_session(&other.inventory)
+            && self.kiosk == other.kiosk
+    }
+}
+impl Eq for Owner {}
+struct Binding {
+    owner: Owner,
+    playback_token: String,
+    context: Option<wire::Context<Owner>>,
+}
+#[derive(Default)]
+pub(super) struct State {
+    catalog: wire::Catalog<Owner, ExternalTrackChoice>,
+    binding: Option<Binding>,
+}
+impl State {
+    fn invalidate(&mut self) {
+        self.catalog.invalidate();
+        if let Some(binding) = &mut self.binding {
+            binding.context = None;
+        }
+    }
+}
+
+fn capture(runtime: &Runtime, app: &App, policy: PolicyReader) -> Result<Owner, wire::Error> {
+    if !runtime.loaded || runtime.persistence_uncertain {
+        return Err(wire::Error::Unavailable);
+    }
+    let ps = &app.player.session;
+    if !route::has_url(ps) {
+        return Err(wire::Error::NoPlayback);
+    }
+    match plx_media::player::state(ps) {
+        plx_media::player::PlaybackState::Idle | plx_media::player::PlaybackState::Error => {
+            return Err(wire::Error::NoPlayback)
+        }
+        plx_media::player::PlaybackState::Resolving
+        | plx_media::player::PlaybackState::Connecting => return Err(wire::Error::Busy),
+        _ => {}
+    }
+    let playback = route::playback_identity(ps).ok_or(wire::Error::NoPlayback)?;
+    let source = route::external_source(ps).ok_or(wire::Error::Unsupported)?;
+    if matches!(source, plx_media::ff::ExternalSource::Hls(_)) {
+        return Err(wire::Error::Unsupported);
+    }
+    let inventory = route::external_tracks(ps).ok_or(wire::Error::CatalogIncomplete)?;
+    if !inventory.is_complete() {
+        return Err(wire::Error::CatalogIncomplete);
+    }
+    let kiosk = policy(runtime).map_err(|_| wire::Error::Restricted)?;
+    Ok(Owner {
+        runtime: runtime.remote.runtime().into(),
+        playback,
+        worker: route::worker_ticket(),
+        inventory: inventory.clone(),
+        kiosk,
+    })
+}
+
+fn label(track: &InspectedTrack) -> String {
+    if !track.title.trim().is_empty() {
+        return track.title.clone();
+    }
+    if let Some(key) = plx_data::metadata::lang_key(&track.language) {
+        return plx_plex::plex::languages::label(&key).to_string();
+    }
+    format!("Track {}", track.ordinal + 1)
+}
+fn inventory(
+    native: &ExternalTracks,
+    policy: kiosk::State,
+    token: &str,
+) -> wire::Inventory<ExternalTrackChoice> {
+    let mutable = kiosk::remote_track_selection_allowed(policy);
+    let embedded = native.inventory();
+    let subtitles = embedded
+        .subtitles
+        .len()
+        .saturating_add(native.local_subtitles().len());
+    if !native.is_complete()
+        || embedded.audio.len() > wire::MAX_TRACKS_PER_KIND
+        || subtitles > wire::MAX_TRACKS_PER_KIND
+        || embedded.audio.len().saturating_add(subtitles) > wire::MAX_TRACKS
+    {
+        return wire::Inventory::Incomplete;
+    }
+    let mut tracks = Vec::new();
+    for (kind, rows, prefix) in [
+        (wire::Kind::Audio, &native.inventory().audio, "a"),
+        (wire::Kind::Subtitle, &native.inventory().subtitles, "s"),
+    ] {
+        for track in rows {
+            // Audio stays visible but not selectable until the existing deferred
+            // native reload carries the original request guard through its effect.
+            let choice = (kind == wire::Kind::Subtitle
+                && mutable
+                && native.availability(track.kind, track.ordinal) == TrackAvailability::Supported)
+                .then(|| native.choice(track.kind, Some(track.ordinal)).ok())
+                .flatten();
+            tracks.push(wire::Track {
+                id: format!("{token}_{prefix}{}", track.ordinal),
+                kind,
+                label: label(track),
+                language: Some(track.language.clone()),
+                codec: Some(track.codec.clone()),
+                choice,
+            });
+        }
+    }
+    for (index, track) in native.local_subtitles().iter().enumerate() {
+        tracks.push(wire::Track {
+            // This is a short-lived catalog row ID, not the local target's
+            // identity or an index callers may reinterpret as a native ordinal.
+            id: format!("{token}_l{index}"),
+            kind: wire::Kind::Subtitle,
+            label: track.title.clone(),
+            language: Some(track.language.clone()),
+            codec: Some(track.format.codec().into()),
+            choice: mutable
+                .then(|| native.local_choice(&track.target).ok())
+                .flatten(),
+        });
+    }
+    wire::Inventory::Complete {
+        tracks,
+        subtitle_off: mutable
+            .then(|| native.choice(TrackKind::Subtitle, None).ok())
+            .flatten(),
+    }
+}
+fn synchronize(state: &mut State, runtime: &mut Runtime, owner: Owner) -> Result<(), wire::Error> {
+    if state
+        .binding
+        .as_ref()
+        .is_some_and(|binding| binding.context.is_some() && binding.owner == owner)
+    {
+        return Ok(());
+    }
+    let same_playback = state
+        .binding
+        .as_ref()
+        .filter(|b| b.owner.playback == owner.playback)
+        .map(|binding| binding.playback_token.clone());
+    state.invalidate();
+    let playback_token = match same_playback {
+        Some(token) => token,
+        None => super::super::favorites::nonce(runtime).map_err(|_| wire::Error::Unavailable)?,
+    };
+    let source_token =
+        super::super::favorites::nonce(runtime).map_err(|_| wire::Error::Unavailable)?;
+    let catalog_token =
+        super::super::favorites::nonce(runtime).map_err(|_| wire::Error::Unavailable)?;
+    let context = wire::Context::new(
+        owner.clone(),
+        runtime.remote.runtime().into(),
+        playback_token.clone(),
+        source_token,
+    )?;
+    state.catalog.install(
+        &context,
+        context.clone(),
+        catalog_token.clone(),
+        inventory(&owner.inventory, owner.kiosk, &catalog_token),
+    )?;
+    state.binding = Some(Binding {
+        owner,
+        playback_token,
+        context: Some(context),
+    });
+    Ok(())
+}
+
+fn invocation_current(runtime: &Runtime, invocation: &Invocation) -> Result<(), wire::Error> {
+    if !runtime.remote.invocation_is_current(invocation) {
+        return Err(wire::Error::RuntimeMismatch);
+    }
+    if runtime.now_ms() >= invocation.deadline_ms {
+        return Err(wire::Error::Unavailable);
+    }
+    Ok(())
+}
+fn mutation_allowed(app: &App, owner: &Owner) -> Result<(), wire::Error> {
+    if !app.running
+        || !work::playback_allowed(app.window_activity.allow_present(true), app.ott_standby)
+        || !kiosk::remote_track_selection_allowed(owner.kiosk)
+    {
+        return Err(wire::Error::Restricted);
+    }
+    if !controls::transport_ready(app) {
+        return Err(wire::Error::Busy);
+    }
+    Ok(())
+}
+fn apply(
+    state: &State,
+    runtime: &Runtime,
+    app: &mut App,
+    invocation: &Invocation,
+    selection: &wire::Selection<Owner, ExternalTrackChoice>,
+    policy: PolicyReader,
+) -> Result<wire::Response, wire::Error> {
+    invocation_current(runtime, invocation)?;
+    let owner = capture(runtime, app, policy)?;
+    mutation_allowed(app, &owner)?;
+    let binding = state.binding.as_ref().ok_or(wire::Error::CatalogChanged)?;
+    if owner != binding.owner {
+        return Err(wire::Error::CatalogChanged);
+    }
+    state
+        .catalog
+        .recheck(selection, binding.context.as_ref(), runtime.now_ms())?;
+    if selection.choice().kind() != TrackKind::Subtitle {
+        return Err(wire::Error::NotSelectable);
+    }
+    // Same-frame, synchronous commit through the manual picker owner. No-op
+    // selections require the shared no-op admission fix, not a bypass here.
+    route::apply_external_track(&mut app.player.session, selection.choice()).map_err(|error| {
+        match error {
+            route::ExternalTrackApplyError::Busy => wire::Error::Busy,
+            route::ExternalTrackApplyError::Inactive => wire::Error::NoPlayback,
+            route::ExternalTrackApplyError::InvalidChoice(_) => wire::Error::NotSelectable,
+        }
+    })?;
+    Ok(selection.requested_response())
+}
+
+pub(super) fn command(
+    runtime: &mut Runtime,
+    app: &mut App,
+    invocation: &Invocation,
+    policy: PolicyReader,
+) -> Value {
+    let request = invocation
+        .media_tracks_projection()
+        .and_then(|raw| wire::Request::decode(raw).ok());
+    let Some(request) = request else {
+        return rejected("Invalid raw media_tracks request");
+    };
+    let mut state = std::mem::take(&mut runtime.command_receipts.media_tracks);
+    let result = (|| {
+        invocation_current(runtime, invocation)?;
+        if request.runtime() != runtime.remote.runtime() {
+            return Err(wire::Error::RuntimeMismatch);
+        }
+        let owner = capture(runtime, app, policy).inspect_err(|_| state.invalidate())?;
+        synchronize(&mut state, runtime, owner)?;
+        let live = state
+            .binding
+            .as_ref()
+            .and_then(|binding| binding.context.as_ref());
+        if request.operation() == "list" {
+            return state.catalog.list(&request, live, runtime.now_ms());
+        }
+        let selection =
+            state
+                .catalog
+                .select(&request, live, runtime.now_ms(), invocation.deadline_ms)?;
+        apply(&state, runtime, app, invocation, &selection, policy)
+    })();
+    runtime.command_receipts.media_tracks = state;
+    result
+        .unwrap_or_else(|error| request.error_response(error))
+        .into_envelope()
+}
+
+/// Retire stale passive receipts at the existing command tick. This neither
+/// discovers media nor mints tokens; new mappings are minted only by list/select.
+pub(super) fn retire_stale(runtime: &mut Runtime, app: &App, policy: PolicyReader) {
+    let Some(binding) = runtime.command_receipts.media_tracks.binding.as_ref() else {
+        return;
+    };
+    if !capture(runtime, app, policy).is_ok_and(|owner| owner == binding.owner) {
+        runtime.command_receipts.media_tracks.invalidate();
+    }
+}
+
+#[cfg(test)]
+mod local_projection_tests {
+    use super::*;
+    use plx_media::ff::inspect::TrackInventory;
+    use route::{ExternalTrackError, LocalSubtitleTrack, SidecarFormat};
+
+    fn local(title: &str) -> LocalSubtitleTrack {
+        LocalSubtitleTrack {
+            target: Default::default(),
+            format: SidecarFormat::Srt,
+            title: title.into(),
+            language: "eng".into(),
+        }
+    }
+    fn native(rows: Vec<LocalSubtitleTrack>, complete: bool) -> ExternalTracks {
+        let track = InspectedTrack {
+            kind: TrackKind::Subtitle,
+            stream_index: 1,
+            ordinal: 0,
+            codec: "subrip".into(),
+            language: "spa".into(),
+            title: "Embedded".into(),
+            channels: 0,
+            sample_rate: 0,
+            bit_depth: 0,
+            decoder_available: true,
+            disposition_known: false,
+            default: false,
+            forced: false,
+        };
+        let mut native = ExternalTracks::new(
+            TrackInventory::complete_for_test(vec![track]).unwrap(),
+            Vec::new(),
+            vec![TrackAvailability::Supported],
+            None,
+        )
+        .unwrap();
+        native
+            .replace_local_subtitles(rows, complete, wire::MAX_TRACKS, wire::MAX_TRACKS_PER_KIND)
+            .unwrap();
+        native
+    }
+    fn complete(
+        native: &ExternalTracks,
+        policy: kiosk::State,
+    ) -> (
+        Vec<wire::Track<ExternalTrackChoice>>,
+        Option<ExternalTrackChoice>,
+    ) {
+        let wire::Inventory::Complete {
+            tracks,
+            subtitle_off,
+        } = inventory(native, policy, "c-fixture")
+        else {
+            panic!("complete fixture");
+        };
+        (tracks, subtitle_off)
+    }
+
+    #[test]
+    fn local_projection_is_distinct_from_embedded_zero_and_off() {
+        let row = local("Adjacent English");
+        let native = native(vec![row.clone()], true);
+        let (tracks, off) = complete(&native, kiosk::State::Off);
+        assert_eq!(tracks.len(), 2);
+        assert_ne!(tracks[0].id, tracks[1].id);
+        assert_eq!(tracks[0].choice.as_ref().unwrap().ordinal(), Some(0));
+        assert!(tracks[0].choice.as_ref().unwrap().local_target().is_none());
+        let chosen = tracks[1].choice.as_ref().unwrap();
+        assert_eq!(chosen.local_target(), Some(&row.target));
+        assert_eq!(chosen.ordinal(), None);
+        assert!(off.unwrap().local_target().is_none());
+        assert_eq!(tracks[1].codec.as_deref(), Some("srt"));
+        assert_eq!(tracks[1].label, row.title);
+    }
+
+    #[test]
+    fn incomplete_adjacent_discovery_does_not_issue_remote_receipts() {
+        let native = native(vec![local("Known row")], false);
+        assert!(!native.local_subtitles().is_empty());
+        assert!(matches!(
+            inventory(&native, kiosk::State::Off, "c-fixture"),
+            wire::Inventory::Incomplete
+        ));
+    }
+
+    #[test]
+    fn kiosk_keeps_local_rows_visible_but_not_selectable() {
+        let native = native(vec![local("Known row")], true);
+        let (tracks, off) = complete(&native, kiosk::State::Locked { strict: true });
+        assert_eq!(tracks.len(), 2);
+        assert!(tracks.iter().all(|row| row.choice.is_none()));
+        assert!(off.is_none());
+    }
+
+    #[test]
+    fn replacement_invalidates_projected_choice_even_at_identical_row_index() {
+        let mut native = native(vec![local("Same title")], true);
+        let (tracks, _) = complete(&native, kiosk::State::Off);
+        let old = tracks[1].choice.as_ref().unwrap().clone();
+        native
+            .replace_local_subtitles(
+                vec![local("Same title")],
+                true,
+                wire::MAX_TRACKS,
+                wire::MAX_TRACKS_PER_KIND,
+            )
+            .unwrap();
+        assert_eq!(native.plan(&old), Err(ExternalTrackError::StaleSession));
+        let (new, _) = complete(&native, kiosk::State::Off);
+        assert_ne!(old, new[1].choice.as_ref().unwrap().clone());
+    }
+
+    #[test]
+    fn remote_projection_uses_existing_wire_metadata_and_label_limits() {
+        let mut row = local(&"x".repeat(wire::MAX_LABEL_BYTES + 1));
+        row.language = "x".repeat(wire::MAX_METADATA_BYTES + 1);
+        let native = native(vec![row], true);
+        let mut catalog = wire::Catalog::default();
+        let context = wire::Context::new(
+            7u64,
+            "native-example".into(),
+            "p-example".into(),
+            "s-example".into(),
+        )
+        .unwrap();
+        catalog
+            .install(
+                &context,
+                context.clone(),
+                "c-example".into(),
+                inventory(&native, kiosk::State::Off, "c-example"),
+            )
+            .unwrap();
+        let request = wire::Request::decode(
+            br#"{"action":"media_tracks","params":{"op":"list","runtime":"native-example"}}"#,
+        )
+        .unwrap();
+        let response = catalog.list(&request, Some(&context), 100).unwrap();
+        let rows = response.data()["tracks"].as_array().unwrap();
+        assert_eq!(rows.len(), 2);
+        assert!(rows[1]["label"].as_str().unwrap().len() <= wire::MAX_LABEL_BYTES);
+        assert!(rows[1]["language"].is_null());
+        assert_eq!(rows[1]["codec"], "srt");
+    }
+
+    #[test]
+    fn projection_refuses_total_subtitle_overflow_instead_of_truncating() {
+        let mut native = native(Vec::new(), true);
+        // Deliberately inject a producer using a looser cap. Projection must
+        // enforce the existing remote contract independently and not truncate.
+        let rows = (0..wire::MAX_TRACKS_PER_KIND)
+            .map(|_| local("Known row"))
+            .collect();
+        native
+            .replace_local_subtitles(
+                rows,
+                true,
+                wire::MAX_TRACKS + 1,
+                wire::MAX_TRACKS_PER_KIND + 1,
+            )
+            .unwrap();
+        assert!(matches!(
+            inventory(&native, kiosk::State::Off, "c-fixture"),
+            wire::Inventory::Incomplete
+        ));
+    }
+}
diff --git a/rust-modules/src/app/ott_media_tracks_runtime_tests.rs b/rust-modules/src/app/ott_media_tracks_runtime_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e1a4e95949b79b5452bb9855f42c28978f68e4ad
--- /dev/null
+++ b/rust-modules/src/app/ott_media_tracks_runtime_tests.rs
@@ -0,0 +1,421 @@
+//! Real raw poll -> command dispatcher -> common native selection. Synthetic
+//! inventory and an inert host Engine avoid inspection, network and storage IO.
+use super::*;
+use plx_media::ff::inspect::{InspectedTrack, TrackInventory, TrackKind};
+use plx_media::{player, route};
+
+struct Globals {
+    state: u8,
+    offset: i64,
+}
+impl Globals {
+    fn capture() -> Self {
+        Self {
+            state: player::swap_state_for_test(player::PlaybackState::Idle),
+            offset: player::subtitle_offset_ms(),
+        }
+    }
+}
+impl Drop for Globals {
+    fn drop(&mut self) {
+        player::SHARED.reset_session();
+        player::TX.reset();
+        route::reset_player_control_for_test(&route::PlaybackSession::IDLE);
+        player::restore_state_for_test(self.state);
+        player::restore_subtitle_offset(self.offset);
+    }
+}
+fn track(kind: TrackKind, index: i32, ordinal: i32) -> InspectedTrack {
+    InspectedTrack {
+        kind,
+        stream_index: index,
+        ordinal,
+        codec: if kind == TrackKind::Audio {
+            "aac"
+        } else {
+            "subrip"
+        }
+        .into(),
+        language: if ordinal == 0 { "eng" } else { "spa" }.into(),
+        title: format!("Fixture {ordinal}"),
+        channels: 2,
+        sample_rate: 48000,
+        bit_depth: 16,
+        decoder_available: true,
+        disposition_known: false,
+        default: false,
+        forced: false,
+    }
+}
+fn install(app: &mut App, inventory: TrackInventory) {
+    playback::replace_player(
+        &mut app.player,
+        &mut app.adapters.player,
+        &mut app.repause_at,
+        &mut app.refresh_hubs,
+        &mut app.pages,
+    );
+    route::reset_player_control_for_test(&app.player.session);
+    let mut info = unsupported_info();
+    info.tracks = inventory;
+    info.video_codec = "h264".into();
+    info.audio_codec = "aac".into();
+    info.audio_channels = 2;
+    info.audio_sample_rate = 48000;
+    info.audio_bit_depth = 16;
+    route::request_external_source(
+        &mut app.player.session,
+        &info,
+        plx_media::ff::ExternalSource::Http("https://media.invalid/fixture.mkv".into()),
+        "Fixture",
+        "Tracks",
+        plx_platform::devcaps::assumed_shared(),
+    )
+    .unwrap();
+    route::reset_player_control_for_test(&app.player.session);
+    app.adapters
+        .player
+        .install(player::engine::engine_after_reload_for_test());
+    assert!(player::pause(&mut app.adapters.player));
+    player::swap_state_for_test(player::PlaybackState::Paused);
+    player::SHARED
+        .playpos_ns
+        .store(7_000_000_000, Ordering::Release);
+    player::SHARED
+        .duration_ns
+        .store(60_000_000_000, Ordering::Release);
+}
+fn fixture() -> App {
+    let mut app = app_fixture();
+    {
+        let runtime = app.ott.as_mut().unwrap();
+        runtime.loaded = true;
+        runtime.entropy = Some([9; 16]);
+        runtime.write_permit.revoke();
+    }
+    install(
+        &mut app,
+        TrackInventory::complete_for_test(vec![
+            track(TrackKind::Audio, 1, 0),
+            track(TrackKind::Subtitle, 2, 0),
+            track(TrackKind::Subtitle, 3, 1),
+        ])
+        .unwrap(),
+    );
+    mount_player(&mut app);
+    assert!(app.adapters.player.is_live());
+    app
+}
+fn request(app: &mut App, mut params: Value) -> Invocation {
+    let runtime = app.ott.as_mut().unwrap();
+    let runtime_id = runtime.remote.runtime().to_owned();
+    let now = runtime.now_ms();
+    params["runtime"] = json!(runtime_id);
+    runtime.remote = Remote::disabled_for_test("dev_fixture", &runtime_id);
+    let body=json!({"commands":[],"server_time":1000,"requests":[{"id":"0123456789abcdef0123456789abcdef","expires_at":1020,"action":"media_tracks","params":params}]}).to_string();
+    let mut inv = runtime
+        .remote
+        .raw_poll_for_test(&body, now)
+        .pop()
+        .expect("raw invocation");
+    inv.deadline_ms = runtime.now_ms() + 10000;
+    assert!(inv.media_tracks_projection().is_some());
+    inv
+}
+fn dispatch(app: &mut App, inv: &Invocation) -> Value {
+    let mut runtime = app.ott.take().unwrap();
+    let value = commands::command(&mut runtime, app, inv).expect("immediate track result");
+    app.ott = Some(runtime);
+    value
+}
+fn invoke(app: &mut App, params: Value) -> Value {
+    let inv = request(app, params);
+    dispatch(app, &inv)
+}
+fn list(app: &mut App) -> Value {
+    invoke(app, json!({"op":"list"}))
+}
+fn select(list: &Value, kind: &str, index: Option<usize>) -> Value {
+    let target = match index {
+        Some(index) => {
+            let rows: Vec<_> = list["data"]["tracks"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .filter(|row| row["kind"] == kind)
+                .collect();
+            json!({"kind":kind,"mode":"track","id":rows[index]["id"]})
+        }
+        None => json!({"kind":kind,"mode":"off"}),
+    };
+    json!({"op":"select","playback":list["data"]["playback"],"source_generation":list["data"]["source_generation"],"catalog":list["data"]["catalog"],"target":target})
+}
