+        if !persisted || self.edit_session.as_ref() != Some(session) {
+            return;
+        }
+        if let Some(profile) = self.edit_profile.as_ref().and_then(|draft|
+            self.saved.profiles.profiles.iter().find(|current| current.id == draft.id)).cloned()
