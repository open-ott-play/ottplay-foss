+#[test]
+fn metadata_deduplicates_only_requests_not_the_callers_occurrence_list() {
+    let input = ["2", "1", "2"];
+    let records = metadata_with(&input, |path| {
+        assert_eq!(path, "/library/metadata/2,1");
+        Ok(page(
+            0,
+            vec![item("1", "episode"), item("2", "movie")],
+            Some(2),
+            false,
+        ))
+    })
+    .unwrap();
+    assert_eq!(input, ["2", "1", "2"]);
