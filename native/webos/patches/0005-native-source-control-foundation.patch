+}
+
+#[test]
+fn local_folder_reuses_descriptor_identity_without_path_or_members() {
+    let origin = Origin {
+        provider: "local".into(),
+        profile: "Local videos".into(),
+        subprofile: None,
+        source_alias: "Fixture".into(),
+    };
+    let pin =
+        Stored::local_folder(origin.clone(), false, "source-1".into(), "a".repeat(64)).unwrap();
