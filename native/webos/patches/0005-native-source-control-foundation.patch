+        fn logo(&self, _: u16, _: &str) -> Option<PosterKey> { panic!("no fallback") }
+        fn logo_warm(&self, _: u16, _: &str) -> Warm { panic!("no fallback") }
+        fn unresident(&self, _: PosterKey, _: bool) {}
+        fn idle(&self) -> bool { true }
+    }
+    static NO_LOCAL: NoLocalSupport = NoLocalSupport;
+
+    struct Up;
+    impl Uploader for Up {
+        fn upload(&mut self, image: &Decoded) -> Tex { Tex { id: 91, w: image.w, h: image.h } }
+        fn warm(&mut self, _: Tex) {}
+        fn free(&mut self, _: Tex) {}
+    }
+    struct Fixture {
+        old_cache: Option<TexCache<PosterKey>>,
+        old_source: Option<&'static dyn Source>,
+    }
+    impl Fixture {
+        fn resident() -> Self {
+            let old_source = SOURCE.with(|source| source.replace(None));
+            let old_cache = mutate_cache(|cache| std::mem::replace(cache, TexCache::with_budget(8, 1024)));
+            PROBES.with(|n| n.set(0));
+            ANSWER.with(|a| a.set(None));
+            let result = Self { old_cache: Some(old_cache), old_source };
+            for key in [KEY, OTHER] {
+                accept(PosterReady { key, result: Ok(Decoded { w: 2, h: 2, rgba: vec![0; 16].into_boxed_slice() }) });
+            }
+            let mut budget = Budget::new();
+            budget.begin_frame(0);
+            let mut present = Present::new();
+            prepare(&mut budget, &mut Up, &mut PresentHandle::of(&mut present), || 0);
+            assert!(resident(KEY));
+            assert!(resident(OTHER));
+            result
+        }
+    }
+    impl Drop for Fixture {
+        fn drop(&mut self) {
+            SOURCE.with(|source| source.set(self.old_source));
+            if let Some(old) = self.old_cache.take() { mutate_cache(|cache| *cache = old); }
+        }
+    }
+
+    #[test]
+    fn local_art_revalidates_before_reading_even_a_resident_texture() {
+        let _lock = plx_base::testlock::serial();
+        let _fixture = Fixture::resident();
+        let absent = (0, 0.0, 0.0);
+        assert_eq!(resolve_local(KEY), absent, "no source cannot expose cached pixels");
+        install(&GATE);
+        assert_eq!(resolve_local(KEY), absent, "unknown, pending or revoked grant");
+        ANSWER.with(|a| a.set(Some(KEY)));
+        assert_eq!(resolve_local(KEY), (91, 2.0, 2.0));
+        ANSWER.with(|a| a.set(None));
+        assert!(resident(KEY), "revocation must be checked before stale cache residency");
+        assert_eq!(resolve_local(KEY), absent);
+        assert_eq!(PROBES.with(Cell::get), 3, "every resolution revalidates the grant");
+    }
+
+    #[test]
+    fn local_art_refuses_foreign_keys_and_missing_pixels_without_fallback() {
+        let _lock = plx_base::testlock::serial();
+        let _fixture = Fixture::resident();
+        install(&GATE);
+        ANSWER.with(|a| a.set(Some(OTHER)));
+        assert_eq!(resolve_local(KEY), (0, 0.0, 0.0), "a different ready key cannot substitute an asset");
+        ANSWER.with(|a| a.set(Some(KEY)));
+        assert_eq!(resolve_local(PosterKey(999)), (0, 0.0, 0.0), "an unissued key cannot borrow the ready key");
+        free(KEY, &mut Up);
+        assert_eq!(resolve_local(KEY), (0, 0.0, 0.0), "evicted pixels stay a placeholder");
+    }
+
+    #[test]
+    fn local_art_default_source_is_opt_in_even_when_pixels_exist() {
+        let _lock = plx_base::testlock::serial();
+        let _fixture = Fixture::resident();
+        install(&NO_LOCAL);
+        assert_eq!(resolve_local(KEY), (0, 0.0, 0.0));
+    }
+
+    #[test]
+    fn local_art_card_uses_the_guarded_cache_and_shared_placeholder() {
+        use crate::widgets::{Art, art_crop, card, card_art_request, resolve_card_art};
+        let _lock = plx_base::testlock::serial();
+        let _fixture = Fixture::resident();
+        install(&GATE);
+        let rect = crate::Rect::new(20.0, 30.0, 250.0, 375.0);
+        let art = || Art::Local { key: &KEY };
+        assert!(card_art_request(&art()).is_none(), "local art has no server/path request");
+        assert!(matches!(art_crop(&art()), crate::Crop::Centre));
+        ANSWER.with(|a| a.set(Some(KEY)));
+        assert_eq!(resolve_card_art(crate::Painter::root(), rect, &art()).tex, 91);
+        ANSWER.with(|a| a.set(None));
+        assert_eq!(resolve_card_art(crate::Painter::root(), rect, &art()).tex, 0);
+        let (_, counters) = crate::placeholder::capture_declared(||
+            card(crate::Painter::root(), rect, art(), 8.0, false, 1.0, 0.0));
+        assert_eq!(counters.of(crate::placeholder::Reason::CardGround), 1);
+        assert_eq!(counters.entries[0].key, "local-art", "no private path or key appears in diagnostics");
+    }
+}
