+    let mut runtime = app.ott.take().unwrap();
+    runtime.reply = app.pages.top_page();
+    handle_action(
+        &mut runtime,
+        app,
+        OttAction::EditSetting("remote.address".into()),
+    )
+    .unwrap();
+    let session = runtime.edit_session.clone().unwrap();
+    app.ott = Some(runtime);
+    settle_pages(app);
