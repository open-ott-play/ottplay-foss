@@ -0,0 +1,175 @@
+//! Localization at the native UI boundary. Runtime diagnostics, saved values,
+//! source identities and provider metadata retain their original bytes.
+use plx_platform::i18n::{self, msg, LocaleContext};
+use plx_screens::ott::{OttAction, OttView};
+
+pub(super) fn text(source: &str) -> &str { text_in(source, i18n::current()) }
+
+fn text_in<'a>(source: &'a str, cx: &LocaleContext) -> &'a str {
+    match source {
+        "Add profile" => msg::ott_profile_add_in(cx),
+        "Profile name" => msg::ott_profile_name_in(cx),
+        "Source address or folder" | "New profile source" => msg::ott_profile_source_in(cx),
+        "Profile setup" => msg::ott_profile_setup_in(cx),
+        "Enter the connection details supplied by your provider" => msg::ott_profile_help_in(cx),
+        "Enter a source address or folder" => msg::ott_profile_source_help_in(cx),
+        "Save profile" => msg::ott_profile_save_in(cx),
+        "Not set" => msg::ott_profile_not_set_in(cx),
+        "Set" => msg::ott_profile_set_in(cx),
+        "Server URL" => msg::ott_profile_server_in(cx),
+        "Portal URL" => msg::ott_profile_portal_in(cx),
+        "Username" => msg::ott_profile_username_in(cx),
+        "Password" => msg::ott_profile_password_in(cx),
+        "MAC address" => msg::ott_profile_mac_in(cx),
