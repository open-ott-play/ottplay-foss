+#[test]
+fn successful_pairing_response_and_new_discovery_clear_stale_network_evidence() {
+    use plx_net::net::RequestError::TimedOut;
+    let mut remote = Remote::disabled_for_test("dev_test", "runtime");
+    remote
+        .begin_pairing("https://control.invalid", "home", 0)
+        .unwrap();
+    remote.finish(Kind::Pairing, failed(failure(TimedOut, Some(28))), 100);
+    remote.finish(
+        Kind::Pairing,
+        response(
+            201,
+            json!({
+                "id":"0123456789abcdef0123456789abcdef", "secret":"c".repeat(32),
+                "code":"ABCD1234", "expires_in":60
+            }),
+        ),
+        200,
+    );
+    assert_eq!(remote.snapshot()["state"], "waiting");
+    assert_eq!(
+        remote.snapshot()["message"],
+        "Approve the pairing code with ott"
+    );
+    remote.finish(
+        Kind::Pairing,
+        response(202, json!({"status":"pending"})),
+        300,
+    );
+    assert!(!remote.snapshot()["message"]
+        .as_str()
+        .unwrap()
+        .contains("HTTP 202"));
+    remote.finish(Kind::Pairing, failed(failure(TimedOut, Some(28))), 400);
+    remote
+        .discover_and_pair("https://new-control.invalid", 500)
+        .unwrap();
+    assert_eq!(remote.snapshot()["message"], "Finding command server");
+}
+
+#[test]
+fn delivery_preserves_retry_and_expired_receipt_rules_while_showing_http_code() {
+    let mut remote = Remote::disabled_for_test("dev_test", "runtime");
+    remote.finish(
+        Kind::Delivery(SendKind::Poll),
+        response(500, json!({"error":PRIVATE_BODY})),
+        100,
+    );
+    assert_eq!(remote.failures, 1);
+    assert_eq!(remote.next_ms, 2100);
+    assert!(remote.snapshot()["message"]
+        .as_str()
+        .unwrap()
+        .contains("HTTP 500"));
+    assert!(!remote.snapshot().to_string().contains("SECRET"));
+    remote.finish(
+        Kind::Delivery(SendKind::Response),
+        response(404, Value::Null),
+        300,
+    );
+    assert_eq!(
+        remote.failures, 1,
+        "expired response handling is not a transport retry"
+    );
+    assert_eq!(remote.next_ms, 1300);
+    assert!(remote.snapshot()["message"]
+        .as_str()
+        .unwrap()
+        .contains("HTTP 404"));
+    remote.apply(Config::disabled("dev_test".into()), true);
+    assert_eq!(remote.snapshot()["message"], "Remote control disabled");
+}
diff --git a/rust-modules/src/app/ott_remote/ingress.rs b/rust-modules/src/app/ott_remote/ingress.rs
new file mode 100644
index 0000000000000000000000000000000000000000..257ba7eabab9872e67558fee8e6f5274736f3fc8
--- /dev/null
+++ b/rust-modules/src/app/ott_remote/ingress.rs
@@ -0,0 +1,136 @@
+//! Strict raw poll decoding before delivery can remember or dispatch any IDs.
+//! This stays at the native remote boundary: it does not change profile, pairing
+//! or discovery formats and does not import a UI or build-time JSON reader.
+use serde::de::{self, Deserialize, Deserializer, MapAccess, SeqAccess, Visitor};
+use serde_json::{value::RawValue, Map, Number, Value};
+use std::fmt;
+
+/// A poll whose whole JSON tree and media-track projections were checked before
+/// Delivery can remember any ID. The projection belongs to its first request,
+/// matching the existing Delivery admission rule; later requests are still checked.
+pub(super) struct Poll {
+    pub(super) value: Value,
+    pub(super) media_tracks_raw: Option<String>,
+}
+
+#[derive(serde::Deserialize)]
+struct RawRequests<'a> {
+    #[serde(borrow)]
+    requests: Vec<&'a RawValue>,
+}
+
+#[derive(serde::Deserialize)]
+struct RawTrackFields<'a> {
+    #[serde(borrow)]
+    action: &'a RawValue,
+    #[serde(borrow)]
+    params: &'a RawValue,
+}
+
+/// Decode the whole response within the existing transport limit. Serde's
+/// normal recursion guard remains enabled; duplicate decoded keys are rejected
+/// even inside nested arrays or unused request entries, before producing Value.
+/// The native media_tracks limit is the received action/params projection:
+/// 21 + raw action bytes + raw params bytes. Transport fields are excluded; this
+/// does not claim knowledge of the controller's original inbound HTTP length.
+pub(super) fn decode_poll(bytes: &[u8]) -> Result<Poll, serde_json::Error> {
+    if bytes.len() > super::protocol::BODY_LIMIT {
+        return Err(de::Error::custom("remote poll exceeds the body limit"));
+    }
+    let value = serde_json::from_slice::<Unique>(bytes)?.0;
+    let mut media_tracks_raw = None;
+    // Preserve existing envelope validation in Delivery. In particular, absent,
+    // null or wrongly typed requests retain their existing admission semantics.
+    if let Some(requests) = value.get("requests").and_then(Value::as_array).filter(|items| {
+        items.iter().any(|request| request.get("action").and_then(Value::as_str) == Some("media_tracks"))
+    }) {
+        let raw: RawRequests<'_> = serde_json::from_slice(bytes)?;
+        for (index, request) in requests.iter().enumerate() {
+            // Decode the action before recognition: escapes cannot bypass validation.
+            if request.get("action").and_then(Value::as_str) != Some("media_tracks") {
+                continue;
+            }
+            let received = raw.requests.get(index)
+                .ok_or_else(|| <serde_json::Error as de::Error>::custom("invalid raw request index"))?;
+            let fields: RawTrackFields<'_> = serde_json::from_str(received.get())?;
+            let projection = format!("{{\"action\":{},\"params\":{}}}",
+                fields.action.get(), fields.params.get());
+            super::media_tracks::Request::decode(projection.as_bytes())
+                .map_err(|_| <serde_json::Error as de::Error>::custom("invalid media_tracks request projection"))?;
+            if index == 0 {
+                media_tracks_raw = Some(projection);
+            }
+        }
+    }
+    Ok(Poll { value, media_tracks_raw })
+}
+
+struct Unique(Value);
+
+impl<'de> Deserialize<'de> for Unique {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        deserializer.deserialize_any(UniqueVisitor)
+    }
+}
+
+struct UniqueVisitor;
+
+impl<'de> Visitor<'de> for UniqueVisitor {
+    type Value = Unique;
+
+    fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("JSON with unique object keys")
+    }
+
+    fn visit_map<A: MapAccess<'de>>(self, mut map: A) -> Result<Unique, A::Error> {
+        let mut values = Map::new();
+        while let Some(key) = map.next_key::<String>()? {
+            if values.contains_key(&key) {
+                // Do not include the potentially private key or value in errors.
+                // Reject before allocating the duplicate key's nested value.
+                return Err(de::Error::custom("duplicate remote JSON key"));
+            }
+            let value = map.next_value::<Unique>()?;
+            values.insert(key, value.0);
+        }
+        Ok(Unique(Value::Object(values)))
+    }
+
+    fn visit_seq<A: SeqAccess<'de>>(self, mut sequence: A) -> Result<Unique, A::Error> {
+        let mut values = Vec::new();
+        while let Some(value) = sequence.next_element::<Unique>()? {
+            values.push(value.0);
+        }
+        Ok(Unique(Value::Array(values)))
+    }
+
+    fn visit_bool<E: de::Error>(self, value: bool) -> Result<Unique, E> {
+        Ok(Unique(Value::Bool(value)))
+    }
+
+    fn visit_i64<E: de::Error>(self, value: i64) -> Result<Unique, E> {
+        Ok(Unique(Value::Number(value.into())))
+    }
+
+    fn visit_u64<E: de::Error>(self, value: u64) -> Result<Unique, E> {
+        Ok(Unique(Value::Number(value.into())))
+    }
+
+    fn visit_f64<E: de::Error>(self, value: f64) -> Result<Unique, E> {
+        Number::from_f64(value)
+            .map(|value| Unique(Value::Number(value)))
+            .ok_or_else(|| de::Error::custom("nonfinite remote JSON number"))
+    }
+
+    fn visit_str<E: de::Error>(self, value: &str) -> Result<Unique, E> {
+        Ok(Unique(Value::String(value.to_owned())))
+    }
+
+    fn visit_string<E: de::Error>(self, value: String) -> Result<Unique, E> {
+        Ok(Unique(Value::String(value)))
+    }
+
+    fn visit_unit<E: de::Error>(self) -> Result<Unique, E> {
+        Ok(Unique(Value::Null))
+    }
+}
diff --git a/rust-modules/src/app/ott_remote/ingress_tests.rs b/rust-modules/src/app/ott_remote/ingress_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3146abcedc81ef7ff2e8375b51fe76a075525aa5
--- /dev/null
+++ b/rust-modules/src/app/ott_remote/ingress_tests.rs
@@ -0,0 +1,129 @@
+//! Exercise the real raw poll completion before Delivery sees a Value.
+//! No worker, network request, storage access or application command is run.
+use super::*;
+
+const REQUEST_ID: &str = "0123456789abcdef0123456789abcdef";
+
+fn raw_poll(remote: &mut Remote, body: &[u8]) -> Vec<Invocation> {
+    remote.finish(
+        Kind::Delivery(SendKind::Poll),
+        Outcome::Http {
+            response: Ok(protocol::Response {
+                status: 200,
+                body: body.to_vec(),
+            }),
+            elapsed_ms: 10,
+        },
+        100,
+    )
+}
+
+fn request_document(fields: &str) -> String {
+    format!(
+        r#"{{"commands":[{{"id":"legacy-fixture","key":"up"}}],"server_time":1000,"requests":[{{"id":"{REQUEST_ID}","expires_at":1020,{fields}}}]}}"#
+    )
+}
+
+fn ordinary_document() -> String {
+    request_document(r#""action":"playback","params":{"operation":"pause"}"#)
+}
+
+fn assert_refused_before_admission(body: &[u8]) {
+    let mut remote = Remote::disabled_for_test("dev_fixture", "runtime-fixture");
+    assert!(raw_poll(&mut remote, body).is_empty(), "ambiguous poll dispatched an action");
+    assert_eq!(remote.snapshot()["state"], "error");
+    assert!(remote.delivery.idle(), "invalid poll queued an acknowledgment");
+    assert!(remote.flight.is_none());
+    assert!(remote.take_effects().is_empty());
+
+    // A later well-formed poll using the same IDs must still be admitted. This
+    // proves that neither the legacy command nor request was marked as seen.
+    let admitted = raw_poll(&mut remote, ordinary_document().as_bytes());
+    assert_eq!(admitted.len(), 2);
+    assert_eq!(admitted[0].id, "legacy-fixture");
+    assert_eq!(admitted[1].id, REQUEST_ID);
+    assert_eq!(admitted[1].action, "playback");
+    assert_eq!(admitted[1].params, json!({"operation":"pause"}));
+}
+
+#[test]
+fn raw_poll_rejects_duplicate_action_params_and_nested_keys_atomically() {
+    for fields in [
+        r#""action":"playback","action":"lifecycle","params":{}"#,
+        r#""action":"playback","params":{"operation":"pause"},"params":{"operation":"play"}"#,
+        r#""action":"playback","params":{"operation":"pause","operation":"play"}"#,
+        r#""action":"media_tracks","params":{"op":"select","target":{"kind":"audio","mode":"track","id":"one","id":"two"}}"#,
+        r#""action":"playback","params":{"nested":[{"value":1,"value":2}]}"#,
+        r#""action":"playback","params":{"operation":"pause","\u006fperation":"play"}"#,
+    ] {
+        assert_refused_before_admission(request_document(fields).as_bytes());
+    }
+}
+
+#[test]
+fn raw_poll_rejects_duplicate_envelope_and_legacy_fields_atomically() {
+    let ordinary = ordinary_document();
+    let duplicate_envelope = ordinary.replacen(
+        "\"server_time\":1000,",
+        "\"server_time\":999,\"server_time\":1000,",
+        1,
+    );
+    assert_refused_before_admission(duplicate_envelope.as_bytes());
+    let duplicate_legacy = ordinary.replacen(
+        "\"key\":\"up\"",
+        "\"key\":\"down\",\"key\":\"up\"",
+        1,
+    );
+    assert_refused_before_admission(duplicate_legacy.as_bytes());
+    let duplicate_unused_request = ordinary.replacen(
+        "]}",
+        ",{\"id\":\"fedcba9876543210fedcba9876543210\",\"action\":\"playback\",\"params\":{\"operation\":\"pause\",\"operation\":\"play\"}}]}",
+        1,
+    );
+    assert_refused_before_admission(duplicate_unused_request.as_bytes());
+}
+
+#[test]
+fn raw_poll_body_limit_is_checked_before_admission() {
+    let mut exact = ordinary_document().into_bytes();
+    exact.resize(protocol::BODY_LIMIT, b' ');
+    let mut remote = Remote::disabled_for_test("dev_fixture", "runtime-fixture");
+    assert_eq!(raw_poll(&mut remote, &exact).len(), 2);
+    assert_eq!(remote.snapshot()["state"], "connected");
+    exact.push(b' ');
+    assert_refused_before_admission(&exact);
+}
+
+#[test]
+fn raw_poll_preserves_ordinary_values_and_existing_replay_rules() {
+    let mut remote = Remote::disabled_for_test("dev_fixture", "runtime-fixture");
+    let params = json!({
+        "operation":"pause", "signed":-2, "fraction":1.25,
+        "large":18446744073709551615u64, "unicode":"日本語 café",
+        "nested":[null,true,false,{"first":1},{"first":2}]
+    });
+    let document = request_document(&format!("\"action\":\"playback\",\"params\":{params}"));
+    let first = raw_poll(&mut remote, document.as_bytes());
+    assert_eq!(first.len(), 2);
+    assert_eq!(first[0].action, "command");
+    assert_eq!(first[1].params, params);
+    assert_eq!(first[1].deadline_ms, 20_090);
+    assert!(raw_poll(&mut remote, document.as_bytes()).is_empty(),
+        "strict decoding must not alter pending-request replay protection");
+}
+
+#[test]
+fn raw_poll_rejects_bad_json_and_excessive_nesting_without_dispatch() {
+    let deep = format!("{}0{}", "[".repeat(200), "]".repeat(200));
+    let deep_document = request_document(&format!(
+        "\"action\":\"playback\",\"params\":{{\"nested\":{deep}}}"
+    ));
+    assert_refused_before_admission(deep_document.as_bytes());
+    for body in [
+        format!("{} true", ordinary_document()),
+        request_document(r#""action":"playback","params":{"bad":1e999}"#),
+        request_document(r#""action":"playback","params":{"bad":NaN}"#),
+    ] {
+        assert_refused_before_admission(body.as_bytes());
+    }
+}
