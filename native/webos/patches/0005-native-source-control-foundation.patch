+    assert!(fixture.install_ca(&source, "https://127.0.0.1:9443").is_err());
+    for bytes in [vec![], b"not a PEM".to_vec(), b"-----BEGIN PRIVATE KEY-----\nsecret\n-----END PRIVATE KEY-----".to_vec(), vec![b'x'; 256 * 1024 + 1]] {
+        let path = ca_input(&input, &bytes);
