+#[test]
+fn long_syntactic_language_tokens_remain_private_and_are_not_silently_truncated() {
+    let suffix = format!("en{}", "-abcdefgh".repeat(5));
+    let filename = format!("Movie.{suffix}.srt");
+    let rows = observed(&[&filename]);
