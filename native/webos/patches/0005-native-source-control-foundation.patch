+        assert_eq!(row(&menu, TrackRow::Audio(1)).label, "Español");
+        assert!(
+            row(&menu, TrackRow::Audio(0)).badges.is_empty(),
+            "unknown flags cannot imply Original or Forced"
+        );
+        assert!(row(&menu, TrackRow::Audio(0)).checked);
