+            Catalog { entries: vec![row] })).unwrap();
+        runtime_tick(&mut app);
+        assert!(app.ott.as_ref().unwrap().play_target.is_none());
+        assert!(app.ott.as_ref().unwrap().resolver_next.is_none());
+    }
+}
