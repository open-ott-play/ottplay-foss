+    assert!(matches!(
+        &old_completion.result,
+        Outcome::Read { result: Ok(_), .. }
+    ));
+
+    app.ott.as_mut().unwrap().cancel_catalog();
+    assert!(old_cancel.load(Ordering::Acquire));
+    assert!(playing_context(app.ott.as_ref().unwrap(), &app).is_some());
+    poll(&mut app);
+    {
