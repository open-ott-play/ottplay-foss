+fn content_overlay_owner(app: &App) -> MachineId {
+    let Some(InputOwner::Entry(entry)) = app.pages.nav.input_owner() else {
+        panic!("mounted track overlay must own input");
+    };
+    MachineId::Instance(
+        app.pages
+            .nav
+            .entry(entry)
+            .expect("live overlay entry")
+            .inst
+            .as_ref()
+            .expect("mounted overlay")
+            .id,
+    )
+}
