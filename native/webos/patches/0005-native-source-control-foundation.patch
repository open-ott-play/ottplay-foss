+    /// Both scalar and structured editors retain the original target snapshot.
+    /// Validate only that target so unrelated profile updates remain saveable.
+    fn profile_candidate(&self, profile: ProviderProfile, original: Option<&ProviderProfile>)
+        -> Result<Saved, &'static str>
+    {
+        let current = self.saved.profiles.profiles.iter().find(|p| p.id == profile.id);
+        if current != original {
+            return Err("This profile changed; reopen its setup before saving");
+        }
+        let mut candidate = self.saved.clone();
+        if let Some(existing) = candidate.profiles.profiles.iter_mut().find(|p| p.id == profile.id) {
+            *existing = profile.clone();
+        } else {
+            candidate.profiles.check_addition(profile.kind).map_err(|error| error.message())?;
+            candidate.profiles.profiles.push(profile.clone());
+        }
+        candidate.profiles.active_profile = Some(profile.id);
+        candidate.validate()?;
+        Ok(candidate)
+    }
