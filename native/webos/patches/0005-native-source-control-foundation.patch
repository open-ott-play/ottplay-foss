+    Off,
+    /// First accepted selection has not yet been durably pinned.
+    Armed { strict: bool },
+    Locked { strict: bool },
+}
+
+pub(super) fn remote_track_selection_allowed(state: State) -> bool {
+    matches!(state, State::Off)
+}
