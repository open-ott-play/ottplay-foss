+#[test]
+fn snapshot_rejects_inconsistent_presence_and_invalid_revisions() {
+    let status = ott::Status {
+        db_rev: "1".into(),
+        revision: 1,
+        epoch: 1,
+        barrier: ott::Barrier::Open,
+        control_present: false,
+        state_present: true,
+    };
+    assert!(load_with(&mut |_| Ok(Response::OttLoaded {
+        snapshot: Some(ott::Snapshot {
+            status: status.clone(),
+            control: None,
+            state: None,
+        })
+    }))
+    .is_err());
+    let mut bad = status;
