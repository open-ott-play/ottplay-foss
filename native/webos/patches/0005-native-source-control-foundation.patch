+    fn setup_candidate(&self) -> Result<(u64, Saved), &'static str> {
+        let setup = self.setup.as_ref().ok_or("Profile setup is no longer active")?;
+        let profile = setup.draft.prepare()?;
+        let candidate = self.profile_candidate(profile, setup.original.as_ref())?;
+        Ok((setup.id, candidate))
+    }
