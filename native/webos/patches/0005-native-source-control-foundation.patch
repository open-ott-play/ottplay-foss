+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum ContinuityEffect {
+    None,
+    Stop,
+    Pause,
+    Resume,
+    Selected,
+}
+pub(super) enum LocalIntent<'a> {
+    Stop,
+    Pause,
+    Resume,
+    Selected(&'a str),
+}
+pub(super) struct LocalUpdate {
+    pub continuation_allowed: bool,
+}
+
+/// Not Serialize: persistence is an explicit verified promotion at the umbrella.
+/// This contains no Favorites document or copy of the old durable settings.
+pub(super) struct LocalContext {
+    owner: OwnerToken,
+    source: BoundSource,
+    order: Vec<String>,
+    seed: Option<u32>,
+    current: Option<String>,
+    position_ms: u64,
+    complete: bool,
+    stopped: bool,
+    paused: bool,
+    category: String,
+    favorites_selected: bool,
+}
+impl LocalContext {
+    fn new(owner: OwnerToken, source: BoundSource, seed: Option<u32>) -> Self {
+        Self {
+            owner,
+            source,
+            order: Vec::new(),
+            seed,
+            current: None,
+            position_ms: 0,
+            complete: false,
+            stopped: false,
+            paused: false,
+            category: String::new(),
+            favorites_selected: false,
+        }
+    }
+    pub fn owner(&self) -> OwnerToken {
+        self.owner
+    }
+    pub fn source(&self) -> &BoundSource {
+        &self.source
+    }
+    pub fn order(&self) -> &[String] {
+        &self.order
+    }
+    pub fn current(&self) -> Option<&str> {
+        self.current.as_deref()
+    }
+    pub fn position_ms(&self) -> u64 {
+        self.position_ms
+    }
+    pub fn view_selection(&self) -> (&str, bool) {
+        (&self.category, self.favorites_selected)
+    }
+    pub fn set_view_selection(
+        &mut self,
+        owner: OwnerToken,
+        category: &str,
+        favorites: bool,
+    ) -> Result<(), LocalError> {
+        if owner != self.owner {
+            return Err(LocalError::RuntimeChanged);
+        }
+        if !text(category, 4096, false) {
+            return Err(LocalError::InvalidRequest);
+        }
+        self.category = category.into();
+        self.favorites_selected = favorites;
+        Ok(())
+    }
+    fn replace_order(&mut self, ids: Vec<&str>) {
+        {
+            let present: HashSet<_> = ids.iter().copied().collect();
+            self.order.retain(|id| present.contains(id.as_str()));
+        }
+        let mut added: Vec<String> = {
+            let old: HashSet<_> = self.order.iter().map(String::as_str).collect();
+            ids.into_iter()
+                .filter(|id| !old.contains(id))
+                .map(str::to_owned)
+                .collect()
+        };
+        if let Some(seed) = self.seed {
+            shuffle(&mut added, seed);
+        }
+        self.order.extend(added);
+    }
+    /// No command deadline here: after admission the common session token and
+    /// source generation own the existing background catalogue stream.
+    pub fn update(
+        &mut self,
+        owner: OwnerToken,
+        scan: &CatalogSnapshot<'_>,
+    ) -> Result<LocalUpdate, LocalError> {
+        if owner != self.owner {
+            return Err(LocalError::RuntimeChanged);
+        }
+        let ids = playable_ids(&self.source, scan)?;
+        if scan.state == ScanState::Failed {
+            return Err(LocalError::CatalogUnavailable);
+        }
+        if scan.state == ScanState::Pending || (self.complete && scan.state != ScanState::Complete)
+        {
+            return Err(LocalError::CatalogUnavailable);
+        }
+        self.replace_order(ids);
+        self.complete = scan.state == ScanState::Complete;
+        Ok(LocalUpdate {
+            continuation_allowed: !self.stopped && !self.paused,
+        })
+    }
+    /// Forward the returned effect to the existing Continuity; this module does
+    /// not advance a queue, wrap EOF or implement a second repeat policy.
+    pub fn note_intent(
+        &mut self,
+        owner: OwnerToken,
+        intent: LocalIntent<'_>,
+    ) -> Result<ContinuityEffect, LocalError> {
+        if owner != self.owner {
+            return Err(LocalError::RuntimeChanged);
+        }
+        match intent {
+            LocalIntent::Stop => {
+                self.stopped = true;
+                self.paused = false;
+                Ok(ContinuityEffect::Stop)
+            }
+            LocalIntent::Pause => {
+                self.paused = true;
+                Ok(ContinuityEffect::Pause)
+            }
+            LocalIntent::Resume if self.stopped => Ok(ContinuityEffect::None),
+            LocalIntent::Resume => {
+                self.paused = false;
+                Ok(ContinuityEffect::Resume)
+            }
+            LocalIntent::Selected(id) => {
+                if !self.order.iter().any(|item| item == id) {
+                    return Err(LocalError::SourceNotFound);
+                }
+                self.current = Some(id.into());
+                self.position_ms = 0;
+                self.stopped = false;
+                self.paused = false;
+                Ok(ContinuityEffect::Selected)
+            }
+        }
+    }
+    pub fn checkpoint(
+        &mut self,
+        owner: OwnerToken,
+        id: &str,
+        position_ms: u64,
+    ) -> Result<(), LocalError> {
+        if owner != self.owner {
+            return Err(LocalError::RuntimeChanged);
+        }
+        if self.current.as_deref() != Some(id) {
+            return Err(LocalError::RuntimeChanged);
+        }
+        self.position_ms = position_ms;
+        Ok(())
+    }
+}
+fn shuffle(ids: &mut [String], state: u32) {
+    // JavaScript's default sort compares UTF-16 code units, including IDs with
+    // supplementary characters; Rust's scalar/UTF-8 order differs there.
+    ids.sort_by(|a, b| a.encode_utf16().cmp(b.encode_utf16()));
+    shuffle_order(ids, state);
+}
+
+/// Common caller-seeded Fisher-Yates order, without Local's string ordering.
+pub(super) fn shuffle_order<T>(ids: &mut [T], mut state: u32) {
+    for i in (1..ids.len()).rev() {
+        state ^= state.wrapping_shl(13);
+        state ^= state.wrapping_shr(17);
+        state ^= state.wrapping_shl(5);
+        // Exact integer form of floor((state / 2^32) * (i + 1)).
+        let at = ((u64::from(state) * (i as u64 + 1)) >> 32) as usize;
+        ids.swap(i, at);
+    }
+}
