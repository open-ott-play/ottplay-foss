+/// Return from external media to the current Plex profile without resetting any
+/// playback, audio or quality choice. The mirror includes picks whose writes are
+/// still queued, just as the full seat restore does. This does not persist values.
+pub fn restore_profile_subtitle_rows(record: &Session, seat: &Seat) {
+    PROFILE_PREFS.reseed(record);
+    let own = PROFILE_PREFS.own(seat);
+    let overrides = Overrides::default();
+    restore_row::<SubtitleSizePref>(&record.prefs, own.as_ref(), &overrides);
+    restore_row::<SubtitlePositionPref>(&record.prefs, own.as_ref(), &overrides);
+    restore_row::<SubtitleTonePref>(&record.prefs, own.as_ref(), &overrides);
+}
