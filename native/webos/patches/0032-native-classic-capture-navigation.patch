+class ClassicUiNavigation(unittest.TestCase):
+    """Driver-only regression using the observed old Remote route, not a renderer proof."""
+
+    def settings_rows(self):
+        # Derive this fixture's row allocation from the shipped declarations,
+        # including both adapters. Unsupported declaration changes fail closed.
+        from pathlib import Path
+        root = Path(REPO_ROOT)
+        app = root / "rust-modules/src/app"
+        runtime = (app / "ott_runtime.rs").read_text()
+        groups = (app / "ott_settings_groups.rs").read_text()
+        fields = (app / "ott_settings_group_fields.rs").read_text()
+        self.assertIn("settings_groups::view(self, self.raw_view())", runtime)
+        self.assertIn("rows.extend(companion_adapter::rows(self));", runtime)
+        self.assertIn("!group.fields().is_empty()", groups)
+        self.assertIn('row.id != "menu.items"', groups)
+        self.assertIn("group.fields().contains(&row.id.as_str())", groups)
+        all_groups = re.search(r"const ALL: \[Self; \d+\] = \[(.*?)\];", fields, re.S)
+        self.assertIsNotNone(all_groups)
+        names = re.findall(r"Self::(\w+)", all_groups[1])
+        declarations = fields.split("fn fields(self)", 1)[1].split("pub(super) fn candidate", 1)[0]
+        group_fields = dict((name, re.findall(r'"([^"\n]+)"', body)) for name, body in
+                            re.findall(r"Self::(\w+) => &\[(.*?)\],", declarations, re.S))
+        self.assertEqual(set(names), set(group_fields))
+        self.assertTrue(all(group_fields.values()))
+        grouped = {field for values in group_fields.values() for field in values}
+        sections = re.search(r"for section in \[(.*?)\] \{", groups, re.S)
+        self.assertIsNotNone(sections)
+        section_names = re.findall(r"Section::(\w+)", sections[1])
+        self.assertEqual(section_names, ["Profiles", "Parental", "Remote"])
+        prefixes = dict(re.findall(r'Section::(\w+) => id.starts_with\("([^"\n]+)"\)', groups))
+        self.assertEqual(set(prefixes), set(section_names))
+        raw = re.search(r'"settings" => \[(.*?)\]\s*\.into_iter\(\)', runtime, re.S)
+        self.assertIsNotNone(raw)
+        raw_ids = re.findall(r'\("([^"\n]+)", "[^"\n]+"\)', raw[1])
+        self.assertTrue(all(any(row.startswith(prefixes[name]) for row in raw_ids)
+                            for name in section_names))
+        rows = ["settings.open:" + name.lower() for name in names + section_names]
+        rows += [row for row in raw_ids if row not in grouped and row != "menu.items"
+                 and not row.startswith(tuple(prefixes.values()))]
+        companion = (app / "ott_companion_adapter.rs").read_text()
+        self.assertIn("result.extend(stremio::rows(runtime));", companion)
+        for source in (companion, (app / "ott_stremio_adapter.rs").read_text()):
+            arm = re.search(r'"settings" => vec!\[(.*?)\],', source, re.S)
+            self.assertIsNotNone(arm)
+            buttons = re.findall(r'button\("([^"\n]+)", "[^"\n]+"\)', arm[1])
+            self.assertTrue(buttons)
+            self.assertEqual(re.sub(r'button\("[^"\n]+", "[^"\n]+"\)|[\s,]', '', arm[1]), '')
+            rows.extend(buttons)
+        screen = (root / "rust-modules/screens/src/ott/mod.rs").read_text()
+        self.assertIn("let key = self.next_key;\n        self.next_key += 1;", screen)
+        self.assertIn('let id = format!("item:{}", row.id);\n            let key = self.row_key(&id);', screen)
+        mode = (app / "ott_interface_mode.rs").read_text()
+        self.assertIn("[UiMode::Classic, UiMode::Modern]", mode)
+        self.assertIn('selected_row: Some(format!("interface:{}", selected.index()))', mode)
+        return rows
+
+    def test_settings_allocation_includes_appended_adapter_rows(self):
+        rows = self.settings_rows()
+        self.assertEqual(rows, ["settings.open:" + name for name in (
+            "interface", "colors", "lists", "channels", "infobar", "buttons", "menu",
+            "profiles", "parental", "remote")] + [
+            "interfaceMode", "native.audio", "native.subtitles", "native.settings",
+            "torrent.settings", "stremio.settings"])
+        self.assertEqual(43 + rows.index("interfaceMode"), 53)
+        self.assertEqual(43 + len(rows), 59)
+
+    def drive(self, fault=None, complete=False):
+        import ott_classic_ui
+        classic = 43 + len(self.settings_rows())
+        modern, back = classic + 1, classic + 2
+        tail = iter(("back", "back", "ok", "down", "ok", "ck:811,1023", "ck:1066,865",
+                     "k:0,489", "k:57,38", "k:0,489", "k:49,30", "k:0,489", "k:50,31",
+                     "k:0,489", "k:57,38", "k:0,489", "k:49,30", "ck:811,1023",
+                     "ck:1100,505", "ok", "txt:Fixture+Channel+08", "down", "down", "ok",
+                     "back", "back", "back", "back", "back"))
+
+        class CapturedClassic(Exception):
+            pass
+
+        class Scenario(ott_classic_ui.Scenario):
+            def __init__(self):
+                self.receipt = {"inputs": []}
+                self.server = mock.Mock(url="http://127.0.0.1/fixture.m3u")
+                self.server.counts.return_value = {"/fixture.m3u": 1, "/fixture.xml": 1}
+                self.sim = mock.Mock(dir=ott_classic_ui.Path("unused-fixture-root"))
+                self.started = False
+                self.opening = iter(("back", "back", "ck:158,177", "ck:1120,606"))
+                self.elem = None
+                self.page = "catalog"
+                self.persisted = False
+                self.following = False
+                self.captures = []
+                self.writes = []
+                self.record = {"record_revision": 1, "record_sha256": "fixture",
+                               "value": {"category": "", "favorites_selected": False,
+                                         "favorites": {"entries": []}}}
+
+            def wait(self, predicate, label, timeout=15):
+                # The prefix's real import/FIFO IO is outside this driver unit test.
+                # All focus/picker/write predicates below run unchanged, without sleeping.
+                if label == "remote FIFO ready":
+                    return True
+                value = predicate()
+                if not value:
+                    raise TimeoutError(label)
+                return value
+
+            def saved(self):
+                return self.record
+
+            def saved_when(self, predicate, label, after=None):
+                if not self.following:
+                    return None
+                if not predicate(self.record["value"]) or (after is not None and self.record["record_revision"] <= after):
+                    raise TimeoutError(label)
+                self.writes.append(label)
+                return self.record
+
+            def capture(self, name):
+                self.captures.append(name)
+                if name == "modern-channel-list":
+                    self.started = True
+                if name == "classic-selected":
+                    if not complete:
+                        raise CapturedClassic
+                    self.following = True
+
+            def focus(self):
+                return f"focus route=ott elem={self.elem} press=0"
+
+            def mode(self):
+                return {"revision": 2} if self.persisted else None
+
+            def key(self, token):
+                self.receipt["inputs"].append(token)
+                if not self.started:
+                    return
+                if self.following:
+                    expected = next(tail, None)
+                    if token != expected:
+                        raise AssertionError((token, expected))
+                    if token == "ck:1066,865":
+                        self.record["value"]["favorites"]["entries"] = [
+                            {"locator": {"kind": "channel", "channelId": "m3u-epg:visual-01"}}]
+                        self.record["record_revision"] += 1
+                    if token in ("k:49,30", "k:50,31", "k:57,38"):
+                        self.record["value"]["category"] = ott_classic_ui.NINTH_CATEGORY if token == "k:57,38" else ""
+                        self.record["value"]["favorites_selected"] = token == "k:50,31"
+                        self.record["record_revision"] += 1
+                    if fault == "favorite-lost" and self.captures[-1] == "exit-prompt":
+                        self.record["value"]["favorites"]["entries"] = []
+                    return
+                opening = next(self.opening, None)
+                if opening is not None:
+                    if token != opening:
+                        raise AssertionError((token, opening))
+                    if token == "ck:1120,606":
+                        self.page, self.elem = "settings", 44 if fault == "root" else 43
+                    return
+                if token == "ck:1192,940":
+                    # Captured ffd trace: Settings Remote key 52 opens its Back key 59.
+                    self.page, self.elem = "remote", 59
+                elif self.page == "settings" and token == "down":
+                    if not (fault == "missed-down" and self.elem == 45):
+                        self.elem += 1
+                    if fault == "remote-row" and self.elem == 53:
+                        self.elem = 52
+                elif self.page == "settings" and token == "ok" and self.elem == 53:
+                    self.page, self.elem = "picker", back if fault == "wrong-picker" else modern
+                elif self.page == "picker" and token == "up":
+                    self.elem -= 1
+                elif self.page == "picker" and token == "ok" and self.elem == classic:
+                    self.persisted = fault != "write-refused"
+                elif self.page == "remote" and token == "up":
+                    self.elem = 1
+                elif self.page == "remote" and token == "ok":
+                    self.page, self.elem = "browse", 7
+                else:
+                    raise AssertionError((self.page, self.elem, token))
+
+        driver = Scenario()
+        try:
+            driver.run()
+        except CapturedClassic:
+            return driver, None
+        except TimeoutError as error:
+            return driver, str(error)
+        if complete:
+            self.assertIsNone(next(tail, None), "the complete driver route must be consumed")
+            return driver, None
+        self.fail("driver did not reach or reject Classic capture")
+
+    def test_current_settings_reaches_real_mode_write_gate(self):
+        driver, error = self.drive()
+        self.assertIsNone(error, "ordinary Classic mode write must follow the mode picker")
+        self.assertTrue(driver.persisted)
+        self.assertEqual(driver.receipt["classic_preference"], {"revision": 2})
+        self.assertEqual([row["focus"] for row in driver.receipt["navigation"]],
+                         [f"focus route=ott elem={n} press=0" for n in (*range(43, 54), 60, 59)])
+        self.assertNotIn("ck:1192,940", driver.receipt["inputs"])
+
+    def test_added_adapter_row_rejects_stale_picker_before_activation(self):
+        from pathlib import Path
+        read_text = Path.read_text
+        def changed(path, *args, **kwargs):
+            value = read_text(path, *args, **kwargs)
+            if path.name == "ott_companion_adapter.rs":
+                old = '"settings" => vec![button("torrent.settings", "Local torrent service")],'
+                self.assertEqual(value.count(old), 1)
+                value = value.replace(old, '"settings" => vec![button("torrent.settings", "Local torrent service"), button("extra.settings", "Extra")],')
+            return value
+        with mock.patch.object(Path, "read_text", changed):
+            driver, error = self.drive()
+        self.assertIn("Modern mode picker: expected focus route=ott elem=60 press=0", error)
+        self.assertEqual(driver.elem, 61)
+        self.assertEqual(driver.receipt["inputs"][-1], "ok")
+        self.assertFalse(driver.persisted)
+
+    def test_complete_route_keeps_category_writes_search_return_and_exit(self):
+        import ott_classic_ui
+        driver, error = self.drive(complete=True)
+        self.assertIsNone(error)
+        self.assertTrue(set(ott_classic_ui.REQUIRED + ott_classic_ui.SUPPLEMENTARY) <= set(driver.captures))
+        self.assertEqual(driver.captures[-1], "exit-cancel")
+        self.assertEqual(driver.writes, ["first channel favorite Saved acknowledgement",
+                         "ninth category setup", "category 1 Saved acknowledgement",
+                         "category 2 Saved acknowledgement", "category 9 Saved acknowledgement",
+                         "category 1 Saved acknowledgement"])
+        self.assertEqual(driver.receipt["final_favorite"],
+                         {"channelId": "m3u-epg:visual-01", "revision": 7, "sha256": "fixture"})
+
+    def test_complete_route_does_not_accept_a_lost_favorite(self):
+        with self.assertRaisesRegex(ValueError, "Favorites changed while navigating"):
+            self.drive("favorite-lost", complete=True)
+
+    def test_changed_root_stops_before_walking(self):
+        driver, error = self.drive("root")
+        self.assertIn("Settings row: expected focus route=ott elem=43 press=0", error)
+        self.assertEqual(driver.receipt["inputs"][-1], "ck:1120,606")
+
+    def test_missed_down_stops_before_another_row_is_activated(self):
+        driver, error = self.drive("missed-down")
+        self.assertIn("Settings row: expected focus route=ott elem=46 press=0", error)
+        self.assertEqual(driver.receipt["inputs"][-1], "down")
+        self.assertFalse(driver.persisted)
+
+    def test_remote_row_cannot_pass_mode_checkpoint(self):
+        driver, error = self.drive("remote-row")
+        self.assertIn("Settings row: expected focus route=ott elem=53 press=0", error)
+        self.assertEqual(driver.page, "settings")
+        self.assertEqual(driver.receipt["inputs"][-1], "down")
+        self.assertFalse(driver.persisted)
+
+    def test_wrong_picker_cannot_receive_classic_activation(self):
+        driver, error = self.drive("wrong-picker")
+        self.assertIn("Modern mode picker: expected focus route=ott elem=60 press=0", error)
+        self.assertEqual(driver.elem, 61)
+        self.assertFalse(driver.persisted)
+
+    def test_focus_does_not_substitute_for_durable_mode_write(self):
+        driver, error = self.drive("write-refused")
+        self.assertEqual(error, "ordinary Classic mode write")
+        self.assertNotIn("classic_preference", driver.receipt)
+
