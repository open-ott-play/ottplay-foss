+        assert_eq!(runtime.launch_resolver_from_app(&app), Err("Plex source is no longer available"), "{change}");
+        assert_eq!(runtime.rebind_native_admission(&app, &profile, &entry()), Err("Plex source is no longer available"), "{change}");
