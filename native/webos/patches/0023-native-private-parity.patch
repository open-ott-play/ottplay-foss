+fn ready() -> App {
+    let mut app = fixture();
+    let r = app.ott.as_mut().unwrap();
+    r.catalog_loading = false;
+    r.catalog_complete = true;
+    r.resolver_busy = false;
+    r.catalog_done.store(true, Ordering::Release);
+    r.metadata_done.store(true, Ordering::Release);
