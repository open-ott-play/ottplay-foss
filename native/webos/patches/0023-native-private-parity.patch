+    mounter: Mounter,
+    measure: TypographyMeasure<FixtureMeasure>,
+    mode: UiMode,
+    stores: plx_data::stores::Stores,
+    directory: plx_data::stores::browse::DirectorySnapshot,
+    preferences: Vec<registry::PreferenceCmd>,
+    privacy_actions: usize,
+    roots: usize,
+}
