+fn run_explicit_diagnostic() -> Option<c_int> {
+    #[cfg(all(feature = "devtriggers", target_os = "linux", target_arch = "arm", not(feature = "hostsim")))]
+    if crate::app::ui_snapshot::cold_launch() {
+        return None;
