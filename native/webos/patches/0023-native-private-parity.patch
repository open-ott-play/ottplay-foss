+            assert!(text.iter().any(|(text, _)| text.contains("Fixture movie")), "the actual Info paint path ran");
+            assert_eq!(fingerprint(&shown), before, "drawing cannot change canonical state");
+            assert_eq!(fingerprint(&shown), fingerprint(&skipped), "identical events must produce identical traces");
+        }
+    }
