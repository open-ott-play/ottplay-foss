+        let saved = serde_json::to_value(&r.saved).unwrap();
+        let old_path = RememberedFolders::read(&r.saved.settings)
+            .unwrap()
+            .folders()
+            .iter()
+            .find(|row| row.id == "root")
+            .unwrap()
+            .path
+            .clone();
+        let native = plx_media::route::play_request_ticket();
