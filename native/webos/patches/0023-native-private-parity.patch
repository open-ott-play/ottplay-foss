+    let mut runtime = app.ott.take().unwrap();
+    runtime.checkpoint_at(&app, true, Some(&receipt));
+    app.ott = Some(runtime);
+    assert!(automatic_resume_point(&app) == before, "foreign receipt cannot write the new checkpoint");
