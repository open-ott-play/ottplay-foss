+fn session_effect(effect: &plx_session::auth::owner::SessionFx) -> Result<Value, &'static str> {
+    use plx_session::auth::owner::{RegistryPlan, SessionFx, SessionOp};
+    let managed = match effect {
+        SessionFx::ManagedPublished { .. } | SessionFx::ManagedRefused { .. }
+            | SessionFx::ManagedAdmissionRefused { .. } => true,
+        SessionFx::Commit { plan, .. } => plan.registry.iter().any(|p| matches!(p, RegistryPlan::Managed { .. })),
+        SessionFx::Work { key, .. } => key.op == SessionOp::Managed,
+        SessionFx::PublishProfile(publication) => publication.profile.as_ref().is_some_and(|user|
+            user.account_scope == plx_plex::plex::session::AccountScope::PmsOnly),
+        _ => false,
+    };
+    if managed { return Err("unsupported controlled managed effect"); }
+    wire(effect)
+}
