+    runtime.saved.settings.remove(SETTINGS_KEY);
+    runtime.observe_m3u_attachments();
+    explicit_admitted(&mut runtime);
+    assert!(runtime.kiosk_capture.intent.is_none());
+    assert!(!runtime.saving);
+    assert!(runtime.rx.try_recv().is_err());
+}
