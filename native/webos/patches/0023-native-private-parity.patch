+#[test]
+fn error_eof_does_not_renew_the_automatic_failure_budget() {
+    let _serial = plx_base::testlock::serial();
+    let _reset = ResetMedia;
+    let mut app = terminal_fixture();
+    app.ott.as_mut().unwrap().catalog.entries.push(entry("third"));
