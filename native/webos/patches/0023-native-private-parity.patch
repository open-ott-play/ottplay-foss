+fn ready(id: &str) -> (CatalogEntry, ReadySource) {
+    (entry(id), ReadySource::External(
+        plx_media::ff::ExternalSource::Http("https://preplay.invalid/media?token=preplay-token".into()),
+        unsupported_info(), None))
