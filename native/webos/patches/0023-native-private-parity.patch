+fn session_command(command: &plx_session::auth::owner::Command) -> Result<Value, &'static str> {
+    if matches!(command, plx_session::auth::owner::Command::ActivateManaged(_)) {
+        return Err("unsupported controlled managed activation");
+    }
+    wire(command)
