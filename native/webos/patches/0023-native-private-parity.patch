+        json!({"limit":65}),
+    ] {
+        let mut app = fixture();
+        let mut request = json!({"version":1,"runtime":"browser-fixture","op":"roots"});
+        request
+            .as_object_mut()
+            .unwrap()
+            .extend(fields.as_object().unwrap().clone());
+        reject(&mut app, request, false, "invalid_request");
+    }
+}
+
+#[test]
