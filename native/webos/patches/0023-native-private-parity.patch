+/// Cold-start diagnostics are process-local, never a Saved preference. SAM supplies its
+/// caller's `params` inside `parameters`; `port::plx_launch_args` captures that envelope before
+/// boot. Warm SDL relaunch payloads deliberately do not pass through this latch.
+#[cfg(feature = "devtriggers")]
+static COLD_LAUNCH_FRAMEDROP: ColdLaunchFramedrop = ColdLaunchFramedrop::new();
+
+#[cfg(feature = "devtriggers")]
+struct ColdLaunchFramedrop(std::sync::atomic::AtomicU8);
+
+#[cfg(feature = "devtriggers")]
+impl ColdLaunchFramedrop {
+    const UNSEEN: u8 = 0;
+    const OFF: u8 = 1;
+    const ON: u8 = 2;
+    const CONSUMED: u8 = 3;
+
+    const fn new() -> Self {
+        Self(std::sync::atomic::AtomicU8::new(Self::UNSEEN))
+    }
+
+    fn capture(&self, raw: &str) {
+        let state = if launch_requests_framedrop(raw) { Self::ON } else { Self::OFF };
+        // First cold envelope wins, including explicit false/malformed input. Once boot has
+        // consumed the latch, no late or repeated call can change the running instrument.
+        let _ = self.0.compare_exchange(
+            Self::UNSEEN, state,
+            std::sync::atomic::Ordering::Relaxed,
+            std::sync::atomic::Ordering::Relaxed,
+        );
+    }
+
+    fn take(&self, file_trigger: Option<String>) -> Option<String> {
+        let requested = self.0.swap(Self::CONSUMED, std::sync::atomic::Ordering::Relaxed) == Self::ON;
+        // Preserve the existing file's threshold, but consume the launch request even when
+        // the file wins. An empty value selects boot's existing 22 ms default.
+        file_trigger.or_else(|| requested.then(String::new))
+    }
+}
+
+#[cfg(feature = "devtriggers")]
+fn launch_requests_framedrop(raw: &str) -> bool {
+    serde_json::from_str::<serde_json::Value>(raw).ok().and_then(|value| {
+        value.get("parameters")?.get("ottDiagnostics")?.get("frameDrop")?.as_bool()
+    }) == Some(true)
+}
+
+#[cfg(feature = "devtriggers")]
+pub(crate) fn capture_cold_launch_diagnostics(raw: &str) {
+    COLD_LAUNCH_FRAMEDROP.capture(raw);
+}
+
+#[cfg(feature = "devtriggers")]
+pub(crate) fn take_cold_launch_framedrop(file_trigger: Option<String>) -> Option<String> {
+    COLD_LAUNCH_FRAMEDROP.take(file_trigger)
+}
