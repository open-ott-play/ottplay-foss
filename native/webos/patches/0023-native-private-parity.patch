+#[path = "hls_rendition_tests.rs"]
+mod tests;
+
+#[cfg(test)]
+#[path = "hls_rendition_audio_timing_tests.rs"]
+mod audio_timing_tests;
+
+#[cfg(test)]
+#[path = "hls_rendition_adts_timing_tests.rs"]
+mod adts_timing_tests;
diff --git a/rust-modules/media/src/ff/hls_rendition_adts_timing_tests.rs b/rust-modules/media/src/ff/hls_rendition_adts_timing_tests.rs
new file mode 100644
