+/// Accepted application intent, not a decoder acknowledgement or pending-TX sample.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum ViewerTransport {
+    None,
+    Transport,
+    Seek,
+}
+impl ViewerTransport {
+    pub(crate) fn from_transport(accepted: bool) -> Self {
+        if accepted { Self::Transport } else { Self::None }
+    }
+    pub(crate) fn from_seek(accepted: bool) -> Self {
+        if accepted { Self::Seek } else { Self::None }
+    }
+    /// A later pause in the same drained batch must not hide an accepted seek.
+    pub(crate) fn merge(self, other: Self) -> Self {
+        match (self, other) {
+            (Self::Seek, _) | (_, Self::Seek) => Self::Seek,
+            (Self::Transport, _) | (_, Self::Transport) => Self::Transport,
+            _ => Self::None,
+        }
+    }
