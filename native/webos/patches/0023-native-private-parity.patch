+/// use the real shared stack and page constructors; no intermediate lifecycle is discarded.
+#[test]
+fn direct_picker_boot_commits_parents_once_and_nonpickers_stay_roots() {
+    let _guard = plx_base::testlock::serial();
+    let _session = seated_scratch_session("settings-boot-trail");
+    let cases = [
+        (Family::Settings, SettingsPage::Picker(PickerKind::Quality),
+            vec![SettingsPage::Root, SettingsPage::Playback, SettingsPage::Picker(PickerKind::Quality)]),
+        (Family::Settings, SettingsPage::Picker(PickerKind::DirectPlay),
+            vec![SettingsPage::Root, SettingsPage::Playback, SettingsPage::Picker(PickerKind::DirectPlay)]),
+        (Family::Settings, SettingsPage::Picker(PickerKind::AudioLanguage),
+            vec![SettingsPage::Root, SettingsPage::AudioSubtitles, SettingsPage::Picker(PickerKind::AudioLanguage)]),
+        (Family::Settings, SettingsPage::Picker(PickerKind::UiResolution),
+            vec![SettingsPage::Root, SettingsPage::Picker(PickerKind::UiResolution)]),
+        (Family::Settings, SettingsPage::Playback, vec![SettingsPage::Playback]),
+        (Family::FirstRunConsent, SettingsPage::ConsentStage(0), vec![SettingsPage::ConsentStage(0)]),
+    ];
+    for (kind, target, expected) in cases {
+        let mut surface = RouteSurface::new(EntryId(0), InstanceId(0), kind, target);
+        step(&mut surface, ScreenEvent::Mount, None);
+        assert_eq!(surface.inner.entries.iter().map(|e| e.arg).collect::<Vec<_>>(), expected,
+            "{target:?}: every boot parent must be retained in order");
+        assert!(surface.inner.entries.iter().all(|e| e.inst.is_some()),
+            "{target:?}: every retained page must run its mount lifecycle");
+        assert!(!surface.inner.is_pending(), "{target:?}: the entire boot trail must be committed");
+        let identities: Vec<_> = surface.inner.entries.iter()
+            .map(|e| (e.id, e.inst.as_ref().map(|i| i.id))).collect();
+        assert!(step(&mut surface, ScreenEvent::Mount, None).is_empty(),
+            "{target:?}: a repeated Mount must not emit a second boot lifecycle");
+        assert_eq!(surface.inner.entries.iter()
+            .map(|e| (e.id, e.inst.as_ref().map(|i| i.id))).collect::<Vec<_>>(), identities,
+            "{target:?}: a repeated Mount must preserve every entry and instance");
+    }
+}
