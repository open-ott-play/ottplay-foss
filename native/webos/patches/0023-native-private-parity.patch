+/// Current host renderer picture, before clipping, scaled from its canonical canvas.
+/// This reads accepted window state, not a requested mode or a physical-display readback.
+/// Other backends and unrepresentable scaling retain the established Fit geometry.
+/// An empty or negative output canvas has no picture and returns an empty rectangle.
+/// Authored subtitle quads may map into this rectangle; their rasterization size remains Fit.
+pub fn video_presentation(width: i32, height: i32) -> video_geometry::Viewport {
+    if width <= 0 || height <= 0 {
+        return video_geometry::Viewport::default();
+    }
+    #[cfg(feature = "hostsim")]
+    {
+        if let Some(picture) = sim_video::presentation_viewport() {
+            // Scale edges together so adjacent coordinates share the same integer rounding.
+            // The source extent and output dimension are i32; checked wide arithmetic also
+            // covers negative crop origins without converting them to unsigned coordinates.
+            let scale = |start: i32, length: i32, output: i32, canvas: i64| {
+                let end = i64::from(start).checked_add(i64::from(length))?;
+                let first = i64::from(start).checked_mul(i64::from(output))? / canvas;
+                let last = end.checked_mul(i64::from(output))? / canvas;
+                let start = i32::try_from(first).ok()?;
+                let length = i32::try_from(last.checked_sub(first)?).ok()?;
+                (length > 0 && start.checked_add(length).is_some()).then_some((start, length))
+            };
+            if let (Some((x, w)), Some((y, h))) = (
+                scale(picture.x, picture.width, width, 1920),
+                scale(picture.y, picture.height, height, 1080),
+            ) {
+                return video_geometry::Viewport { x, y, width: w, height: h };
+            }
+        }
+    }
+    video_viewport(width, height)
+}
