+    let catalogue = runtime.catalog.clone();
+    let generation = runtime.generation;
+    let play_generation = runtime.play_generation;
+    let cancel = runtime.cancel.clone();
+    assert!(runtime.view().order_context.is_some(), "parsed complete catalogue offers Actions");
+    {
+        let parts = app.pages.parts(Tick { ms: app.loop_t, dt_us: 16_000 });
+        let split = plx_ui::dispatch::Rig::<bridge::AppHost>::split(&mut app.bridge);
+        let cx = parts.cx::<bridge::AppHost>(split.views, split.measure);
+        let screen = &app.pages.nav.entry(origin_focus.entry).unwrap().inst.as_ref().unwrap().screen;
+        assert_eq!(screen.press_kind(&origin_focus.elem, &cx), Some(plx_ui::screen::ElemKind::Card),
+            "the saved FocusKey must be a catalogue row, not a footer control");
+    }
+    // Read the actual Yellow effect before replaying it unchanged through the
+    // ordinary application drain. This proves the screen names Origin rather
+    // than trusting Runtime.selected or inventing a ShowActionsAt target.
+    let tick = next_tick(&mut app);
+    let input = [Edge::Down, Edge::Up].into_iter().map(|edge| InputEvent {
+        at: tick, source: Source::RemoteFifo,
+        kind: InputKind::Key { key: Key::Other, sym: 0,
+            wcode: plx_ui::consts::WCODE_YELLOW, edge, at_edge: false },
+    }).collect();
+    bridge::frame(&mut app.pages, &mut app.bridge, tick, input);
+    let requests = app.bridge.take_ott_reqs();
+    let emitted_ids: Vec<_> = requests.iter().filter_map(|request| match request {
+        OttOut::Action { reply, action: OttAction::ShowActionsAt { id, .. } } if *reply == owner => Some(id.as_str()),
+        _ => None,
+    }).collect();
+    assert_eq!(emitted_ids, vec![origin.as_str()], "Yellow must capture the actual Origin row once");
+    for request in requests {
+        app.pages.emit(MachineId::Instance(owner), Fx::App(AppFx::Ott(request)));
+    }
+    let tick = next_tick(&mut app);
+    bridge::frame(&mut app.pages, &mut app.bridge, tick, Vec::new());
+    runtime_tick(&mut app);
+    settle_pages(&mut app);
+    let runtime = app.ott.as_ref().unwrap();
+    assert_eq!(runtime.page, "actions");
+    let screen = app.pages.nav.instance(owner).unwrap().screen.as_any().unwrap()
+        .downcast_ref::<plx_screens::ott::OttScreen>().unwrap();
+    assert!(screen.channel_number_context("actions", runtime.revision),
+        "the real Actions snapshot must be installed before opening Search");
+    let search = runtime.view().rows.into_iter()
+        .find(|row| row.id == "order.search" && row.enabled).expect("enabled Actions Search").action;
+    ui(&mut app, search);
+    assert_eq!(app.ott.as_ref().unwrap().page, "channels");
+    assert_eq!(app.ott.as_ref().unwrap().edit_session.as_ref().unwrap().owner, owner);
+    assert!(bridge::text_owns_input(&app.pages), "the actual screen editor is open");
+
+    // Submit through the actual editor so its pending owner accepts the Runtime
+    // ACK and commits the screen's search-return memory.
+    let tick = next_tick(&mut app);
+    let input = [TextEdit::Clear, TextEdit::Commit("Match".into())].into_iter()
+        .map(|edit| InputEvent { at: tick, source: Source::Script, kind: InputKind::Text(edit) }).collect();
+    bridge::frame(&mut app.pages, &mut app.bridge, tick, input);
+    settle_pages(&mut app);
+    press(&mut app, Key::Down);
+    press(&mut app, Key::Ok);
+    assert!(app.ott.as_ref().unwrap().edit_session.is_none());
+    assert!(!bridge::text_owns_input(&app.pages));
+    assert_eq!(ids(&app), [matching]);
+    assert_ne!(app.pages.focus(), Some(origin_focus), "the result is a different row");
+
+    // Without the pre-editor publication, its snapshot was still Actions:
+    // no catalogue origin was captured, and clearing keeps the matching row.
+    press(&mut app, Key::Back);
+    let runtime = app.ott.as_ref().unwrap();
+    assert_eq!(runtime.page, "channels");
+    assert!(runtime.view().search.unwrap().query.is_empty());
+    assert_eq!(app.pages.focus(), Some(origin_focus), "Back restores the pre-Actions catalogue row");
+    assert_eq!(app.pages.top_page(), Some(owner));
+    assert_eq!(runtime.catalog, catalogue);
+    assert_eq!(runtime.generation, generation);
+    assert_eq!(runtime.play_generation, play_generation);
+    assert!(Arc::ptr_eq(&runtime.cancel, &cancel));
+    assert!(runtime.play_target.is_none() && runtime.resolver_next.is_none() && runtime.catalog_next.is_none());
+    assert_eq!(saved(&app), before);
+    assert!(!plx_media::route::has_url(&app.player.session));
+}
+
+
+// Use the published picker action and existing revoked-writer seam. The injected
+// completion below covers settlement, not real protected-storage durability.
+fn stage_reselected_list(app: &mut App, favorites: bool) -> Saved {
+    ui(app, OttAction::ShowCategories);
+    let mut runtime = app.ott.take().unwrap();
+    runtime.entropy = Some([1; 16]);
+    runtime.plex_refresh_pending = true;
+    let choice = if favorites { "favorites" } else { "all" };
+    let action = runtime.view().rows.into_iter().find(|row| row.id == choice)
+        .expect("published category picker choice").action;
+    let candidate = runtime.category_choice_candidate(if favorites { None } else { Some("") })
+        .unwrap();
+    handle_action(&mut runtime, app, action).unwrap();
+    assert!(runtime.saving && runtime.pending_category_choice.is_some());
+    assert!(matches!(runtime.save_navigation, SaveNavigation::Preserve));
+    assert!(matches!(runtime.rx.recv_timeout(Duration::from_secs(1)).unwrap(),
+        Job::Saved(Err(_), None, false, _)));
+    app.ott = Some(runtime);
+    candidate
+}
+fn settle_reselected_list(app: &mut App, result: Result<Saved, &'static str>) {
+    app.ott.as_ref().unwrap().tx.send(Job::Saved(result, None, false, json!({"status":"ok"})))
+        .unwrap_or_else(|_| panic!("fixture receiver disappeared"));
+    runtime_tick(app);
+    settle_pages(app);
+}
+
+#[test]
+fn explicit_all_and_favorites_reselection_clear_search_only_after_success() {
+    let _serial = plx_base::testlock::serial();
+    for favorites in [false, true] {
+        let mut app = mounted();
+        {
+            let runtime = app.ott.as_mut().unwrap();
+            runtime.public_preferences.accept(None);
+            runtime.saved.settings.insert("interfaceMode".into(), json!(0));
+            if favorites {
+                runtime.saved.favorites.toggle(Favorite {
+                    title: "News".into(),
+                    origin: plx_data::ott::favorites::Origin { provider: "m3u".into(),
+                        profile: "Permanent".into(), subprofile: None, source_alias: "Fixture".into() },
+                    locator: plx_data::ott::favorites::Locator::Channel { channel_id: "one".into() },
+                }).unwrap();
+                runtime.saved.favorites_selected = true;
+                runtime.page = "favorites";
+            }
+            runtime.changed();
+        }
+        app.bridge.apply_ui_mode(plx_machine::machine::UiMode::Classic);
+        let all = ids(&app);
+        assert!(!all.is_empty());
+        query(&mut app, "no matching title");
+        assert!(ids(&app).is_empty());
+        let runtime = app.ott.as_ref().unwrap();
+        let catalog = runtime.catalog.clone();
+        let document = runtime.saved.favorites.clone();
+        let generation = runtime.generation;
+        let cancel = runtime.cancel.clone();
+        let candidate = stage_reselected_list(&mut app, favorites);
+        assert_eq!(app.ott.as_ref().unwrap().page, "categories");
+        settle_reselected_list(&mut app, Ok(candidate));
+        let runtime = app.ott.as_ref().unwrap();
+        assert_eq!(ids(&app), all, "explicitly reselecting the list must reveal its rows");
+        assert!(runtime.view().search.unwrap().query.is_empty());
+        assert_eq!(runtime.view_selection().1, favorites);
+        assert_eq!(runtime.saved.favorites, document);
+        assert_eq!(runtime.catalog, catalog);
+        assert_eq!(runtime.generation, generation);
+        assert!(Arc::ptr_eq(&runtime.cancel, &cancel));
+        assert!(runtime.catalog_next.is_none() && runtime.resolver_next.is_none()
+            && runtime.play_target.is_none() && !runtime.saving);
+        assert!(!plx_media::route::has_url(&app.player.session));
+    }
+}
+
+#[test]
+fn failed_or_stale_explicit_all_reselection_keeps_search() {
+    let _serial = plx_base::testlock::serial();
+    for stale in [false, true] {
+        let mut app = mounted();
+        query(&mut app, "no matching title");
+        let candidate = stage_reselected_list(&mut app, false);
+        if stale {
+            ui(&mut app, OttAction::ShowSettings);
+            settle_reselected_list(&mut app, Ok(candidate));
+            assert_eq!(app.ott.as_ref().unwrap().page, "settings");
+        } else {
+            settle_reselected_list(&mut app, Err("Fixture write refused"));
+        }
+        ui(&mut app, OttAction::ShowCatalog);
+        let runtime = app.ott.as_ref().unwrap();
+        assert_eq!(runtime.view().search.unwrap().query, "no matching title");
+        assert!(ids(&app).is_empty());
+        assert!(runtime.pending_category_choice.is_none());
+        assert!(runtime.play_target.is_none() && runtime.resolver_next.is_none()
+            && runtime.catalog_next.is_none());
+    }
+}
diff --git a/rust-modules/src/app/ott_runtime_tests/settings_schema_contract.rs b/rust-modules/src/app/ott_runtime_tests/settings_schema_contract.rs
new file mode 100644
index 00000000..e4363653
--- /dev/null
+++ b/rust-modules/src/app/ott_runtime_tests/settings_schema_contract.rs
@@ -0,0 +1,187 @@
+//! Receiver-contract regression through the real settings command, without IO.
+//! Vocabulary/bounds mirror Controller v1 (requests_player_settings.go and
+//! cli/player_settings.py). The exported default pages also let that unchanged
+//! receiver validate actual Native JSON instead of a hand-authored substitute.
+use super::*;
+use std::collections::BTreeSet;
+
+fn keys(value: &Value, required: &[&str], optional: &[&str]) -> bool {
+    value.as_object().is_some_and(|object| required.iter().all(|key| object.contains_key(*key))
+        && object.keys().all(|key| required.contains(&key.as_str()) || optional.contains(&key.as_str())))
+}
+
+fn text(value: &Value, maximum: usize) -> bool {
+    value.as_str().is_some_and(|value| value.len() <= maximum
+        && value.chars().all(|ch| ch >= ' ' && ch != '\u{7f}'))
+}
+
+fn token(value: &Value) -> bool {
+    value.as_str().is_some_and(|value| (1..=128).contains(&value.len())
+        && value.bytes().all(|b| b.is_ascii_alphanumeric() || b"_.:-".contains(&b)))
+}
+
+fn integer(value: &Value) -> bool {
+    value.as_i64().is_some_and(|value| (-9_007_199_254_740_991..=9_007_199_254_740_991).contains(&value))
+}
+
+fn typed(value: &Value, kind: &str) -> bool {
+    match kind {
+        "integer" => integer(value),
+        "string" => text(value, 4096),
+        "string_array" => value.as_array().is_some_and(|values| values.len() <= 64
+            && values.iter().all(|value| text(value, 4096))),
+        _ => false,
+    }
+}
+
+fn descriptor_valid(row: &Value) -> bool {
+    if !keys(row, &["id", "type", "scope", "sensitive", "access", "constraints", "apply"],
+        &["default_value", "choices", "description", "unit"])
+        || !row["id"].as_str().is_some_and(|id| (1..=64).contains(&id.len())
+            && id.as_bytes()[0].is_ascii_alphabetic()
+            && id.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_'))
+        || !matches!(row["type"].as_str(), Some("integer" | "string" | "string_array"))
+        || !matches!(row["scope"].as_str(), Some("application" | "provider"))
+        || !row["sensitive"].is_boolean()
+        || !matches!(row["apply"].as_str(), Some("immediate" | "next_stream" | "manual" | "after_ack")) {
+        return false;
+    }
+    let kind = row["type"].as_str().unwrap();
+    let access = &row["access"];
+    if !keys(access, &["read", "write"], &["reason"])
+        || !access["read"].is_boolean() || !access["write"].is_boolean()
+        || access.get("reason").is_some_and(|reason| !matches!(reason.as_str(), Some(
+            "invalid_request" | "atomic_patch_required" | "unknown_setting" | "invalid_value"
+            | "runtime_changed" | "source_changed" | "revision_conflict" | "policy_restricted"
+            | "local_only" | "unsupported" | "storage_failed" | "effect_failed"
+            | "device_forced_auto" | "lifecycle_required" | "local_action_required"))) {
+        return false;
+    }
+    let constraints = &row["constraints"];
+    if !keys(constraints, &[], &["minimum", "maximum", "values", "max_utf8_bytes", "max_items"]) {
+        return false;
+    }
+    for key in ["minimum", "maximum"] {
+        if constraints.get(key).is_some_and(|value| kind != "integer" || !integer(value)) {
+            return false;
+        }
+    }
+    if let (Some(minimum), Some(maximum)) = (constraints["minimum"].as_i64(), constraints["maximum"].as_i64()) {
+        if minimum > maximum { return false; }
+    }
+    for (key, maximum) in [("max_utf8_bytes", 4096), ("max_items", 64)] {
+        if constraints.get(key).is_some_and(|value| !value.as_u64().is_some_and(|n| n <= maximum)) {
+            return false;
+        }
+    }
+    if constraints.get("values").is_some_and(|values| !values.as_array().is_some_and(|values|
+        values.len() <= 256 && values.iter().all(|value| !value.is_array() && typed(value, kind))))
+        || row.get("default_value").is_some_and(|value| row["sensitive"] == true || !typed(value, kind))
+        || row.get("description").is_some_and(|value| !text(value, 512))
+        || row.get("unit").is_some_and(|value| !matches!(value.as_str(), Some("seconds" | "percent"))) {
+        return false;
+    }
+    if let Some(choices) = row.get("choices") {
+        let Some(choices) = choices.as_array().filter(|choices| choices.len() <= 256) else { return false; };
+        let mut seen = BTreeSet::new();
+        for choice in choices {
+            if !keys(choice, &["value", "label", "aliases"], &[])
+                || !typed(&choice["value"], kind) || !text(&choice["label"], 160) {
+                return false;
+            }
+            let Some(aliases) = choice["aliases"].as_array().filter(|aliases| aliases.len() <= 16) else { return false; };
+            for alias in aliases {
+                let Some(alias) = alias.as_str() else { return false; };
+                if !(1..=64).contains(&alias.len())
+                    || !alias.bytes().all(|b| b.is_ascii_alphanumeric() || b"_.+-".contains(&b))
+                    || !seen.insert(alias.to_ascii_lowercase()) {
+                    return false;
+                }
+            }
+        }
+    }
+    true
+}
+
+fn page_valid(data: &Value, request: &Value) -> bool {
+    let context = &data["context"];
+    let provider_valid = context["provider"].is_null() || context["provider"].as_str().is_some_and(|id|
+        (1..=32).contains(&id.len()) && (id.as_bytes()[0].is_ascii_lowercase() || id.as_bytes()[0].is_ascii_digit())
+        && id.bytes().all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b"_./-".contains(&b))
+        && !id.contains("..") && !id.contains("//") && !id.ends_with('/'));
+    if !keys(data, &["version", "op", "runtime", "context", "settings", "next_cursor"], &[])
+        || data["version"].as_u64() != Some(1) || data["op"] != "schema" || data["runtime"] != request["runtime"]
+        || serde_json::to_vec(data).unwrap().len() > 65_536
+        || !keys(context, &["token", "provider", "profile"], &[]) || !token(&context["token"]) || !provider_valid
+        || !(context["profile"].is_null() || context["profile"].as_u64().is_some_and(|n| (1..=15).contains(&n))) {
+        return false;
+    }
+    let Some(rows) = data["settings"].as_array() else { return false; };
+    let mut ids = BTreeSet::new();
+    rows.len() <= request["limit"].as_u64().unwrap_or(20) as usize
+        && rows.iter().all(|row| descriptor_valid(row) && ids.insert(row["id"].as_str().unwrap()))
+        && (data["next_cursor"].is_null() || (!rows.is_empty() && token(&data["next_cursor"])))
+}
+
+#[test]
+fn every_schema_page_obeys_controller_v1() {
+    let _serial = plx_base::testlock::serial();
+    let mut app = Box::new(ready_app_fixture());
+    let mut runtime = app.ott.take().unwrap();
+    let mut failures = BTreeSet::new();
+    let mut expected = Vec::new();
+    // Default pagination plus every accepted explicit page size. No providers,
+    // protected state, sockets, rendering, or media workers are started here.
+    for requested_limit in std::iter::once(None).chain((1..=20).map(Some)) {
+        let mut request = json!({"op":"schema","runtime":"fixture"});
+        if let Some(limit) = requested_limit { request["limit"] = json!(limit); }
+        let mut rows = Vec::new();
+        let mut context = None;
+        let mut cursors = BTreeSet::new();
+        let mut complete = false;
+        for _ in 0..40 {
+            // request_for_test uses one fixed request ID; each independent
+            // command probe gets a fresh receiver, retaining the runtime token.
+            let mut remote = Remote::disabled_for_test("dev_fixture", "fixture");
+            let mut invocation = remote.request_for_test("player_settings", request.clone());
+            invocation.deadline_ms = runtime.now_ms().saturating_add(10_000);
+            let response = commands::command(&mut runtime, &mut app, &invocation).expect("synchronous schema response");
+            assert_eq!(response["status"], "ok", "{response}");
+            // Round-trip the actual response before checking the receiving wire contract.
+            let data: Value = serde_json::from_slice(&serde_json::to_vec(&response["data"]).unwrap()).unwrap();
+            if requested_limit.is_none() {
+                println!("SETTINGS_SCHEMA_V1 {}", json!({"request":request,"data":data}));
+            }
+            if !page_valid(&data, &request) { failures.insert(format!("page limit {requested_limit:?}")); }
+            let page = data["settings"].as_array().expect("schema array");
+            assert!(!page.is_empty());
+            for row in page {
+                if !descriptor_valid(row) { failures.insert(row["id"].as_str().unwrap_or("invalid id").to_owned()); }
+            }
+            rows.extend(page.iter().cloned());
+            if let Some(previous) = &context { assert_eq!(previous, &data["context"]); }
+            context = Some(data["context"].clone());
+            if data["next_cursor"].is_null() { complete = true; break; }
+            let cursor = data["next_cursor"].as_str().unwrap();
+            assert!(cursors.insert(cursor.to_owned()), "repeated cursor");
+            request["cursor"] = json!(cursor);
+        }
+        assert!(complete, "schema pagination must terminate");
+        assert_eq!(rows.len(), 40, "every registered descriptor must be reachable");
+        assert_eq!(rows.iter().map(|row| row["id"].as_str().unwrap()).collect::<BTreeSet<_>>().len(), rows.len());
+        if requested_limit.is_none() { expected = rows; } else { assert_eq!(rows, expected); }
+    }
+    // Exercise the regression oracle itself using valid published metadata.
+    let player = expected.iter().find(|row| row["id"] == "players").unwrap();
+    assert!(descriptor_valid(player));
+    let mut missing_aliases = player.clone();
+    missing_aliases["choices"][0].as_object_mut().unwrap().remove("aliases");
+    assert!(!descriptor_valid(&missing_aliases));
+    let mut duplicate_alias = player.clone();
+    duplicate_alias["choices"][0]["aliases"] = json!(["native", "NATIVE"]);
+    assert!(!descriptor_valid(&duplicate_alias));
+    let mut invalid_unit = player.clone();
+    invalid_unit["unit"] = json!("rows");
+    assert!(!descriptor_valid(&invalid_unit));
+    assert!(failures.is_empty(), "Controller v1 rejects emitted schema metadata: {failures:?}");
+}
