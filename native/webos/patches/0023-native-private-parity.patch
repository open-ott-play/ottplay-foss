+                let all_bars = painted.iter().filter(|(tag, r, _)| *tag == 2 && r.w == expected.w && r.h == expected.h).count();
+                assert!(all_bars <= 2 * 26, "only visible rows may paint progress");
+            }
+        }
+    }
