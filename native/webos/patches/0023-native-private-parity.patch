+fn batch(app: &mut App, ids: &[&str], finished: bool) {
+    let runtime = app.ott.as_ref().unwrap();
+    runtime
+        .catalog_tx
+        .send(CatalogEvent::Batch(
+            runtime.generation,
+            Catalog {
+                entries: ids.iter().map(|id| row(id)).collect(),
+                hierarchy: None,
+            },
+        ))
+        .unwrap();
+    if finished {
+        runtime
+            .catalog_tx
+            .send(CatalogEvent::Finished(runtime.generation, Ok(())))
+            .unwrap();
+    }
+    runtime_tick(app);
+    settle_pages(app);
+}
