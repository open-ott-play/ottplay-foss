+fn private_editor_visible(app: &App) -> bool {
+    app.pages.nav.top_page().unwrap().inst.as_ref().unwrap().screen
+        .as_any().unwrap().downcast_ref::<plx_screens::ott::OttScreen>()
+        .unwrap().handles_private_text()
