+            home_users: vec![
+                HomeUserRef { id: 7, uuid: "owner-7".into(), admin: true, ..Default::default() },
+                HomeUserRef { id: 12, uuid: "home-12".into(), ..Default::default() },
+            ], ..Default::default()
+        });
