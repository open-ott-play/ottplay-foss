+    assert!(matches!(mailbox().unwrap().0, Request::Indexer(IndexerRequest::Capabilities { id }) if id == "films"));
+    let mut adapter = runtime.companion_adapter.take().unwrap();
+    let pending = adapter.pending.remove(0);
