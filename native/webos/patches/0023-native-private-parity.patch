+/// Map an authored subtitle region from its bounded render canvas onto the actual picture.
+/// The output may extend beyond the screen; callers retain the full quad and clip its draw,
+/// preserving texture coordinates. Never use this destination size to rasterize libass.
+pub fn subtitle_picture_rect(r: Rect, canvas: (i32, i32),
+    picture: plx_media::player::video_geometry::Viewport) -> Rect {
+    if canvas.0 <= 0 || canvas.1 <= 0 || picture.width <= 0 || picture.height <= 0 {
+        return r;
+    }
