+
+    #[test]
+    fn managed_registry_operation_is_refused_without_the_app_proof_adapter() {
+        assert!(!crate::auth::execute_session_registry(&RegistryPlan::Managed { operation: 17 }, "synthetic-client"));
+    }
+}
