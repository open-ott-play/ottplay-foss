+fn stage_playing_favorite(runtime: &mut Runtime, app: &mut App) -> Saved {
+    let (candidate, _, added) = playing_favorite::candidate(runtime, runtime.playing.as_ref().unwrap()).unwrap();
+    assert!(added);
