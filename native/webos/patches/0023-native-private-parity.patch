+    assert!(Query::Records { start: now - 365 * 86400 - 1, end: now }.validate().is_err());
+    assert!(Query::Records { start: -1, end: now }.validate().is_err());
+    assert!(Query::Records { start: now, end: now }.validate().is_err());
