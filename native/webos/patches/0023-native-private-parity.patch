+//! Shared display-only resolution of raw OTT application labels and diagnostics.
+//! User values and source identities are never rewritten by these functions.
+use plx_platform::i18n::{self, msg, LocaleContext};
+
+pub fn text(source: &str) -> &str { text_in(source, i18n::current()) }
+
+/// Localized copy for an addressed setting; raw runtime and wire strings stay unchanged.
+pub fn setting_text<'a>(key: &str, source: &'a str) -> &'a str {
+    setting_text_in(key, source, i18n::current())
+}
+
+pub fn setting_text_in<'a>(key: &str, source: &'a str, cx: &LocaleContext) -> &'a str {
+    match (key, source) {
+        ("profile.media", "Media library link") => msg::ott_m3u_media_link_in(cx),
+        ("uiFontScale", "Interface text scale (%)") => msg::ott_settings_font_scale_in(cx),
+        ("uiFontScale", "Interface text scale (20–200%)") => msg::ott_settings_font_scale_prompt_in(cx),
+        ("uiFontScale", "Enter an integer from 20 to 200") => msg::ott_settings_font_scale_invalid_in(cx),
+        ("parental.unlock", "Unlock parental access") => msg::ott_settings_parental_unlock_in(cx),
+        ("parental.create", "Set parental PIN") => msg::ott_settings_parental_create_in(cx),
+        ("parental.disable", "Disable parental PIN") => msg::ott_settings_parental_disable_in(cx),
+        ("parental.channels", "Toggle channel protection") => msg::ott_settings_parental_channels_in(cx),
+        ("parental.settings", "Toggle settings protection") => msg::ott_settings_parental_settings_in(cx),
+        ("parental.providers", "Toggle provider selection protection") => msg::ott_settings_parental_providers_in(cx),
+        ("volumeStep", "Volume step (%)") => msg::ott_volume_step_in(cx),
+        ("volumeStep", "Volume step (3–10%)") => msg::ott_volume_step_prompt_in(cx),
+        ("volumeStep", "Enter an integer from 3 to 10") => msg::ott_volume_step_invalid_in(cx),
+        ("infoTimeout", "Information display time (seconds)") => msg::ott_info_timeout_in(cx),
+        ("infoTimeout", "Information display time (3–20 seconds)") => msg::ott_info_timeout_prompt_in(cx),
+        ("infoTimeout", "Enter an integer from 3 to 20") => msg::ott_info_timeout_invalid_in(cx),
+        _ => text_in(source, cx),
+    }
+}
+
+pub fn text_in<'a>(source: &'a str, cx: &LocaleContext) -> &'a str {
+    match source {
+        "M3U media settings changed; reopen the editor" => msg::ott_m3u_media_changed_in(cx),
+        "Invalid attached VPortal link" => msg::ott_m3u_media_invalid_in(cx),
+        "Records are unavailable for this channel" | "Records are unavailable for this item" => msg::ott_records_unavailable_in(cx),
+        "Records response is incomplete or unavailable" => msg::ott_records_incomplete_in(cx),
+        "Records use the complete archive window" => msg::ott_records_window_in(cx),
+        "Records are ordered by title" => msg::ott_records_order_in(cx),
+        "Find command server" => msg::ott_remote_find_in(cx),
+        "Discovery is not configured. Enter a server address." => msg::ott_remote_unconfigured_in(cx),
+        "Discovery configuration is invalid. Enter a server address." => msg::ott_remote_invalid_profile_in(cx),
+        "Finding command servers…" => msg::ott_remote_finding_in(cx),
+        "Select a command server" => msg::ott_remote_choose_in(cx),
+        "No servers found. Try again or enter an address." => msg::ott_remote_empty_in(cx),
+        "Discovery failed. Try again or enter an address." => msg::ott_remote_failed_in(cx),
+        "Server choices changed. Find servers again." => msg::ott_remote_choice_expired_in(cx),
+        "Reopen the guide list to change its order" => msg::ott_guide_order_reopen_in(cx),
+        "USB selection changed; close this picker" => msg::ott_usb_browser_changed_in(cx),
+        "USB folders" => msg::ott_usb_browser_title_in(cx),
+        "Use this folder" => msg::ott_usb_browser_use_in(cx),
+        "Parent folder" => msg::ott_usb_browser_parent_in(cx),
+        "Drive root" => msg::ott_usb_browser_root_in(cx),
+        "Previous page" => msg::ott_usb_browser_previous_in(cx),
+        "Next page" => msg::ott_usb_browser_next_in(cx),
+        "Load more" => msg::ott_usb_browser_more_in(cx),
+        "Browse drive root" => msg::ott_usb_browser_browse_root_in(cx),
+        "Choose a folder on this USB drive" => msg::ott_usb_browser_choose_in(cx),
+        "Reading folders…" => msg::ott_usb_browser_reading_in(cx),
+        "Folder loading cancelled" => msg::ott_usb_browser_cancelled_in(cx),
