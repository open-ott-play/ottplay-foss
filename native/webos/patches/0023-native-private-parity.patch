+    open_records(&mut app, &mut runtime);
+    let old = response(&runtime, vec![programme("Old", NOW - 600, NOW - 300, "Old")]);
+    let generation = runtime.metadata_generation;
+    for action in [OttAction::GuideDay { generation, day_start_s: NOW },
