+    SHARED.reset_session();
+    let epoch = SHARED.begin_native_session().expect("native session");
+    let mut state = AvioState {
+        src: Src::Idle,
+        aq: std::ptr::null_mut(),
+        off: 0,
+        size: 0,
+        io_failed: false,
+        body_active_us: 0,
