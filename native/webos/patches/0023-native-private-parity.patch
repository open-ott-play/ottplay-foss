+/// Exercise the production HLS terminal reducer, including its pre/post-output split.
+#[test]
+fn hls_terminal_context_preserves_failure_flags_and_closed_classes() {
+    let _serial = plx_base::testlock::serial();
+    struct Reset;
+    impl Drop for Reset {
+        fn drop(&mut self) {
+            SHARED.reset_session();
+            PUSHED_ANY.store(false, Ordering::Relaxed);
+        }
+    }
+    let _reset = Reset;
+    let transfer = SegmentTransfer { bytes: 0, active_us: 0, total_us: 1, audio_expected: true };
+    for pushed in [false, true] {
+        for (result, exit, detail, io_failed) in [
+            (Ok(()), DemuxExitClass::None, None, false),
+            (Err(HlsExit::Aborted), DemuxExitClass::None, None, false),
+            (Err(HlsExit::Failed("segment body transport failed")),
+                if pushed { DemuxExitClass::None } else { DemuxExitClass::HlsTransportFailed },
+                pushed.then_some(IoFailureDetails::Hls { exit: DemuxExitClass::HlsTransportFailed, outcome: None }), pushed),
+            (Err(HlsExit::Failed("private unknown failure")),
+                if pushed { DemuxExitClass::None } else { DemuxExitClass::HlsFailed },
+                pushed.then_some(IoFailureDetails::Hls { exit: DemuxExitClass::HlsFailed, outcome: None }), pushed),
+            (Err(HlsExit::NotReady),
+                if pushed { DemuxExitClass::None } else { DemuxExitClass::HlsNotReady },
+                pushed.then_some(IoFailureDetails::Hls { exit: DemuxExitClass::HlsNotReady, outcome: None }), pushed),
+            (Err(HlsExit::PrimeExpired), DemuxExitClass::None,
+                Some(IoFailureDetails::Hls { exit: DemuxExitClass::Other, outcome: Some(TraceOutcome::Deadline) }), true),
+            (Err(HlsExit::StallAbort(transfer)), DemuxExitClass::None,
+                Some(IoFailureDetails::Hls { exit: DemuxExitClass::Other, outcome: None }), true),
+        ] {
+            SHARED.reset_session();
+            let epoch = SHARED.begin_native_session().expect("native session");
+            PUSHED_ANY.store(pushed, Ordering::Relaxed);
+            settle_hls_demux(epoch, Ok(result));
+            assert_eq!(SHARED.io_failure(), detail, "pushed={pushed}, result={result:?}");
+            assert_eq!(SHARED.demux_io_failed.load(Ordering::Acquire), io_failed);
+            assert_eq!(SHARED.dg_demux_exit.load(Ordering::Acquire), exit.latch());
+            assert_eq!(SHARED.demux_failed.load(Ordering::Acquire), exit != DemuxExitClass::None);
+        }
+    }
+    SHARED.reset_session();
+    let epoch = SHARED.begin_native_session().expect("native session");
+    settle_hls_demux(epoch, Err(Box::new("synthetic panic")));
+    assert_eq!(SHARED.io_failure(), None, "a panic retains its existing demux cause");
