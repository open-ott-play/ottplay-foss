+        (Some("A"), "A", "VPortal catalogue contains conflicting rows"),
+    ] {
+        let mut calls = 0;
+        let found = standalone_lookup(wanted, &AtomicBool::new(false), &mut |_, body, _| {
+            calls += 1;
+            Ok(response(body, second))
+        });
