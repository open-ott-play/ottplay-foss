+#[test]
+fn graph_and_derived_membership_share_the_catalog_byte_budget() {
+    let sample = parse(root(vec![folder("a", "A", vec![leaf("one")])]));
+    let mut graph = CategoryHierarchy::default();
+    for index in 0..128 {
