+    assert!(app.bridge.metadata_run(plx_data::stores::metadata::MetadataCmd::InstallPlaying(Some(other))));
+    assert_ne!(list(&mut app)["status"], "ok");
+    assert_eq!(track_capability(&mut app, 83), Value::Null);
