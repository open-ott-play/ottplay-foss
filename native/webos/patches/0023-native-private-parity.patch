+/// Authored signs stay attached to the picture. Generated text keeps its existing screen
+/// position and HUD lift, even when the underlying video is filled or zoomed.
+fn region_destination(origin: ass::Origin, raster: Viewport, picture: Viewport,
+    region: Rect, dy: f32) -> Rect {
+    if origin.is_text() {
+        Rect::new(raster.x as f32 + region.x, raster.y as f32 + region.y + dy, region.w, region.h)
+    } else {
+        plx_appkit::player_hud::subtitle_picture_rect(region, (raster.width, raster.height), picture)
+    }
+}
