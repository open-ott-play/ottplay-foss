+    fn recording_and_both_replay_guards_emit_no_live_clock_message() {
+        let sample = plx_appkit::info_panel::InfoPresentation::default();
+        for (recorder_off, controlled_replay) in [(false, false), (false, true), (true, true)] {
+            assert!(info_presentation_delivery(recorder_off, controlled_replay, InstanceId(7), sample).is_none());
+        }
+    }
+
+    #[test]
+    fn live_sample_is_addressed_to_the_exact_overlay_instance() {
+        let sample = plx_appkit::info_panel::InfoPresentation {
+            opacity: Default::default(), wall_now_s: Some(220),
+        };
+        match info_presentation_delivery(true, false, InstanceId(17), sample) {
+            Some(Fx::Deliver(MachineId::Instance(InstanceId(17)), Delivery::Screen(
+                ScreenEvent::App(AppMsg::PlayerInfoPresentation(actual))))) => assert_eq!(actual, sample),
+            _ => panic!("expected an exact-instance presentation delivery"),
+        }
+    }
 }
 
