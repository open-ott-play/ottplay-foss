+        let text = std::str::from_utf8(bytes).unwrap();
+        assert!(text.contains("0:00:00.50,0:00:01.50"), "PES clock must map into presentation time");
+        assert!(text.contains("Selected {\\b1}WebVTT{\\b0} caption"));
