+/// One current publication and its permitted account credential. The persisted
+/// Session supplies readiness/client id and comparison evidence for the legacy
+/// fallback; only the profile credential resolver can supply a job's token.
+pub(crate) fn person_input() -> PersonInput {
+    if plx_data::stores::tape::active() { return PersonInput::controlled(); }
+    person_live_input()
+}
+
+/// Capture without consulting the pump thread's tape state. A worker uses this
+/// only for a job that already carries a live account identity.
+fn person_live_input() -> PersonInput {
+    let profile = plx_plex::plex::session::current_snapshot();
+    let session = plx_plex::plex::session::peek_settled();
+    let credential = session.as_ref().and_then(|settled| {
+        let user = profile.user.as_ref()?;
+        let explicit = user.plex_tv_token.as_ref().is_some_and(|token| !token.trim().is_empty());
+        if !explicit && profile.stamp != plx_plex::plex::grant::account_key(&settled.account_token) {
+            return None;
+        }
+        let credential = plx_plex::plex::session::plex_tv_credential(user)?;
+        if !explicit && credential != settled.account_token { return None; }
+        Some(credential)
+    });
+    let client_id = session.as_ref().map(|s| s.client_id.as_str());
+    let captured = PersonInput::live(profile, client_id, credential.clone());
+    let after_session = plx_plex::plex::session::peek_settled();
+    let after_profile = plx_plex::plex::session::current_snapshot();
+    let stable_session = match (&session, &after_session) {
+        (Some(before), Some(after)) => std::sync::Arc::ptr_eq(before, after),
+        (None, None) => true,
+        _ => false,
+    };
+    let confirmed = PersonInput::live(after_profile.clone(), client_id, credential);
+    if stable_session && captured == confirmed { captured }
+    else { PersonInput::live(after_profile, None, None) }
+}
+
+fn person_worker_input(req: &PersonReq) -> PersonInput {
+    if req.needs_account_input() { person_live_input() }
+    else { PersonInput::controlled() }
+}
