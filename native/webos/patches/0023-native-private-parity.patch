+            "network" => plex::grant::network_changed(),
+            "identity" => plex::grant::identity_changed(),
+            "owner" => { bridge::execute_session_command(&mut app.pages, SessionCmd::StartLogin); settle(&mut app); }
+            _ => unreachable!(),
+        }
