+    Some(Fx::Deliver(MachineId::Instance(recipient), Delivery::Screen(
+        plx_ui::screen::ScreenEvent::App(plx_screens::registry::AppMsg::PlayerInfoPresentation(sample)))))
+}
+
+fn publish_info_presentation(app: &mut App) {
+    use plx_machine::machine::{InputOwner, MachineId, UiMode};
+    if app.bridge.ui_mode() != UiMode::Classic { return; }
+    let Some(InputOwner::Entry(entry_id)) = app.pages.nav.input_owner() else { return; };
+    let Some(entry) = app.pages.nav.entry(entry_id) else { return; };
+    if !matches!(&entry.arg, AppArg::PlayerOverlay(arg)
+        if arg.kind == plx_screens::player::overlay::OverlayKind::Info) { return; }
+    let Some(recipient) = entry.inst.as_ref().map(|instance| instance.id) else { return; };
+    let sample = plx_appkit::info_panel::InfoPresentation {
+        opacity: app.ott.as_ref().map(super::ott_runtime::Runtime::osd_preferences)
+            .unwrap_or_default().0,
+        wall_now_s: app.ott.as_ref().and_then(super::ott_runtime::Runtime::wall_now_s),
+    };
+    let Some(effect) = info_presentation_delivery(
+        matches!(&app.rec, super::recorder::Recplay::Off), app.bridge.is_controlled_replay(), recipient, sample,
+    ) else { return; };
+    if super::bridge::player_overlay_mut(&mut app.pages)
+        .is_some_and(|overlay| overlay.needs_info_presentation(sample)) {
+        app.pages.emit(MachineId::Nav, effect);
+    }
+}
+
