+
+#[test]
+fn raw_audio_capture_remains_bounded_before_pts_recovery() {
+    let mut capture = Capture::new(Lane::Audio, None);
+    for _ in 0..SAMPLE_LIMIT { capture.push_audio(packet(None, None, Some(1_920))).unwrap(); }
