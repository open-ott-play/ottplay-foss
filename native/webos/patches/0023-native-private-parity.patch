+    assert!(frame_read_failed(&mut state, -5, epoch));
+    assert_eq!(SHARED.io_failure(), None, "a non-IO read error is not source IO");
+    assert!(!SHARED.demux_io_failed.load(Ordering::Acquire));
+
+    state.io_failed = true;
+    assert!(!frame_read_failed(&mut state, 0, epoch));
+    assert_eq!(SHARED.io_failure(), None, "a recovered packet is not fatal");
+    assert!(!SHARED.demux_io_failed.load(Ordering::Acquire));
+    assert!(frame_read_failed(&mut state, -5, epoch));
+    assert_eq!(SHARED.io_failure(), Some(IoFailureDetails::source_io(0, false)),
+        "source IO without curl detail is observed, not absent");
+    assert!(SHARED.demux_io_failed.load(Ordering::Acquire));
+
+    SHARED.reset_session();
+    let replacement = SHARED.begin_native_session().expect("replacement session");
+    assert_ne!(epoch, replacement);
+    assert!(frame_read_failed(&mut state, -5, epoch));
+    assert_eq!(SHARED.io_failure(), None, "an old producer cannot attribute the replacement");
+    assert!(SHARED.demux_io_failed.load(Ordering::Acquire), "legacy flag behavior is unchanged");
+    assert!(frame_read_failed(&mut state, -5, replacement));
+    assert_eq!(SHARED.io_failure(), Some(IoFailureDetails::source_io(0, false)));
