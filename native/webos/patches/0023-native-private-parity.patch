+        let off = plx_base::task::OffFrame::for_test();
+        let prepared = request.prepare(&off, Arc::new(AtomicBool::new(false))).unwrap();
+        assert_eq!(route::hls_track_catalog(&ps).unwrap().selected_subtitle(), None,
