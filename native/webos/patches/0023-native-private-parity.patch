+}
+fn settle(app: &mut App) {
+    for _ in 0..24 {
+        app.loop_t = app.loop_t.wrapping_add(16);
+        let tick = plx_machine::machine::Tick { ms: app.loop_t, dt_us: 16_000 };
+        bridge::frame(&mut app.pages, &mut app.bridge, tick, Vec::new());
