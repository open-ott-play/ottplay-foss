+            "Fixture", "M3U", plx_platform::devcaps::assumed_shared()).unwrap();
+        route::reset_player_control_for_test(&ps);
+        let catalog = route::hls_track_catalog(&ps).unwrap();
+        let rows = catalog.subtitle_rows();
