+struct NativeCatalogRegistry;
+impl Drop for NativeCatalogRegistry {
+    fn drop(&mut self) {
+        plx_plex::plex::reset_servers_for_test();
+        plx_plex::plex::grant::reset_for_test();
+    }
+}
