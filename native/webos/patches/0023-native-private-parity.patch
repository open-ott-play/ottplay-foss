+#[test]
+fn fractional_nanosecond_audio_ticks_never_round_through_another_clock() {
+    let mut raw = [packet(None, None, Some(1_024)),
+        packet(Some(1_234_567), Some(1_234_560), Some(1_024)),
+        packet(None, None, Some(1_024))];
