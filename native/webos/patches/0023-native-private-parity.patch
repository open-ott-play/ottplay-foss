+    };
+    let (v, a, data) = play(english, 0);
+    assert_eq!(v[0], 0); assert_eq!(a[0], 0);
+    assert!((180.0..260.0).contains(&tone("joined-en.aac", data)));
+    let (_, _, data) = play(spanish.clone(), 0);
+    assert!((800.0..960.0).contains(&tone("joined-es.aac", data)));
