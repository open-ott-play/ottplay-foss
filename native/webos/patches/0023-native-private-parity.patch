+        runtime.state_load = StateLoad::Failed("protected storage unavailable");
+        runtime.public_preferences.accept(None);
+        assert!(public_preferences::write_refusal(&runtime).is_none());
+        runtime.saved.favorites_selected = true;
+        assert_eq!(category_patch(&runtime, &category).unwrap(), None);
+        let candidate = runtime.category_choice_candidate(Some(&category)).unwrap();
+        assert!(!candidate.favorites_selected && runtime.saved.favorites_selected);
+        assert_eq!(runtime.save_category_choice(Some(category)), Err("protected storage unavailable"));
+        assert!(runtime.saved.favorites_selected);
+        runtime.saved.favorites_selected = false;
+        assert_eq!(runtime.save_category_choice(None), Err("protected storage unavailable"));
+        assert!(!runtime.saved.favorites_selected);
+        assert!(runtime.pending_category_choice.is_none() && take_write(&mut runtime).is_none());
+        assert!(!runtime.saving);
+    }
+
+}
diff --git a/rust-modules/src/app/ott_classic_clock.rs b/rust-modules/src/app/ott_classic_clock.rs
new file mode 100644
index 00000000..d3d24b55
--- /dev/null
+++ b/rust-modules/src/app/ott_classic_clock.rs
@@ -0,0 +1,137 @@
+//! Accepted wall-clock samples for Classic paint. This is application-side
+//! presentation work: it neither rebuilds the catalogue nor gives a screen IO.
+use super::{App, Runtime, current_ui_owner};
+use plx_machine::machine::{Delivery, Fx, InstanceId, MachineId, UiMode};
+use plx_screens::registry::{AppMsg, OttClockSample};
+
+#[derive(Default)]
+pub(super) struct State {
+    key: Option<(Option<i64>, usize)>,
+    sample: OttClockSample,
+    recipient: Option<InstanceId>,
+}
+
+impl State {
+    fn observe(&mut self, recipient: Option<InstanceId>, seconds: Option<i64>,
+        locale: &plx_platform::i18n::LocaleContext) -> Option<(InstanceId, OttClockSample)>
+    {
+        let Some(recipient) = recipient else { self.recipient = None; return None; };
+        // Reuse the existing calendar/time_t range check, retaining second precision.
+        let seconds = seconds.filter(|seconds| plx_platform::i18n::clock_minute_key(*seconds).is_some());
+        let key = (seconds, locale as *const _ as usize);
+        if self.key == Some(key) && self.recipient == Some(recipient) { return None; }
+        let sample = if self.key != Some(key) {
+            let label = seconds.and_then(plx_platform::i18n::local_clock_parts)
+                .and_then(|parts| locale.time(parts));
+            self.key = Some(key);
+            OttClockSample { utc_s: seconds, label }
+        } else {
+            self.sample.clone()
+        };
+        self.prepare_delivery(recipient, sample)
+    }
+
+    fn prepare_delivery(&mut self, recipient: InstanceId, sample: OttClockSample)
+        -> Option<(InstanceId, OttClockSample)>
+    {
+        // A repeated local clock face still represents a new UTC observation.
+        let changed = sample != self.sample || self.recipient != Some(recipient);
+        self.recipient = Some(recipient);
+        if !changed { return None; }
+        self.sample = sample.clone();
+        Some((recipient, sample))
+    }
+}
+
+pub(super) fn publish(runtime: &mut Runtime, app: &mut App) {
+    // Live wall time is not on the controlled tape. Present bits are graded, so
+    // suppress recording as well as replay rather than inventing a replay clock.
+    if !matches!(&app.rec, super::super::recorder::Recplay::Off)
+        || app.bridge.is_controlled_replay()
+        || runtime.interface_mode() != UiMode::Classic
+        || app.bridge.ui_mode() != UiMode::Classic
+    {
+        runtime.classic_clock.recipient = None;
+        return;
+    }
+    let recipient = runtime.reply.filter(|reply| Some(*reply) == current_ui_owner(app));
+    if recipient.is_none() {
+        runtime.classic_clock.recipient = None;
+        return;
+    }
+    let seconds = runtime.wall_now_s();
+    if let Some((recipient, sample)) = runtime.classic_clock.observe(
+        recipient, seconds, plx_platform::i18n::current())
+    {
+        app.pages.emit(MachineId::Nav, Fx::Deliver(MachineId::Instance(recipient),
+            Delivery::Screen(plx_ui::screen::ScreenEvent::App(AppMsg::OttClock(sample)))));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use plx_screens::registry::OttClockSample;
+
+    #[test]
+    fn seconds_locale_and_recipient_are_independent_cache_inputs() {
+        let a = plx_platform::i18n::LocaleContext::resolve(
+            plx_platform::i18n::Preference::En, None, Some("en-US"), Some("24"), None);
+        let b = plx_platform::i18n::LocaleContext::resolve(
+            plx_platform::i18n::Preference::En, None, Some("en-US"), Some("12"), None);
+        let mut state = State::default();
+        let second = 1_730_000_001;
+        let first = state.observe(Some(InstanceId(1)), Some(second), &a).unwrap();
+        assert!(first.1.label.is_some());
+        assert_eq!(first.1.utc_s, Some(second));
+        assert_eq!(state.observe(Some(InstanceId(1)), Some(second), &a), None);
+        let next = state.observe(Some(InstanceId(1)), Some(second + 1), &a).unwrap();
+        assert_ne!(next.1.label, first.1.label, "seconds are visible, not rounded to minutes");
+        assert_eq!(next.1.utc_s, Some(second + 1));
+        let local = plx_platform::i18n::local_clock_parts(second + 1).unwrap();
+        assert_eq!(state.observe(Some(InstanceId(1)), Some(second + 1), &b).unwrap().1.label, b.time(local));
+        assert!(state.observe(Some(InstanceId(2)), Some(second + 1), &b).is_some());
+        assert_eq!(state.observe(None, Some(second + 1), &b), None);
+        assert!(state.observe(Some(InstanceId(2)), Some(second + 1), &b).is_some(),
+            "uncover in the same second republishes to the current owner");
+    }
+
+    #[test]
+    fn repeated_or_absent_labels_still_publish_accepted_utc() {
+        let mut state = State::default();
+        let owner = InstanceId(1);
+        let first = OttClockSample { utc_s: Some(1_730_000_001), label: Some("16:12:20".into()) };
+        assert_eq!(state.prepare_delivery(owner, first.clone()), Some((owner, first.clone())));
+        assert_eq!(state.prepare_delivery(owner, first.clone()), None);
+        // The delivery decision sees an already formatted sample. A repeated
+        // clock face (another day or a wall correction) is not a repeated UTC.
+        let next = OttClockSample { utc_s: Some(1_730_086_401), label: first.label.clone() };
+        assert_eq!(state.prepare_delivery(owner, next.clone()), Some((owner, next)));
+        // A local formatting failure does not erase the accepted UTC sample.
+        let unlabelled = OttClockSample { utc_s: Some(1_730_086_402), label: None };
+        assert_eq!(state.prepare_delivery(owner, unlabelled.clone()), Some((owner, unlabelled.clone())));
+        assert_eq!(state.prepare_delivery(owner, unlabelled), None);
+        let backwards = OttClockSample { utc_s: first.utc_s, label: None };
+        assert_eq!(state.prepare_delivery(owner, backwards.clone()), Some((owner, backwards)));
+        assert_eq!(state.prepare_delivery(owner, OttClockSample::default()),
+            Some((owner, OttClockSample::default())));
+        assert_eq!(state.prepare_delivery(owner, OttClockSample::default()), None);
+    }
+
+    #[test]
+    fn missing_invalid_and_backwards_wall_samples_never_invent_time() {
+        let locale = plx_platform::i18n::LocaleContext::resolve(
+            plx_platform::i18n::Preference::En, None, Some("en-US"), Some("24"), None);
+        let mut state = State::default();
+        let owner = Some(InstanceId(1));
+        assert_eq!(state.observe(owner, None, &locale), Some((InstanceId(1), OttClockSample::default())));
+        assert_eq!(state.observe(owner, Some(0), &locale), None);
+        assert_eq!(state.observe(owner, Some(i64::MAX), &locale), None);
+        let first = state.observe(owner, Some(1_730_000_001), &locale).unwrap();
+        let backwards = state.observe(owner, Some(1_730_000_000), &locale).unwrap();
+        assert_ne!(first.1.label, backwards.1.label, "a wall correction is not an elapsed-time clock");
+        assert_eq!(first.1.utc_s, Some(1_730_000_001));
+        assert_eq!(backwards.1.utc_s, Some(1_730_000_000));
+        assert_eq!(state.observe(owner, None, &locale), Some((InstanceId(1), OttClockSample::default())));
+    }
+}
diff --git a/rust-modules/src/app/ott_classic_navigation.rs b/rust-modules/src/app/ott_classic_navigation.rs
new file mode 100644
index 00000000..e806dc3a
--- /dev/null
+++ b/rust-modules/src/app/ott_classic_navigation.rs
@@ -0,0 +1,190 @@
+//! Reversible Classic catalogue presentation over the existing navigation owner.
+//! Authentication, consent, modal and playback routes retain their lifetimes.
+use super::*;
+use plx_machine::machine::{EntryId, InputOwner, NavOp, UiMode};
+
+#[derive(Default)]
+pub(super) struct State {
+    origin: Option<Origin>,
+    startup_considered: bool,
+}
+#[derive(Clone, Copy)]
+struct Origin {
+    native: EntryId,
+    ott: Option<EntryId>,
+    epoch: u64,
+    server: plx_plex::plex::ServerId,
+}
+
+fn catalogue_page(route: &AppArg) -> bool {
+    matches!(route, AppArg::Home | AppArg::Library | AppArg::LibraryCollections { .. }
+        | AppArg::LibraryRecommended { .. } | AppArg::Search | AppArg::Watchlist
+        | AppArg::Content(_))
+}
+
+// The existing Push owns the native return state. Remember only its entry pair,
+// not a second copy of route, focus, page memory, credentials or catalogue data.
+pub(super) fn observe(runtime: &mut Runtime, app: &App) {
+    let Some(mut origin) = runtime.classic_navigation.origin else { return; };
+    if !app.bridge.session_ready_current()
+        || app.bridge.auth_read().0.flow_epoch != origin.epoch
+        || plx_plex::plex::current_server() != origin.server
+    {
+        runtime.classic_navigation.origin = None;
+        return;
+    }
+    let entries = &app.pages.nav.tabs.stack.entries;
+    let Some(index) = entries.iter().position(|entry| entry.id == origin.native) else {
+        runtime.classic_navigation.origin = None;
+        return;
+    };
+    let above = entries.get(index + 1);
+    if let Some(ott) = origin.ott {
+        if above.is_none_or(|entry| entry.id != ott || !matches!(entry.arg, AppArg::Ott)) {
+            runtime.classic_navigation.origin = None;
+        }
+    } else if let Some(entry) = above {
+        runtime.classic_navigation.origin = if matches!(entry.arg, AppArg::Ott) {
+            origin.ott = Some(entry.id);
+            Some(origin)
+        } else { None };
+    } else if !app.pages.has_pending_navigation() && !app.pages.nav.tabs.stack.is_pending() {
+        runtime.classic_navigation.origin = None;
+    }
+}
+
+fn owned_pages(runtime: &Runtime, app: &App) -> bool {
+    let Some(origin) = runtime.classic_navigation.origin else { return false; };
+    let Some(ott) = origin.ott else { return false; };
+    app.pages.nav.top_page().is_some_and(|entry| entry.id == ott
+        && matches!(entry.arg, AppArg::Ott)
+        && entry.inst.as_ref().is_some_and(|body| !body.staged))
+        && app.pages.nav.tabs.stack.under_top().is_some_and(|entry| entry.id == origin.native)
+}
+
+fn owned_top(runtime: &Runtime, app: &App) -> bool {
+    owned_pages(runtime, app) && runtime.classic_navigation.origin.and_then(|origin| origin.ott)
+        .is_some_and(|ott| app.pages.nav.input_owner() == Some(InputOwner::Entry(ott)))
+}
+
+// A saved provider is boot intent; an incidental native Home is not a new
+// selection of Plex. The App boot/input stamps already distinguish real input.
+fn startup_provider(runtime: &Runtime) -> Option<ProviderKind> {
+    runtime.active().map(|profile| profile.kind).or_else(|| {
+        match runtime.saved.settings.get("selectedProvider").and_then(Value::as_str) {
+            Some("m3u") => Some(ProviderKind::M3u),
+            Some("xtream") => Some(ProviderKind::Xtream),
+            Some("stalker") => Some(ProviderKind::Stalker),
+            Some("vportal") => Some(ProviderKind::VPortal),
+            Some("local" | "offline") => Some(ProviderKind::Local),
+            _ => None,
+        }
+    }).filter(|provider| *provider != ProviderKind::Plex)
+}
+
+pub(super) fn reconcile(runtime: &mut Runtime, app: &mut App) -> bool {
+    observe(runtime, app);
+    // Input while state/auth is still loading also retires this one-shot claim.
+    if app.last_input != app.t0 || runtime.navigation_epoch != 0 {
+        runtime.classic_navigation.startup_considered = true;
+    }
+    let mode = app.bridge.ui_mode();
+    if runtime.interface_mode() != mode
+        || !runtime.loaded || runtime.persistence_uncertain
+        || public_preferences::write_refusal(runtime).is_some()
+        || runtime.setup.is_some() || runtime.edit_session.is_some()
+        || input_policy::navigation(runtime).is_err()
+        || !playback_allowed(app) || app.pages.nav.suspended
+        || app.bridge.is_controlled_replay()
+        || matches!(&app.rec, super::super::recorder::Recplay::Replaying(_))
+        || !app.bridge.session_ready_current()
+        || app.pages.surface_up() || app.pages.has_pending_surface_navigation() || app.pages.has_pending_navigation()
+        || app.pages.nav.tabs.stack.is_pending()
+        || app.pages.nav.tabs.stack.transition.in_flight()
+    { return false; }
+    let Some(entry) = app.pages.nav.top_page() else { return false; };
+    if entry.inst.as_ref().is_none_or(|body| body.staged)
+        || app.pages.nav.input_owner() != Some(InputOwner::Entry(entry.id))
+    { return false; }
+    let native = entry.id;
+    let owner = entry.inst.as_ref().expect("checked mounted page").id;
+    let root_home = matches!(entry.arg, AppArg::Home)
+        && app.pages.nav.tabs.stack.depth() == 1;
+    let native_catalogue = catalogue_page(&entry.arg);
+    let startup_route_ready = native_catalogue || matches!(entry.arg, AppArg::Ott | AppArg::Player);
+    if !runtime.classic_navigation.startup_considered && startup_route_ready {
+        runtime.classic_navigation.startup_considered = true;
+        if root_home && runtime.transient.accepted.is_none()
+            && managed::profile(runtime).is_none() && classic_source::profile(runtime).is_none()
+        {
+            if let Some(provider) = startup_provider(runtime) {
+                // A configured provider may already own a running/progressive
+                // catalogue. Projection preserves its generation, selection,
+                // playback and queued reads; it grants no new source authority.
+                runtime.provider = provider;
+                if runtime.active().is_none() {
+                    runtime.page = if runtime.saved.favorites_selected { "favorites" } else { "profiles" };
+                }
+                runtime.reply = None;
+                runtime.changed();
+                // This is the initial application route, not a reversible
+                // projection of a user-opened native Plex page. Keeping Home
+                // underneath would make Modern Back expose the wrong provider.
+                app.pages.request(MachineId::Instance(owner), NavOp::Root(AppArg::Ott));
+                return true;
+            }
+        }
+    }
+    if mode == UiMode::Modern {
+        if !owned_top(runtime, app) { return false; }
+        let owner = app.pages.top_page().expect("owned mounted page");
+        app.pages.request(MachineId::Instance(owner), NavOp::Pop);
+        return true;
+    }
+    if !native_catalogue { return false; }
+    let categories = runtime.page == "categories";
+    // Source admission sees the unchanged typed route and stages a fresh read
+    // for its current session. It never selects/saves a profile or starts video.
+    let unavailable = match classic_source::ensure_catalog(runtime, app) {
+        Ok(true) => {
+            runtime.page = if categories { "categories" }
+                else if runtime.view_selection().1 { "favorites" } else { "channels" };
+            None
+        },
+        Ok(false) => {
+            if let Err(error) = runtime.require_parental(parental::Target::Providers) {
+                return hold(runtime, error);
+            }
+            Some("Plex source is no longer available")
+        },
+        Err(error) => return hold(runtime, error),
+    };
+    if let Some(error) = unavailable {
+        runtime.page = "providers";
+        runtime.status = error.into();
+    }
+    runtime.reply = None;
+    runtime.changed();
+    runtime.classic_navigation.origin = Some(Origin { native, ott: None,
+        epoch: app.bridge.auth_read().0.flow_epoch, server: plx_plex::plex::current_server() });
+    app.pages.request(MachineId::Instance(owner), NavOp::Push(AppArg::Ott));
+    true
+}
+
+/// A projected Classic root retains a native mode-return page underneath it.
+/// This ownership predicate is shared with the addressed OTT exit confirmation.
+pub(super) fn exit_root(runtime: &Runtime, app: &App) -> bool {
+    runtime.interface_mode() == UiMode::Classic && app.bridge.ui_mode() == UiMode::Classic
+        && runtime.classic_navigation.origin.is_some_and(|origin|
+            app.bridge.session_ready_current() && app.bridge.auth_read().0.flow_epoch == origin.epoch
+        ) && owned_pages(runtime, app)
+}
+
+// A source or policy refusal is not permission to reveal another catalogue.
+fn hold(runtime: &mut Runtime, error: &'static str) -> bool {
+    if runtime.status != error {
+        runtime.status = error.into();
+        runtime.changed();
+    }
+    false
+}
diff --git a/rust-modules/src/app/ott_classic_source.rs b/rust-modules/src/app/ott_classic_source.rs
new file mode 100644
index 00000000..e49c5e6a
--- /dev/null
+++ b/rust-modules/src/app/ott_classic_source.rs
@@ -0,0 +1,308 @@
+//! Volatile catalogue binding for an already-authorized native Plex session.
+//! Never writes Saved, selects an account, copies credentials or starts a worker.
+use super::*;
+use crate::app::ott_plex::ClassicRead;
+
+const CHANGED: &str = "Plex source is no longer available";
+
+/// Structural witness for the existing parental gate. Retaining it neither
+/// refreshes the source nor copies its credentials into a second owner.
+#[derive(Clone)]
+pub(super) struct ClassicAuthority {
+    epoch: u64,
+    selected_server: plx_plex::plex::ServerId,
+    scope: plx_plex::plex::grant::GrantScope,
+    authority: Arc<crate::app::ott_plex_prepare::CapturedAuthority>,
+}
+impl ClassicAuthority {
+    pub(super) fn same_authority(&self, other: &Self) -> bool {
+        self.epoch == other.epoch
+            && self.selected_server == other.selected_server
+            && self.scope == other.scope
+            && self.authority.server == other.authority.server
+            && self.authority.machine_id == other.authority.machine_id
+            && self.authority.client_key == other.authority.client_key
+            && self.authority.grant_epoch == other.authority.grant_epoch
+    }
+}
+
+/// Capture only a currently admitted Classic source. A stale binding is an
+/// error before the caller can fall back to unrelated durable credentials.
+pub(super) fn parental_authority(runtime: &Runtime)
+    -> Result<Option<ClassicAuthority>, &'static str>
+{
+    if runtime.transient.accepted.is_some() || managed::profile(runtime).is_some() {
+        return Ok(None);
+    }
+    let Some(binding) = runtime.classic_source.active.as_ref() else { return Ok(None); };
+    if binding.generation != runtime.generation
+        || binding.selected_server != plx_plex::plex::current_server()
+        || !durable_current(runtime, binding)
+        || runtime.effective_profile() != Some(&binding.profile)
+    {
+        return Err(CHANGED);
+    }
+    let (authority, scope) = binding.read.authority_scope().ok_or(CHANGED)?;
+    Ok(Some(ClassicAuthority {
+        epoch: binding.epoch, selected_server: binding.selected_server, scope, authority,
+    }))
+}
+
+#[derive(Default)]
+pub(super) struct State {
+    // Runtime-owned namespace identifies old issued profiles after retirement.
+    // The checked serial prevents an A -> B -> A session from reviving old rows.
+    prefix: String,
+    serial: u64,
+    active: Option<Binding>,
+}
+struct Binding {
+    profile: ProviderProfile,
+    durable: bool,
+    epoch: u64,
+    selected_server: plx_plex::plex::ServerId,
+    generation: u64,
+    read: ClassicRead,
+    category: String,
+}
+impl Binding {
+    fn current(&self, app: &App) -> bool {
+        app.bridge.session_ready_current()
+            && app.bridge.auth_read().0.flow_epoch == self.epoch
+            && self.read.current()
+            && self.selected_server == plx_plex::plex::current_server()
+    }
+}
+
+pub(super) fn temporary_id(runtime: &Runtime, id: &str) -> bool {
+    !runtime.classic_source.prefix.is_empty() && id.starts_with(&runtime.classic_source.prefix)
+}
+pub(super) fn owns_id(runtime: &Runtime, id: &str) -> bool {
+    temporary_id(runtime, id)
+        || runtime.classic_source.active.as_ref().is_some_and(|binding| binding.profile.id == id)
+}
+pub(super) fn profile(runtime: &Runtime) -> Option<&ProviderProfile> {
+    runtime.classic_source.active.as_ref()
+        .filter(|binding| binding.generation == runtime.generation)
+        .map(|binding| &binding.profile)
+}
+/// Only genuinely temporary profiles supplement the durable Favorite inventory.
+pub(super) fn binding_profile(runtime: &Runtime) -> Option<&ProviderProfile> {
+    runtime.classic_source.active.as_ref()
+        .filter(|binding| !binding.durable && binding.generation == runtime.generation)
+        .map(|binding| &binding.profile)
+}
+/// Resolve the existing durable category owner without treating a temporary
+/// Classic binding as its unrelated active Saved profile. Live source authority
+/// is checked by the existing admission/reconcile path; this is a pure metadata
+/// projection and refuses a replaced or retired durable binding.
+pub(super) fn category_profile(runtime: &Runtime) -> Result<Option<&ProviderProfile>, &'static str> {
+    let Some(binding) = runtime.classic_source.active.as_ref() else {
+        return Ok(runtime.active());
+    };
+    if binding.generation != runtime.generation || !durable_current(runtime, binding) {
+        return Err(CHANGED);
+    }
+    if !binding.durable { return Ok(None); }
+    if !binding.profile.enabled { return Err(CHANGED); }
+    Ok(Some(&binding.profile))
+}
+pub(super) fn view_selection(runtime: &Runtime) -> Option<&str> {
+    profile(runtime)?;
+    runtime.classic_source.active.as_ref().map(|binding| binding.category.as_str())
+}
+pub(super) fn set_view(runtime: &mut Runtime, category: &str) {
+    if let Some(binding) = runtime.classic_source.active.as_mut() {
+        binding.category = category.into();
+    }
+}
+pub(super) fn guard_profile(runtime: &Runtime, app: &App, profile: &ProviderProfile)
+    -> Result<(), &'static str>
+{
+    if !owns_id(runtime, &profile.id) { return Ok(()); }
+    let binding = runtime.classic_source.active.as_ref().ok_or(CHANGED)?;
+    if binding.profile != *profile || binding.generation != runtime.generation
+        || !binding.current(app) || !durable_current(runtime, binding) { return Err(CHANGED); }
+    Ok(())
+}
+pub(super) fn capture_read(runtime: &Runtime, app: &App, profile: &ProviderProfile)
+    -> Result<Option<ClassicRead>, &'static str>
+{
+    if !owns_id(runtime, &profile.id) { return Ok(None); }
+    guard_profile(runtime, app, profile)?;
+    Ok(runtime.classic_source.active.as_ref().map(|binding| binding.read.clone()))
+}
+pub(super) fn guard_catalog_event(runtime: &Runtime, app: &App, generation: u64)
+    -> Result<(), &'static str>
+{
+    if let Some(binding) = &runtime.classic_source.active {
+        if binding.generation == generation && (!binding.current(app) || !durable_current(runtime, binding)) { return Err(CHANGED); }
+    }
+    Ok(())
+}
+pub(super) fn guard_metadata_event(runtime: &Runtime, app: &App, profile_id: &str)
+    -> Result<(), &'static str>
+{
+    if !owns_id(runtime, profile_id) { return Ok(()); }
+    let binding = runtime.classic_source.active.as_ref().ok_or(CHANGED)?;
+    if binding.profile.id != profile_id || !binding.current(app) || !durable_current(runtime, binding) { return Err(CHANGED); }
+    Ok(())
+}
+pub(super) fn rebase(runtime: &mut Runtime, old_generation: u64) {
+    if let Some(binding) = runtime.classic_source.active.as_mut()
+        .filter(|binding| binding.generation == old_generation)
+    {
+        binding.generation = runtime.generation;
+    }
+}
+fn durable_current(runtime: &Runtime, binding: &Binding) -> bool {
+    !binding.durable || runtime.saved.profiles.profiles.iter()
+        .filter(|profile| profile.id == binding.profile.id).eq(std::iter::once(&binding.profile))
+}
+/// A regular configured-source load supersedes this browse-only binding. Its
+/// caller immediately cancels the catalogue/generation, including same-ID work.
+pub(super) fn release(runtime: &mut Runtime) {
+    classic_bookmark::release(runtime);
+    if let Some(binding) = runtime.classic_source.active.take() {
+        if runtime.play_profile.as_ref().is_some_and(|(_, profile)| profile == &binding.profile) {
+            runtime.cancel_play_request();
+        }
+    }
+}
+pub(super) fn reconcile(runtime: &mut Runtime, app: &App) {
+    // A committed source replacement owns its own catalogue. Retire only the
+    // old Classic receipt/ticket; never clear the new source's rows or queue.
+    if runtime.transient.accepted.is_some() || managed::profile(runtime).is_some() {
+        release(runtime);
+        return;
+    }
+    let invalid = runtime.classic_source.active.as_ref().is_some_and(|binding|
+        binding.generation != runtime.generation || !binding.current(app)
+            || !durable_current(runtime, binding));
+    if !invalid { return; }
+    release(runtime);
+    // All known retained-catalog generation changes explicitly rebase above
+    // their next use. An unrecognized mismatch is a refusal, never a fallback
+    // that pairs old Plex rows with a configured source of another kind.
+    runtime.cancel_catalog();
+    runtime.catalog = Catalog::default();
+    runtime.selected = None;
+    runtime.catalog_revision = runtime.catalog_revision.wrapping_add(1);
+    runtime.status = CHANGED.into();
