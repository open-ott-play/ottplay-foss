+# integration builder validates its explicit flags before providing this pair.
+# Direct Make callers must also use the environment; reject command-line/file
+# overrides without ever expanding their contents. Freeze imported recursive
+# variables through value so even a rejected $(shell ...) string stays data.
+ifneq ($(origin PLX_CONTROL_DISCOVERY_URL),undefined)
