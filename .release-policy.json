{
  "version_file": "package.json",
  "validation_workflows": [
    "ci.yml",
    "native-parity.yml",
    "codeql.yml",
    "dependency-review.yml",
    "container-validation.yml"
  ],
  "artifact_pattern": "release-assets*",
  "local_checks": [
    "npm ci --ignore-scripts",
    "npm run typecheck",
    "npm run lint",
    "npm test",
    "npm run build",
    "npm run check:bundle",
    "npm run check:es5",
    "npx playwright install chromium",
    "npm run test:devices:browser",
    "npm run package:modea",
    "cargo test --locked -p ottplay-core -p ottplay-server",
    "cargo test --locked --release --manifest-path tests/glib-variant-regression/Cargo.toml"
  ],
  "notes": [
    "Retains web/server, desktop and iOS build targets. Native Android APK/AAB builds and publication belong to open-ott-play/ottplay-android.",
    "Classic emitted bundle smoke and ES5 checks are required, in addition to TypeScript checks.",
    "Physical TV/STB firmware, decoders, live IPTV streams and DRM are separate acceptance checks.",
    "OCI container archives are promoted without rebuild; deployment remains explicit.",
    "Tauri bundle metadata keeps the base SemVer because MSI rejects beta and RC labels; package and Cargo metadata retain the full candidate identity.",
    "Production automatic updating is not configured: updater public key is a placeholder and latest.json is not generated. Manual installers are supported; unsigned iOS packages need operator signing/sideloading."
  ],
  "version_companions": [
    "src-tauri/Cargo.toml",
    "src-tauri/tauri.conf.json",
    "ios/App/App.xcodeproj/project.pbxproj"
  ],
  "container_assets": {
    "ottplay-foss-container.oci.tar": "docker.io/alvit/ottplay-foss"
  },
  "repository": "open-ott-play/ottplay-foss",
  "mode": "release",
  "default_branch": "main",
  "visibility": "public",
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "files": [
      {
        "path": "package.json",
        "format": "json",
        "value": "package",
        "field": "version"
      },
      {
        "path": "package-lock.json",
        "format": "npm-lock",
        "value": "package",
        "package": "ottplay-foss"
      },
      {
        "path": "src-tauri/Cargo.toml",
        "format": "toml",
        "value": "package",
        "field": "package.version"
      },
      {
        "path": "src-tauri/tauri.conf.json",
        "format": "json",
        "value": "base",
        "field": "version"
      },
      {
        "path": "Cargo.lock",
        "format": "cargo-lock",
        "value": "package",
        "package": "ottplay-tauri"
      },
      {
        "path": "ios/App/App.xcodeproj/project.pbxproj",
        "format": "pbxproj",
        "value": "base",
        "package": "504EC3171FED79650016851F",
        "field": "MARKETING_VERSION"
      },
      {
        "path": "ios/App/App.xcodeproj/project.pbxproj",
        "format": "pbxproj",
        "value": "apple-build",
        "package": "504EC3171FED79650016851F",
        "field": "CURRENT_PROJECT_VERSION"
      },
      {
        "path": "ios/App/App.xcodeproj/project.pbxproj",
        "format": "pbxproj",
        "value": "base",
        "package": "504EC3181FED79650016851F",
        "field": "MARKETING_VERSION"
      },
      {
        "path": "ios/App/App.xcodeproj/project.pbxproj",
        "format": "pbxproj",
        "value": "apple-build",
        "package": "504EC3181FED79650016851F",
        "field": "CURRENT_PROJECT_VERSION"
      }
    ],
    "build_number_floor": 10142,
    "artifacts": [
      {
        "path": "ottplay-foss-modea.tar.gz",
        "format": "tar-json",
        "value": "package",
        "member": "build-info.json",
        "field": "version"
      },
      {
        "path": "ottplay-foss-dist.tar.gz",
        "format": "tar-json",
        "value": "package",
        "member": "build-info.json",
        "field": "version"
      },
      {
        "path": "ottplay-foss-ios-unsigned.ipa",
        "format": "ipa",
        "value": "base",
        "field": "CFBundleShortVersionString"
      },
      {
        "path": "ottplay-foss-ios-unsigned.ipa",
        "format": "ipa",
        "value": "apple-build",
        "field": "CFBundleVersion"
      },
      {
        "path": "ottplay-foss-container.oci.tar",
        "format": "oci",
        "field": ["config", "Labels", "org.opencontainers.image.version"],
        "value": "package"
      }
    ],
    "toolkit_revision": "ba7c4ece1188974df04799158e35603e968a4bac"
  },
  "asset_restrictions": [
    {
      "suffixes": [".apk", ".aab"],
      "reason": "Android APK/AAB publication moved to open-ott-play/ottplay-android"
    }
  ],
  "build_secrets": [
    "APPLE_APP_SPECIFIC_PASSWORD",
    "APPLE_CERTIFICATE",
    "APPLE_CERTIFICATE_PASSWORD",
    "APPLE_ID",
    "APPLE_SIGNING_IDENTITY",
    "APPLE_TEAM_ID",
    "KEYCHAIN_PASSWORD",
    "TAURI_SIGNING_PRIVATE_KEY",
    "TAURI_SIGNING_PRIVATE_KEY_PASSWORD"
  ],
  "single_entry_ci": true
}
